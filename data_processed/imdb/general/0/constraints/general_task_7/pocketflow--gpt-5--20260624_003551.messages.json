    : \".isComplete('Series_Title')\"},\n                    {\"column_name\": \"\
    Released_Year\", \"code_for_constraint\": \".isComplete('Released_Year')\"},\n\
    \                    {\"column_name\": \"Runtime\", \"code_for_constraint\": \"\
    .isComplete('Runtime')\"},\n                    {\"column_name\": \"Poster_Link\"\
    , \"code_for_constraint\": \".isComplete('Poster_Link')\"},\n                \
    \    {\"column_name\": \"IMDB_Rating\", \"code_for_constraint\": \".isComplete('IMDB_Rating')\"\
    },\n                    {\"column_name\": \"No_of_Votes\", \"code_for_constraint\"\
    : \".isComplete('No_of_Votes')\"},\n                    {\"column_name\": \"Overview\"\
    , \"code_for_constraint\": \".isComplete('Overview')\"},\n                   \
    \ {\"column_name\": \"Genre\", \"code_for_constraint\": \".isComplete('Genre')\"\
    },\n                    {\"column_name\": \"Director\", \"code_for_constraint\"\
    : \".isComplete('Director')\"},\n                    {\"column_name\": \"Star1\"\
    , \"code_for_constraint\": \".isComplete('Star1')\"},\n                    {\"\
    column_name\": \"Star2\", \"code_for_constraint\": \".isComplete('Star2')\"},\n\
    \                    {\"column_name\": \"Star3\", \"code_for_constraint\": \"\
    .isComplete('Star3')\"},\n                    {\"column_name\": \"Star4\", \"\
    code_for_constraint\": \".isComplete('Star4')\"},\n                    {\"column_name\"\
    : \"id\", \"code_for_constraint\": \".isComplete('id')\"},\n                 \
    \   {\"column_name\": \"IMDB_Rating\", \"code_for_constraint\": \".hasDataType('IMDB_Rating',\
    \ ConstrainableDataTypes.Fractional)\"},\n                    {\"column_name\"\
    : \"IMDB_Rating\", \"code_for_constraint\": \".hasMin('IMDB_Rating', lambda v:\
    \ v >= 0.0)\"},\n                    {\"column_name\": \"IMDB_Rating\", \"code_for_constraint\"\
    : \".hasMax('IMDB_Rating', lambda v: v <= 10.0)\"},\n                    {\"column_name\"\
    : \"No_of_Votes\", \"code_for_constraint\": \".hasDataType('No_of_Votes', ConstrainableDataTypes.Integral)\"\
