    },\n              {\"column_name\": \"Star4\", \"code_for_constraint\": \".isComplete('Star4')\"\
    },\n              {\"column_name\": \"id\", \"code_for_constraint\": \".isComplete('id')\"\
    },\n\n              # Types and numeric ranges\n              {\"column_name\"\
    : \"IMDB_Rating\", \"code_for_constraint\": \".hasDataType('IMDB_Rating', ConstrainableDataTypes.Fractional)\"\
    },\n              {\"column_name\": \"IMDB_Rating\", \"code_for_constraint\":\
    \ \".hasMin('IMDB_Rating', lambda v: v >= 0.0)\"},\n              {\"column_name\"\
    : \"IMDB_Rating\", \"code_for_constraint\": \".hasMax('IMDB_Rating', lambda v:\
    \ v <= 10.0)\"},\n              {\"column_name\": \"No_of_Votes\", \"code_for_constraint\"\
    : \".hasDataType('No_of_Votes', ConstrainableDataTypes.Integral)\"},\n       \
    \       {\"column_name\": \"No_of_Votes\", \"code_for_constraint\": \".isNonNegative('No_of_Votes')\"\
    },\n              {\"column_name\": \"id\", \"code_for_constraint\": \".hasDataType('id',\
    \ ConstrainableDataTypes.Integral)\"},\n              {\"column_name\": \"id\"\
    , \"code_for_constraint\": \".isNonNegative('id')\"},\n\n              # Year\
    \ format and plausible bounds\n              {\"column_name\": \"Released_Year\"\
    , \"code_for_constraint\": \".hasPattern('Released_Year', r'^\\\\d{4}$')\"},\n\
    \              {\"column_name\": \"Released_Year\", \"code_for_constraint\": \"\
    .hasMin('Released_Year', lambda v: v >= 1900)\"},\n              {\"column_name\"\
    : \"Released_Year\", \"code_for_constraint\": \".hasMax('Released_Year', lambda\
    \ v: v <= 2026)\"},\n\n              # Runtime parseability\n              {\"\
    column_name\": \"Runtime\", \"code_for_constraint\": \".hasPattern('Runtime',\
    \ r'^\\\\s*\\\\d+\\\\s*min\\\\s*$')\"},\n\n              # URL pattern\n     \
    \         {\"column_name\": \"Poster_Link\", \"code_for_constraint\": \".hasPattern('Poster_Link',\
    \ r'^https?://')\"},\n\n              # Optional fields validated when present\n\
    \              {\"column_name\": \"Meta_score\", \"code_for_constraint\": \".hasDataType('Meta_score',\
    \ ConstrainableDataTypes.Fractional)\"},\n              {\"column_name\": \"Meta_score\"\
    , \"code_for_constraint\": \".hasMin('Meta_score', lambda v: v >= 0.0, where='Meta_score\
    \ IS NOT NULL')\"},\n              {\"column_name\": \"Meta_score\", \"code_for_constraint\"\
    : \".hasMax('Meta_score', lambda v: v <= 100.0, where='Meta_score IS NOT NULL')\"\
    },\n\n              {\"column_name\": \"Certificate\", \"code_for_constraint\"\
    : \".hasPattern('Certificate', r'^(U|UA|A|PG|PG-13|G|R|NC-17|Not Rated|Unrated|Passed|GP|12|12A|15|18|TV-G|TV-PG|TV-14|TV-MA)$',\
    \ where='Certificate IS NOT NULL')\"},\n\n              {\"column_name\": \"Gross\"\
    , \"code_for_constraint\": \".hasPattern('Gross', r'^\\\\d{1,3}(,\\\\d{3})*$',\
    \ where='Gross IS NOT NULL')\"}\n          ]\n      }\n\ntest_cases:\n  - name:\
