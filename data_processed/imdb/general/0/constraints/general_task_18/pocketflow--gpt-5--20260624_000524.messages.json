    \ 132\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar1:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 452\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nMeta_score:\n  completeness: 0.8564273789649416\n  approximateNumDistinctValues:\
    \ 55\n  dataType: Fractional\n  typeCounts: {}\n  isDataTypeInferred: false\n\
    \  histogram: null\nSeries_Title:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 587\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 2\n    Unknown: 0\n    String: 597\n  isDataTypeInferred: false\n\
    \  histogram: null\nGenre:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 168\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nCertificate:\n  completeness: 0.8981636060100167\n  approximateNumDistinctValues:\
    \ 13\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 1\n    Unknown: 61\n    String: 537\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar2:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 509\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ numpy as np\nimport pandas as pd\n\n\ndef robust_minmax(s: pd.Series, low_q:\
    \ float = 0.05, high_q: float = 0.95) -> pd.Series:\n    s = s.astype(float)\n\
    \    lo, hi = s.quantile(low_q), s.quantile(high_q)\n    denom = (hi - lo)\n \
    \   if pd.notna(denom) and denom != 0:\n        return ((s.clip(lo, hi) - lo)\
    \ / denom).fillna(0.5)\n    else:\n        return pd.Series(0.5, index=s.index)\n\
    \n\ndef runtime_factor(minutes: pd.Series) -> pd.Series:\n    min_minutes = 45\n\
    \    low_opt = 90\n    high_opt = 150\n    max_minutes = 240\n    min_factor =\
    \ 0.8\n    factor = np.ones(len(minutes), dtype=float)\n    left = minutes < low_opt\n\
    \    right = minutes > high_opt\n    factor[left] = min_factor + (minutes[left]\
    \ - min_minutes) / (low_opt - min_minutes) * (1 - min_factor)\n    factor[right]\
    \ = min_factor + (max_minutes - minutes[right]) / (max_minutes - high_opt) * (1\
    \ - min_factor)\n    factor = np.clip(factor, min_factor, 1.0)\n    return pd.Series(factor,\
    \ index=minutes.index)\n\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--input',\
    \ type=str, required=True)\nparser.add_argument('--output', type=str, required=True)\n\
    args = parser.parse_args()\n\nos.makedirs(args.output, exist_ok=True)\n\ninput_file\
    \ = os.path.join(args.input, 'new_data.csv')\ndf = pd.read_csv(input_file)\n\n\
    # Rating is used to normalize and to fit a calibration with Meta_score\nrating_norm\
    \ = df['IMDB_Rating'].astype(float) / 10.0\n\n# Votes power part of the popularity\
    \ model through a log transform\nvotes_log = np.log1p(df['No_of_Votes'].astype(float))\n\
    votes_norm = robust_minmax(votes_log)\n\n# Runtime shapes the final score via\
    \ a factor so its format and bounds must be consistent\nruntime_minutes = df['Runtime'].astype(str).str.extract(r'([0-9]{2,3})')[0].astype(int)\n\
    runtime_adj = runtime_factor(runtime_minutes)\n\n# Gross contributes a smaller\
    \ boost; ensure parsable for all present values\ndf['Gross_USD'] = pd.to_numeric(df['Gross'].astype(str).str.replace(',',\
    \ '', regex=False), errors='coerce')\n# Use a robust normalization on log gross;\
    \ fill missing with median to avoid penalizing titles without data\n_gross_for_norm\
    \ = df['Gross_USD'].copy()\nif _gross_for_norm.notna().any():\n    median_g =\
    \ _gross_for_norm.median(skipna=True)\n    _gross_for_norm = _gross_for_norm.fillna(median_g)\n\
    else:\n    _gross_for_norm = pd.Series(np.zeros(len(df)), index=df.index)\n\n\
    gross_norm = robust_minmax(np.log1p(_gross_for_norm))\n\n# Correlation between\
    \ IMDB_Rating and Meta_score is used to calibrate blending weight and for regression-based\
    \ imputation\nmeta_valid_mask = df['Meta_score'].notna() & df['IMDB_Rating'].notna()\n\
    if meta_valid_mask.sum() > 1:\n    r = df.loc[meta_valid_mask, 'IMDB_Rating'].astype(float).corr(df.loc[meta_valid_mask,\
    \ 'Meta_score'].astype(float))\nelse:\n    r = np.nan\n# Fit a simple linear model\
    \ Meta_score ~ a * IMDB_Rating + b to impute missing Meta_score\nslope, intercept\
    \ = np.polyfit(\n    df.loc[meta_valid_mask, 'IMDB_Rating'].astype(float).values,\n\
    \    df.loc[meta_valid_mask, 'Meta_score'].astype(float).values,\n    1\n)\n\n\
    meta_filled = df['Meta_score'].astype(float).copy()\nmissing_meta = meta_filled.isna()\n\
    if missing_meta.any():\n    meta_filled.loc[missing_meta] = np.clip(slope * df.loc[missing_meta,\
    \ 'IMDB_Rating'].astype(float) + intercept, 0,\n                             \
    \               100)\n\nmeta_norm = meta_filled / 100.0\n\n# Blend rating and\
    \ metascore with correlation-aware weights\nr_norm = float(np.clip((r - 0.2) /\
    \ 0.8, 0.0, 1.0))\nw_rating = 0.5 + 0.2 * r_norm\nw_meta = 1.0 - w_rating\n\n\
    content_quality = w_rating * rating_norm + w_meta * meta_norm\n\n# Ensure Series_Title\
    \ + Released_Year uniquely identifies a title row used for ranking and output\
    \ publishing keys\npopularity_index_base = 0.6 * content_quality + 0.3 * votes_norm\
    \ + 0.1 * gross_norm\npopularity_index = popularity_index_base * runtime_adj\n\
    \ndf['PopularityIndex'] = popularity_index\n\n# Set a MultiIndex for downstream\
    \ publishing keyed by title-year\n_ = df.set_index(['Series_Title', 'Released_Year'],\
    \ inplace=False)\n\ndf_sorted = df.sort_values('PopularityIndex', ascending=False).copy()\n\
    df_sorted['Rank'] = np.arange(1, len(df_sorted) + 1)\n\nall_out = df_sorted[[\n\
    \    'Series_Title', 'Released_Year', 'IMDB_Rating', 'Meta_score', 'No_of_Votes',\
    \ 'Runtime', 'Gross',\n    'PopularityIndex', 'Rank'\n]]\n\ntop_n = min(100, len(all_out))\n\
    top_out = all_out.head(top_n)\n\nall_out.to_csv(os.path.join(args.output, 'movie_popularity_ranking.csv'),\
    \ index=False)\ntop_out.to_csv(os.path.join(args.output, 'movie_popularity_top100.csv'),\
    \ index=False)\n\n\nFocus on the python code for the Check object from pydeequ\
    \ only. Generate a Python function\n`run_code()` (taking no arguments) that returns\
    \ a JSON object with a single key \"constraints\"\nmapping to a list of objects,\
    \ each with keys \"column_name\" and \"code_for_constraint\", where\n\"code_for_constraint\"\
    \ is executable pydeequ Check code for that column. Your code must not inspect\n\
    any dataframe; only return the constraints.\n\nHere is an example of the code\
    \ to generate, please replace the example constraints with the ones\nyou generate:\n\
    \ndef run_code():\n    return {\n        \"constraints\": [\n            {\"column_name\"\
    : \"some_column\", \"code_for_constraint\": \".isComplete('some_column')\"},\n\
    \            {\"column_name\": \"another_column\", \"code_for_constraint\": \"\
    .isPositive('another_column')\"},\n        ]\n    }\n\n\nOutput in this YAML format\
    \ with reasoning:\n```yaml\nreasoning: |\n    The input parameters should be:\
    \ param1 as a string, and param2 as a number.\n    To test the function, I will\
    \ consider basic cases, edge cases, and corner cases.\n    For this problem, I\
    \ need to test...\ntest_cases:\n  - name: \"Basic case\"\n    input: {param1:\
    \ value1, param2: value2}\n    expected: result1\n  - name: \"Edge case - empty\"\
    \n    input: {param1: value3, param2: value4}\n    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  The program depends on specific columns, types,\
    \ and formats:\n  - Must parse numeric columns: IMDB_Rating (0\u201310), No_of_Votes\
    \ (non-negative integral), Released_Year (integral, plausible bounds).\n  - Runtime\
    \ must match \"NN or NNN min\" and effectively be within operational range (45\u2013\
    240) because runtime_factor applies piecewise logic.\n  - Meta_score is used in\
    \ a regression fit; at least substantial completeness is needed and values must\
    \ be 0\u2013100.\n  - Gross is optional but when present it must be parseable\
    \ as a number with thousands separators.\n  - Poster_Link must be a valid http(s)\
    \ URL.\n  - Series_Title + Released_Year is a publishing key and must be unique.\n\
    \  - Certificate values should be constrained to a known whitelist.\n  - Overview\
    \ and cast/director fields are required down the pipeline.\n\n  Below is a Python\
    \ function returning only pydeequ Check constraints as requested. Each \"code_for_constraint\"\
    \ is a Check-chain segment.\n\n  def run_code():\n      return {\n          \"\
    constraints\": [\n              {\"column_name\": \"Series_Title, Released_Year\"\
    , \"code_for_constraint\": \".isUnique(['Series_Title', 'Released_Year'])\"},\n\
    \              {\"column_name\": \"Series_Title\", \"code_for_constraint\": \"\
    .isComplete('Series_Title')\"},\n              {\"column_name\": \"Released_Year\"\
    , \"code_for_constraint\": \".isComplete('Released_Year')\"},\n              {\"\
    column_name\": \"Released_Year\", \"code_for_constraint\": \".hasDataType('Released_Year',\
    \ ConstrainableDataTypes.Integral)\"},\n              {\"column_name\": \"Released_Year\"\
    , \"code_for_constraint\": \".hasMin('Released_Year', lambda v: v >= 1900)\"},\n\
    \              {\"column_name\": \"Released_Year\", \"code_for_constraint\": \"\
    .hasMax('Released_Year', lambda v: v <= 2025)\"},\n              {\"column_name\"\
    : \"IMDB_Rating\", \"code_for_constraint\": \".isComplete('IMDB_Rating')\"},\n\
    \              {\"column_name\": \"IMDB_Rating\", \"code_for_constraint\": \"\
    .hasMin('IMDB_Rating', lambda v: v >= 0.0)\"},\n              {\"column_name\"\
    : \"IMDB_Rating\", \"code_for_constraint\": \".hasMax('IMDB_Rating', lambda v:\
    \ v <= 10.0)\"},\n              {\"column_name\": \"No_of_Votes\", \"code_for_constraint\"\
    : \".isComplete('No_of_Votes')\"},\n              {\"column_name\": \"No_of_Votes\"\
    , \"code_for_constraint\": \".hasDataType('No_of_Votes', ConstrainableDataTypes.Integral)\"\
    },\n              {\"column_name\": \"No_of_Votes\", \"code_for_constraint\":\
    \ \".isNonNegative('No_of_Votes')\"},\n              {\"column_name\": \"Runtime\"\
    , \"code_for_constraint\": \".isComplete('Runtime')\"},\n              {\"column_name\"\
    : \"Runtime\", \"code_for_constraint\": \".hasPattern('Runtime', r'^\\\\s*(4[5-9]|[5-9]\\\
    \\d|1\\\\d\\\\d|2[0-3]\\\\d|240)\\\\s*min\\\\s*$', lambda v: v == 1.0)\"},\n \
    \             {\"column_name\": \"Meta_score\", \"code_for_constraint\": \".hasCompleteness('Meta_score',\
    \ lambda v: v >= 0.80)\"},\n              {\"column_name\": \"Meta_score\", \"\
    code_for_constraint\": \".hasMin('Meta_score', lambda v: v >= 0.0)\"},\n     \
    \         {\"column_name\": \"Meta_score\", \"code_for_constraint\": \".hasMax('Meta_score',\
    \ lambda v: v <= 100.0)\"},\n              {\"column_name\": \"Gross\", \"code_for_constraint\"\
    : \".hasCompleteness('Gross', lambda v: v >= 0.80)\"},\n              {\"column_name\"\
    : \"Gross\", \"code_for_constraint\": \".hasPattern('Gross', r'^\\\\d{1,3}(,\\\
    \\d{3})*$', lambda v: v >= 0.95)\"},\n              {\"column_name\": \"Poster_Link\"\
    , \"code_for_constraint\": \".isComplete('Poster_Link')\"},\n              {\"\
    column_name\": \"Poster_Link\", \"code_for_constraint\": \".hasPattern('Poster_Link',\
    \ r'^https?://', lambda v: v == 1.0)\"},\n              {\"column_name\": \"Certificate\"\
    , \"code_for_constraint\": \".hasCompleteness('Certificate', lambda v: v >= 0.85)\"\
    },\n              {\"column_name\": \"Certificate\", \"code_for_constraint\":\
    \ \".isContainedIn('Certificate', ['U', 'U/A', 'UA', 'A', 'PG', 'PG-13', 'R',\
    \ 'G', 'NC-17', 'Not Rated', 'Unrated', 'Approved', 'Passed', 'GP', 'TV-14', 'TV-MA',\
    \ 'TV-PG', 'TV-G'])\"},\n              {\"column_name\": \"Overview\", \"code_for_constraint\"\
    : \".isComplete('Overview')\"},\n              {\"column_name\": \"Overview\"\
    , \"code_for_constraint\": \".hasMinLength('Overview', 10, lambda v: v == 1.0)\"\
    },\n              {\"column_name\": \"Director\", \"code_for_constraint\": \"\
    .isComplete('Director')\"},\n              {\"column_name\": \"Star1\", \"code_for_constraint\"\
    : \".isComplete('Star1')\"},\n              {\"column_name\": \"Star2\", \"code_for_constraint\"\
    : \".isComplete('Star2')\"},\n              {\"column_name\": \"Star3\", \"code_for_constraint\"\
    : \".isComplete('Star3')\"},\n              {\"column_name\": \"Star4\", \"code_for_constraint\"\
    : \".isComplete('Star4')\"}\n          ]\n      }\n\ntest_cases:\n  - name: \"\
    Happy path - valid small dataset passes all constraints\"\n    input:\n      dataset_rows:\n\
    \        - {id: 370, Poster_Link: \"https://m.media-amazon.com/x.jpg\", Series_Title:\
    \ \"Kelly's Heroes\", Released_Year: 1970, Certificate: \"GP\", Runtime: \"144\
    \ min\", Genre: \"Adventure, Comedy, War\", IMDB_Rating: 7.6, Overview: \"US soldiers\
    \ sneak to steal Nazi gold.\", Meta_score: 50.0, Director: \"Brian G. Hutton\"\
    , Star1: \"Clint Eastwood\", Star2: \"Telly Savalas\", Star3: \"Don Rickles\"\
    , Star4: \"Carroll O'Connor\", No_of_Votes: 45338, Gross: \"1,378,435\"}\n   \
    \     - {id: 354, Poster_Link: \"https://m.media-amazon.com/y.jpg\", Series_Title:\
    \ \"Anand\", Released_Year: 1971, Certificate: \"U\", Runtime: \"122 min\", Genre:\
    \ \"Drama, Musical\", IMDB_Rating: 8.4, Overview: \"Terminally ill man lives life\
    \ fully.\", Meta_score: 82.0, Director: \"Hrishikesh Mukherjee\", Star1: \"Rajesh\
    \ Khanna\", Star2: \"Amitabh Bachchan\", Star3: \"Sumita Sanyal\", Star4: \"Ramesh\
    \ Deo\", No_of_Votes: 30273, Gross: \"2,100,000\"}\n        - {id: 98, Poster_Link:\
    \ \"https://m.media-amazon.com/z.jpg\", Series_Title: \"Dilwale Dulhania Le Jayenge\"\
    , Released_Year: 1995, Certificate: \"U\", Runtime: \"189 min\", Genre: \"Drama,\
    \ Romance\", IMDB_Rating: 8.1, Overview: \"Raj meets Simran; love blossoms.\"\
    , Meta_score: 75.0, Director: \"Aditya Chopra\", Star1: \"Shah Rukh Khan\", Star2:\
    \ \"Kajol\", Star3: \"Amrish Puri\", Star4: \"Farida Jalal\", No_of_Votes: 63516,\
    \ Gross: \"1,000,000\"}\n    expected: \"All constraints pass\"\n\n  - name: \"\
    Composite key uniqueness violation on Series_Title + Released_Year\"\n    input:\n\
    \      dataset_rows:\n        - {id: 1, Poster_Link: \"https://a.com/a.jpg\",\
    \ Series_Title: \"Anand\", Released_Year: 1971, Certificate: \"U\", Runtime: \"\
    122 min\", IMDB_Rating: 8.2, Overview: \"Story.\", Meta_score: 80.0, Director:\
    \ \"Dir\", Star1: \"S1\", Star2: \"S2\", Star3: \"S3\", Star4: \"S4\", No_of_Votes:\
    \ 1000, Gross: \"123,000\"}\n        - {id: 2, Poster_Link: \"https://a.com/b.jpg\"\
    , Series_Title: \"Anand\", Released_Year: 1971, Certificate: \"U\", Runtime: \"\
    130 min\", IMDB_Rating: 8.3, Overview: \"Story 2.\", Meta_score: 81.0, Director:\
    \ \"Dir\", Star1: \"S1\", Star2: \"S2\", Star3: \"S3\", Star4: \"S4\", No_of_Votes:\
    \ 2000, Gross: \"456,000\"}\n    expected:\n      constraints_violated:\n    \
    \    - \".isUnique(['Series_Title', 'Released_Year'])\"\n\n  - name: \"IMDB_Rating\
    \ outside allowed range [0, 10]\"\n    input:\n      dataset_rows:\n        -\
    \ {id: 1, Poster_Link: \"https://a.com/a.jpg\", Series_Title: \"Film A\", Released_Year:\
    \ 2001, Certificate: \"PG-13\", Runtime: \"100 min\", IMDB_Rating: -0.5, Overview:\
    \ \"Good.\", Meta_score: 77.0, Director: \"Dir\", Star1: \"S1\", Star2: \"S2\"\
    , Star3: \"S3\", Star4: \"S4\", No_of_Votes: 123, Gross: \"100,000\"}\n      \
    \  - {id: 2, Poster_Link: \"https://a.com/b.jpg\", Series_Title: \"Film B\", Released_Year:\
    \ 2002, Certificate: \"R\", Runtime: \"110 min\", IMDB_Rating: 10.7, Overview:\
    \ \"Also good.\", Meta_score: 85.0, Director: \"Dir\", Star1: \"S1\", Star2: \"\
    S2\", Star3: \"S3\", Star4: \"S4\", No_of_Votes: 456, Gross: \"200,000\"}\n  \
    \  expected:\n      constraints_violated:\n        - \".hasMin('IMDB_Rating',\
