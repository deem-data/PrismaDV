    }\n        - {column_name: \"Released_Year\", code_for_constraint: \".isComplete('Released_Year')\"\
    }\n        - {column_name: \"IMDB_Rating\", code_for_constraint: \".isComplete('IMDB_Rating')\"\
    }\n        - {column_name: \"No_of_Votes\", code_for_constraint: \".isComplete('No_of_Votes')\"\
    }\n        - {column_name: \"Runtime\", code_for_constraint: \".isComplete('Runtime')\"\
    }\n        - {column_name: \"Genre\", code_for_constraint: \".isComplete('Genre')\"\
    }\n\n  - name: \"Data types for key numeric columns\"\n    input: {}\n    expected:\n\
    \      must_include:\n        - {column_name: \"Released_Year\", code_for_constraint:\
    \ \".hasDataType('Released_Year', ConstrainableDataTypes.Integral)\"}\n      \
    \  - {column_name: \"No_of_Votes\", code_for_constraint: \".hasDataType('No_of_Votes',\
    \ ConstrainableDataTypes.Integral)\"}\n        - {column_name: \"IMDB_Rating\"\
    , code_for_constraint: \".hasDataType('IMDB_Rating', ConstrainableDataTypes.Fractional)\"\
    }\n\n  - name: \"Numeric ranges and positivity checks\"\n    input: {}\n    expected:\n\
    \      must_include:\n        - {column_name: \"IMDB_Rating\", code_for_constraint:\
    \ \".hasMin('IMDB_Rating', lambda v: v >= 0.0)\"}\n        - {column_name: \"\
    IMDB_Rating\", code_for_constraint: \".hasMax('IMDB_Rating', lambda v: v <= 10.0)\"\
    }\n        - {column_name: \"Released_Year\", code_for_constraint: \".hasMin('Released_Year',\
    \ lambda v: v >= 1900)\"}\n        - {column_name: \"Released_Year\", code_for_constraint:\
    \ \".hasMax('Released_Year', lambda v: v <= 2026)\"}\n        - {column_name:\
    \ \"No_of_Votes\", code_for_constraint: \".isPositive('No_of_Votes')\"}\n\n  -\
    \ name: \"Patterns for URL, runtime, and gross\"\n    input: {}\n    expected:\n\
    \      must_include:\n        - {column_name: \"Poster_Link\", code_for_constraint:\
    \ \".hasPattern('Poster_Link', r'^https?://')\"}\n        - {column_name: \"Runtime\"\
    , code_for_constraint: \".hasPattern('Runtime', r'^\\\\s*\\\\d+\\\\s*min\\\\s*$')\"\
    }\n        - {column_name: \"Gross\", code_for_constraint: \".hasPattern('Gross',\
    \ r'^\\\\d{1,3}(,\\\\d{3})*$')\"}\n\n  - name: \"Certificate allowed domain values\"\
    \n    input: {}\n    expected:\n      description: \"Certificate must be within\
    \ the program's allowed certification set (case-insensitive in program, but constraint\
    \ checks the standardized uppercase forms).\"\n      must_include:\n        -\
    \ {column_name: \"Certificate\", code_for_constraint: \".isContainedIn('Certificate',\
    \ ['U', 'UA', 'A', 'G', 'PG', 'PG-13', 'R', 'NC-17', 'NOT RATED', 'UNRATED'])\"\
    }\n\n  - name: \"Poster_Link uniqueness assumption\"\n    input: {}\n    expected:\n\
    \      must_include:\n        - {column_name: \"Poster_Link\", code_for_constraint:\
    \ \".isUnique('Poster_Link')\"}"
