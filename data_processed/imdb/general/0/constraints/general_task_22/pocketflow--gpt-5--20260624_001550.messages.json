    \    Integral: 0\n    Unknown: 103\n    String: 496\n  isDataTypeInferred: false\n\
    \  histogram: null\nOverview:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 567\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
