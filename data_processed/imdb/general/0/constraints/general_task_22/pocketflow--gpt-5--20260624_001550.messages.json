    \ 132\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar1:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 452\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nMeta_score:\n  completeness: 0.8564273789649416\n  approximateNumDistinctValues:\
    \ 55\n  dataType: Fractional\n  typeCounts: {}\n  isDataTypeInferred: false\n\
    \  histogram: null\nSeries_Title:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 587\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 2\n    Unknown: 0\n    String: 597\n  isDataTypeInferred: false\n\
    \  histogram: null\nGenre:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 168\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nCertificate:\n  completeness: 0.8981636060100167\n  approximateNumDistinctValues:\
    \ 13\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 1\n    Unknown: 61\n    String: 537\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar2:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 509\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport json\nimport\
    \ os\n\nimport numpy as np\nimport pandas as pd\n\n\ndef minmax_norm(s: pd.Series)\
    \ -> pd.Series:\n    s = pd.to_numeric(s, errors='coerce')\n    s = s.replace([np.inf,\
    \ -np.inf], np.nan)\n    if s.notna().sum() == 0:\n        return pd.Series(0.0,\
    \ index=s.index)\n    s = s.fillna(s.dropna().min())\n    min_v = s.min()\n  \
    \  max_v = s.max()\n    if max_v == min_v:\n        return pd.Series(1.0, index=s.index)\n\
    \    return (s - min_v) / (max_v - min_v)\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n\
    \    parser.add_argument('--input', type=str, required=True)\n    parser.add_argument('--output',\
    \ type=str, required=True)\n    args = parser.parse_args()\n\n    os.makedirs(args.output,\
    \ exist_ok=True)\n\n    input_csv = os.path.join(args.input, 'new_data.csv')\n\
    \    df = pd.read_csv(input_csv)\n\n    # Basic type coercions used downstream\n\
    \    df['IMDB_Rating'] = pd.to_numeric(df['IMDB_Rating'], errors='coerce')\n \
    \   df['Meta_score'] = pd.to_numeric(df['Meta_score'], errors='coerce')\n    df['No_of_Votes']\
    \ = pd.to_numeric(df['No_of_Votes'], errors='coerce')\n    df['Released_Year']\
    \ = pd.to_numeric(df['Released_Year'], errors='coerce')\n    df['Runtime'] = df['Runtime'].astype(str)\n\
    \    df['Certificate'] = df['Certificate'].astype(object)\n    df['Genre'] = df['Genre'].astype(str)\n\
    \n    # Guard assumptions around IMDB_Rating before deriving rating buckets and\
    \ quality blend\n    # Buckets by 0.1 rating granularity (relies on quantization)\n\
    \    df['rating_tenth'] = (df['IMDB_Rating'] * 10).astype(int)\n\n    # Guard\
    \ assumptions for No_of_Votes before Bayesian averaging and log-scaling\n    #\
    \ Weighted (Bayesian) rating using vote counts\n    C = df['IMDB_Rating'].mean()\n\
    \    M = float(df['No_of_Votes'].quantile(0.60))\n    v = df['No_of_Votes']\n\
    \    R = df['IMDB_Rating']\n    df['bayes_rating'] = (v / (v + M)) * R + (M /\
    \ (v + M)) * C\n    # Quality blend of IMDB and Meta when available\n    meta10\
    \ = df['Meta_score'] / 10.0\n    meta10_filled = meta10.where(meta10.notna(),\
    \ df['IMDB_Rating'])\n    df['quality_component'] = 0.6 * df['bayes_rating'] +\
    \ 0.4 * meta10_filled\n    df['Runtime_minutes'] = df['Runtime'].str.extract(r'([0-9]{2,3})',\
    \ expand=False).astype(int)\n    deviation = (df['Runtime_minutes'] - 120).abs()\n\
    \    runtime_factor = 1.0 - (deviation / 120.0) * 0.20\n    df['runtime_factor']\
    \ = runtime_factor.clip(lower=0.80, upper=1.05)\n\n    # Popularity component\n\
    \    df['pop_component'] = np.log1p(df['No_of_Votes'])\n\n    # Final quality-adjusted\
    \ popularity score powering ranking\n    df['qa_pop_score'] = 0.65 * minmax_norm(df['quality_component'])\
    \ + 0.35 * minmax_norm(df['pop_component'])\n    df['qa_pop_score'] = df['qa_pop_score']\
    \ * df['runtime_factor']\n    # Guard temporal constraints tied to Certificate\
    \ before using both for policy checks\n    # Guard assumptions on Genre structure\
    \ and values before using it for kids-safety\n    # Precompute genre flags\n \
    \   df['genre_tokens'] = df['Genre'].str.split(', ')\n    df['has_animation']\
    \ = df['genre_tokens'].apply(lambda xs: 'Animation' in xs)\n    df['has_family']\
    \ = df['genre_tokens'].apply(lambda xs: 'Family' in xs)\n\n    # Cross-field policy\
    \ constraints used for parental filters\n    # Kids-safe gating and maturity mapping\n\
    \    maturity_map = {\n        'U': 0, 'G': 0, 'PG': 1, 'TV-PG': 1, 'UA': 2, 'PG-13':\
    \ 2, 'TV-14': 2,\n        'R': 3, 'TV-MA': 3, 'NC-17': 3, 'A': 3, 'Not Rated':\
    \ 2, 'Unrated': 2, 'Approved': 1, 'Passed': 1,\n        'U/A': 2, 'GP': 2\n  \
    \  }\n    df['maturity_level'] = df['Certificate'].map(maturity_map)\n    df['is_kids_safe']\
    \ = (\n                                 df['maturity_level'].fillna(3) <= 1\n\
    \                         ) & (~df['genre_tokens'].apply(lambda xs: any(g in xs\
    \ for g in ['Horror', 'Thriller'])))\n\n    # Guard gross format before creating\
    \ box-office carousel\n    # Parse Gross for downstream usage\n    df['Gross_int']\
    \ = pd.NA\n    if df['Gross'].notna().any():\n        gi = df['Gross'].dropna().astype(str).str.replace(',',\
    \ '', regex=False)\n        with np.errstate(all='ignore'):\n            gi_num\
    \ = pd.to_numeric(gi, errors='coerce')\n        df.loc[gi_num.index, 'Gross_int']\
    \ = gi_num.astype('Int64')\n\n    # Build outputs for search ranking and editorial\
    \ carousels\n    df['rank'] = df['qa_pop_score'].rank(ascending=False, method='first').astype(int)\n\
    \n    ranked_cols = [\n        'Series_Title', 'qa_pop_score', 'rank', 'Certificate',\
    \ 'Released_Year', 'Genre',\n        'is_kids_safe', 'Poster_Link', 'IMDB_Rating',\
    \ 'Meta_score', 'No_of_Votes', 'Gross_int'\n    ]\n    ranked_out = df.sort_values('qa_pop_score',\
    \ ascending=False)[ranked_cols]\n    ranked_out.to_csv(os.path.join(args.output,\
    \ 'ranked_titles.csv'), index=False)\n\n    # Carousels\n    def to_items(sub:\
    \ pd.DataFrame, n: int = 30):\n        cols = ['Series_Title', 'qa_pop_score',\
    \ 'Certificate', 'Released_Year', 'Genre', 'Poster_Link']\n        items = sub.sort_values('qa_pop_score',\
    \ ascending=False).head(n)[cols]\n        return [\n            {\n          \
    \      'title': r.Series_Title,\n                'score': float(r.qa_pop_score),\n\
    \                'certificate': None if pd.isna(r.Certificate) else str(r.Certificate),\n\
    \                'year': None if pd.isna(r.Released_Year) else int(r.Released_Year),\n\
    \                'genre': r.Genre,\n                'poster': r.Poster_Link\n\
    \            }\n            for r in items.itertuples(index=False)\n        ]\n\
    \n    top_overall = to_items(df, n=50)\n    family_picks = to_items(df[df['is_kids_safe']],\
    \ n=40)\n\n    if df['Gross_int'].notna().any():\n        box_office = df[df['Gross_int'].notna()].copy()\n\
    \        box_office['gross_norm'] = minmax_norm(pd.to_numeric(box_office['Gross_int'],\
    \ errors='coerce'))\n        box_office['box_office_score'] = 0.5 * box_office['gross_norm']\
    \ + 0.5 * minmax_norm(box_office['qa_pop_score'])\n        box_office_items =\
    \ box_office.sort_values(['box_office_score', 'qa_pop_score'], ascending=False)\n\
    \        box_office_items = box_office_items.head(40)\n        box_office_out\
    \ = [\n            {\n                'title': r.Series_Title,\n             \
    \   'gross': int(r.Gross_int) if not pd.isna(r.Gross_int) else None,\n       \
    \         'score': float(r.qa_pop_score),\n                'certificate': None\
    \ if pd.isna(r.Certificate) else str(r.Certificate),\n                'year':\
    \ None if pd.isna(r.Released_Year) else int(r.Released_Year),\n              \
    \  'poster': r.Poster_Link\n            }\n            for r in box_office_items.itertuples(index=False)\n\
    \        ]\n    else:\n        box_office_out = []\n\n    carousels = {\n    \
    \    'top_overall': top_overall,\n        'family': family_picks,\n        'box_office':\
    \ box_office_out\n    }\n\n    with open(os.path.join(args.output, 'carousels.json'),\
    \ 'w', encoding='utf-8') as f:\n        json.dump(carousels, f, ensure_ascii=False,\
    \ indent=2)\n\n    # Search index for ranking integration\n    search_index =\
    \ df[['Series_Title', 'qa_pop_score', 'is_kids_safe', 'Certificate', 'Released_Year',\
    \ 'Genre']].copy()\n    search_index.rename(\n        columns={'Series_Title':\
    \ 'title', 'qa_pop_score': 'rank_score', 'Certificate': 'cert', 'Released_Year':\
    \ 'year',\n                 'Genre': 'genres'}, inplace=True)\n    search_index.sort_values('rank_score',\
    \ ascending=False).to_csv(os.path.join(args.output, 'search_index.csv'),\n   \
    \                                                                index=False)\n\
    \n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python code for the\
    \ Check object from pydeequ only. Generate a Python function\n`run_code()` (taking\
    \ no arguments) that returns a JSON object with a single key \"constraints\"\n\
    mapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "reasoning: |\n  We need a set of column-level pydeequ Check constraints\
    \ that guard the assumptions the program makes before deriving features and building\
    \ outputs. The most critical preconditions from the code and supported by the\
    \ profiling are:\n\n  - IMDB_Rating is required complete and numeric to allow\
    \ integer quantization to rating_tenth; values should lie within [0, 10].\n  -\
    \ Runtime must always contain a parsable 2\u20133 digit minute value (used by\
    \ .str.extract(...).astype(int)); enforce a strict \"NN min\" or \"NNN min\" pattern.\n\
    \  - No_of_Votes should be present and non-negative; it powers Bayesian rating\
    \ and log1p().\n  - Released_Year is used as an integer in the outputs; ensure\
    \ completeness and plausible bounds.\n  - Certificate is used to map to a maturity\
    \ level; allow nulls but, when present, enforce a controlled vocabulary from the\
    \ maturity_map and maintain reasonable completeness.\n  - Meta_score, when present,\
    \ should be within [0, 100].\n  - Gross, when present, must be comma-separated\
    \ digits so downstream parsing to integer works.\n  - Poster_Link is used in outputs;\
    \ enforce completeness and that it looks like a URL.\n  - Genre is always split\
    \ on \", \"; enforce non-null and a simple genre-token list pattern.\n\n  Below\
    \ is the function returning the Check code snippets only (no dataframe inspection),\
    \ each being a chainable fragment on a Check builder.\n\n  def run_code():\n \
    \     return {\n          \"constraints\": [\n              {\n              \
    \    \"column_name\": \"IMDB_Rating\",\n                  \"code_for_constraint\"\
    : \".isComplete('IMDB_Rating').hasMin('IMDB_Rating', lambda v: v >= 0.0).hasMax('IMDB_Rating',\
    \ lambda v: v <= 10.0)\"\n              },\n              {\n                \
    \  \"column_name\": \"Runtime\",\n                  \"code_for_constraint\": \"\
    .isComplete('Runtime').hasPattern('Runtime', r'^\\\\s*\\\\d{2,3}\\\\s*min\\\\\
    s*$')\"\n              },\n              {\n                  \"column_name\"\
    : \"No_of_Votes\",\n                  \"code_for_constraint\": \".isComplete('No_of_Votes').isNonNegative('No_of_Votes')\"\
    \n              },\n              {\n                  \"column_name\": \"Released_Year\"\
    ,\n                  \"code_for_constraint\": \".isComplete('Released_Year').hasMin('Released_Year',\
    \ lambda v: v >= 1900).hasMax('Released_Year', lambda v: v <= 2025)\"\n      \
    \        },\n              {\n                  \"column_name\": \"Certificate\"\
    ,\n                  \"code_for_constraint\": \".hasCompleteness('Certificate',\
    \ lambda c: c >= 0.85).hasPattern('Certificate', r'^(U|G|PG|TV-PG|UA|PG-13|TV-14|R|TV-MA|NC-17|A|Not\
    \ Rated|Unrated|Approved|Passed|U/A|GP)$', where='Certificate IS NOT NULL')\"\n\
    \              },\n              {\n                  \"column_name\": \"Meta_score\"\
    ,\n                  \"code_for_constraint\": \".hasCompliance('meta_score_range',\
    \ 'Meta_score IS NULL OR (Meta_score >= 0 AND Meta_score <= 100)', lambda v: v\
    \ == 1.0)\"\n              },\n              {\n                  \"column_name\"\
    : \"Gross\",\n                  \"code_for_constraint\": \".hasPattern('Gross',\
    \ r'^\\\\d{1,3}(,\\\\d{3})*$', where='Gross IS NOT NULL')\"\n              },\n\
    \              {\n                  \"column_name\": \"Poster_Link\",\n      \
    \            \"code_for_constraint\": \".isComplete('Poster_Link').hasPattern('Poster_Link',\
    \ r'^https?://')\"\n              },\n              {\n                  \"column_name\"\
    : \"Series_Title\",\n                  \"code_for_constraint\": \".isComplete('Series_Title')\"\
    \n              },\n              {\n                  \"column_name\": \"Genre\"\
    ,\n                  \"code_for_constraint\": \".isComplete('Genre').hasPattern('Genre',\
    \ r'^[A-Za-z]+(?:, [A-Za-z]+)*$')\"\n              }\n          ]\n      }\n\n\
    test_cases:\n  - name: \"IMDB rating completeness and bounds\"\n    input:\n \
    \     description: \"Call run_code() and locate the constraint for IMDB_Rating\"\
    \n    expected:\n      must_include:\n        column_name: \"IMDB_Rating\"\n \
    \       substrings_in_code:\n          - \".isComplete('IMDB_Rating')\"\n    \
    \      - \".hasMin('IMDB_Rating'\"\n          - \">= 0.0\"\n          - \".hasMax('IMDB_Rating'\"\
    \n          - \"<= 10.0\"\n\n  - name: \"Runtime must match minutes pattern\"\n\
    \    input:\n      description: \"Call run_code() and locate the constraint for\
    \ Runtime\"\n    expected:\n      must_include:\n        column_name: \"Runtime\"\
    \n        substrings_in_code:\n          - \".isComplete('Runtime')\"\n      \
    \    - \".hasPattern('Runtime'\"\n          - \"\\\\d{2,3}\"\n          - \"min\"\
    \n\n  - name: \"Votes present and non-negative\"\n    input:\n      description:\
    \ \"Call run_code() and locate the constraint for No_of_Votes\"\n    expected:\n\
    \      must_include:\n        column_name: \"No_of_Votes\"\n        substrings_in_code:\n\
    \          - \".isComplete('No_of_Votes')\"\n          - \".isNonNegative('No_of_Votes')\"\
    \n\n  - name: \"Released year completeness and plausible range\"\n    input:\n\
    \      description: \"Call run_code() and locate the constraint for Released_Year\"\
    \n    expected:\n      must_include:\n        column_name: \"Released_Year\"\n\
    \        substrings_in_code:\n          - \".isComplete('Released_Year')\"\n \
    \         - \".hasMin('Released_Year'\"\n          - \">= 1900\"\n          -\
    \ \".hasMax('Released_Year'\"\n          - \"<= 2025\"\n\n  - name: \"Certificate\
    \ controlled vocabulary with completeness threshold\"\n    input:\n      description:\
    \ \"Call run_code() and locate the constraint for Certificate\"\n    expected:\n\
    \      must_include:\n        column_name: \"Certificate\"\n        substrings_in_code:\n\
    \          - \".hasCompleteness('Certificate'\"\n          - \">= 0.85\"\n   \
