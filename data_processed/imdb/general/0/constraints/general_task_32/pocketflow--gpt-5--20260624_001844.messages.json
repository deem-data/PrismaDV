    \ 587\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 2\n    Unknown: 0\n    String: 597\n  isDataTypeInferred: false\n\
    \  histogram: null\nGenre:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 168\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nCertificate:\n  completeness: 0.8981636060100167\n  approximateNumDistinctValues:\
    \ 13\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 1\n    Unknown: 61\n    String: 537\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar2:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 509\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\nimport\
    \ re\nimport json\nimport pandas as pd\nimport numpy as np\n\nparser = argparse.ArgumentParser()\n\
    parser.add_argument('--input', type=str, required=True)\nparser.add_argument('--output',\
    \ type=str, required=True)\nargs = parser.parse_args()\n\ninput_csv = os.path.join(args.input,\
    \ 'new_data.csv')\nos.makedirs(args.output, exist_ok=True)\n\ndf = pd.read_csv(input_csv)\n\
    \n# Basic dtype normalization used by ranking and rendering\ndf['IMDB_Rating']\
    \ = pd.to_numeric(df['IMDB_Rating'], errors='coerce')\ndf['No_of_Votes'] = pd.to_numeric(df['No_of_Votes'],\
    \ errors='coerce')\n# Compute a weighted ranking using a Bayesian-style formula\n\
    v = df['No_of_Votes']\nr = df['IMDB_Rating']\nC = r.mean()\nm = float(v.quantile(0.60))\n\
    if not np.isfinite(m) or m <= 0:\n    m = 1000.0\n\nscore = (v / (v + m)) * r\
    \ + (m / (v + m)) * C\ndf['ranking_score'] = score\n\n# Pick weekly featured titles\n\
    TOP_N = 12\nfeatured = df.sort_values(['ranking_score', 'IMDB_Rating', 'No_of_Votes'],\
    \ ascending=[False, False, False]).head(TOP_N).copy()\n# Parse runtime minutes\
    \ for display and layout\nfeatured['runtime_minutes'] = featured['Runtime'].str.extract(r'(\\\
    d+)')[0].astype(int)\n\n# Prepare rendering data\ndef slugify(text: str) -> str:\n\
    \    base = re.sub(r'[^a-zA-Z0-9]+', '-', text.strip()).strip('-')\n    return\
    \ base.lower()\n\ncards = []\nfor row in featured.itertuples(index=False):\n \
    \   title = str(getattr(row, 'Series_Title'))\n    year = int(getattr(row, 'Released_Year'))\
    \ if pd.notna(getattr(row, 'Released_Year')) else None\n    poster = str(getattr(row,\
    \ 'Poster_Link'))\n    runtime_min = int(getattr(row, 'runtime_minutes'))\n  \
    \  certificate = getattr(row, 'Certificate')\n    certificate_display = 'NR' if\
    \ pd.isna(certificate) or str(certificate).strip() == '' else str(certificate)\n\
    \    rating_val = float(getattr(row, 'IMDB_Rating'))\n    votes_val = int(getattr(row,\
    \ 'No_of_Votes'))\n    score_val = float(getattr(row, 'ranking_score'))\n    slug\
    \ = slugify(f\"{title}-{year}\")\n    star_fill_pct = max(0.0, min(100.0, rating_val\
    \ * 10.0))\n\n    cards.append({\n        'id': slug,\n        'title': title,\n\
    \        'year': year,\n        'poster': poster,\n        'runtime_minutes':\
    \ runtime_min,\n        'certificate': certificate_display,\n        'imdb_rating':\
    \ rating_val,\n        'votes': votes_val,\n        'score': score_val,\n    \
    \    'genre': str(getattr(row, 'Genre')),\n        'star_fill_pct': star_fill_pct\n\
    \    })\n\n# Render a simple HTML page with cards\nstyle = \"\"\"\n  <style>\n\
    \    body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background:\
    \ #0f1115; color: #e6e8eb; }\n    h1 { margin: 0 0 16px 0; font-size: 24px; }\n\
    \    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px,\
    \ 1fr)); gap: 16px; }\n    .card { background: #171a21; border-radius: 8px; overflow:\
    \ hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }\n    .poster { width: 100%;\
    \ height: 360px; object-fit: cover; background: #0b0d12; }\n    .content { padding:\
    \ 12px; }\n    .title { font-weight: 600; font-size: 15px; line-height: 1.25;\
    \ margin: 0 0 4px 0; }\n    .meta { font-size: 12px; color: #aab2bd; margin-bottom:\
    \ 6px; }\n    .badge { display: inline-block; padding: 2px 6px; border-radius:\
    \ 4px; font-size: 11px; margin-right: 6px; background: #2a2f3a; color: #c8d1dc;\
    \ }\n    .rating { position: relative; display: inline-block; width: 100px; height:\
    \ 16px; background: #2a2f3a; border-radius: 8px; overflow: hidden; vertical-align:\
    \ middle; }\n    .rating-fill { position: absolute; left: 0; top: 0; bottom: 0;\
    \ background: linear-gradient(90deg, #ffd54f, #ffb300); }\n    .rating-text {\
    \ font-size: 12px; margin-left: 8px; color: #c8d1dc; }\n  </style>\n\"\"\"\n\n\
    cards_html_parts = []\nfor c in cards:\n    card_html = f\"\"\"\n      <div class=\\\
    \"card\\\" id=\\\"{c['id']}\\\">\n        <img class=\\\"poster\\\" src=\\\"{c['poster']}\\\
    \" alt=\\\"{c['title']} poster\\\"/>\n        <div class=\\\"content\\\">\n  \
    \        <div class=\\\"title\\\">{c['title']} ({c['year']})</div>\n         \
    \ <div class=\\\"meta\\\">{c['genre']}</div>\n          <span class=\\\"badge\\\
    \">{c['runtime_minutes']} min</span>\n          <span class=\\\"badge\\\">{c['certificate']}</span>\n\
    \          <div style=\\\"margin-top:8px;\\\">\n            <div class=\\\"rating\\\
    \"><div class=\\\"rating-fill\\\" style=\\\"width:{c['star_fill_pct']}%;\\\"></div></div>\n\
    \            <span class=\\\"rating-text\\\">{c['imdb_rating']:.1f} \u2022 {c['votes']:,}\
    \ votes</span>\n          </div>\n        </div>\n      </div>\n    \"\"\"\n \
    \   cards_html_parts.append(card_html)\n\nhtml = f\"\"\"\n<!DOCTYPE html>\n<html>\n\
    \  <head>\n    <meta charset=\\\"utf-8\\\"/>\n    <meta name=\\\"viewport\\\"\
    \ content=\\\"width=device-width, initial-scale=1\\\"/>\n    <title>Weekly Featured\
    \ Films</title>\n    {style}\n  </head>\n  <body>\n    <h1>Weekly Featured Films</h1>\n\
    \    <div class=\\\"grid\\\">\n      {''.join(cards_html_parts)}\n    </div>\n\
    \  </body>\n</html>\n\"\"\"\n\nwith open(os.path.join(args.output, 'featured_cards.html'),\
    \ 'w', encoding='utf-8') as f:\n    f.write(html)\n\nwith open(os.path.join(args.output,\
    \ 'featured_cards.json'), 'w', encoding='utf-8') as f:\n    json.dump({'generated_by':\
    \ 'curation_pipeline', 'count': len(cards), 'items': cards}, f, ensure_ascii=False,\
    \ indent=2)\n\n\nFocus on the python code for the Check object from pydeequ only.\
    \ Generate a Python function\n`run_code()` (taking no arguments) that returns\
    \ a JSON object with a single key \"constraints\"\nmapping to a list of objects,\
    \ each with keys \"column_name\" and \"code_for_constraint\", where\n\"code_for_constraint\"\
    \ is executable pydeequ Check code for that column. Your code must not inspect\n\
    any dataframe; only return the constraints.\n\nHere is an example of the code\
    \ to generate, please replace the example constraints with the ones\nyou generate:\n\
    \ndef run_code():\n    return {\n        \"constraints\": [\n            {\"column_name\"\
    : \"some_column\", \"code_for_constraint\": \".isComplete('some_column')\"},\n\
    \            {\"column_name\": \"another_column\", \"code_for_constraint\": \"\
    .isPositive('another_column')\"},\n        ]\n    }\n\n\nOutput in this YAML format\
    \ with reasoning:\n```yaml\nreasoning: |\n    The input parameters should be:\
    \ param1 as a string, and param2 as a number.\n    To test the function, I will\
    \ consider basic cases, edge cases, and corner cases.\n    For this problem, I\
    \ need to test...\ntest_cases:\n  - name: \"Basic case\"\n    input: {param1:\
    \ value1, param2: value2}\n    expected: result1\n  - name: \"Edge case - empty\"\
    \n    input: {param1: value3, param2: value4}\n    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  The student's task is to implement a Python\
    \ function run_code() that returns a JSON-compatible\n  dictionary with a \"constraints\"\
    \ key. This key maps to a list of objects that specify pydeequ\n  Check constraints\
    \ for columns in a movie dataset. The function must not inspect any dataframe;\n\
    \  it only needs to return the constraints.\n\n  The provided program reads a\
    \ CSV, coerces IMDB_Rating and No_of_Votes to numeric, computes a\n  ranking_score,\
    \ sorts, parses Runtime minutes (expects \"NNN min\" format), and builds HTML\
    \ cards.\n  Therefore, constraints should prioritize:\n    - Completeness and\
    \ valid patterns for Poster_Link (URL) and Runtime (e.g., \"144 min\")\n    -\
    \ Numeric types and plausible ranges for IMDB_Rating (0\u201310) and No_of_Votes\
    \ (non-negative)\n    - Released_Year as an integer within a plausible year range\
    \ (e.g., >= 1900 and <= current year)\n    - Series_Title, Genre, Director, Overview\
    \ completeness and minimal lengths\n    - Optional fields with softer checks:\
    \ Certificate (allowed set, missing allowed), Meta_score\n      (completeness\
    \ ~0.80+ and range 0\u2013100), Gross (currency-like comma pattern, allow missing)\n\
    \    - High but not absolute uniqueness for likely identifiers (id, Poster_Link,\
    \ Series_Title)\n\n  The following test cases verify:\n    - The structural correctness\
    \ of the returned object\n    - Coverage of critical columns the program depends\
    \ on\n    - Presence of key pattern, type, and range checks\n    - The use of\
    \ softer constraints for optional/nullable fields\n    - Existence of reasonable\
    \ uniqueness checks\n\ntest_cases:\n  - name: \"Returns valid structure\"\n  \
    \  input: {}\n    expected:\n      description: |\n        run_code() returns\
    \ a dict with a top-level \"constraints\" list. Each element is a dict\n     \
    \   containing \"column_name\" (string) and \"code_for_constraint\" (string starting\
    \ with '.').\n      must_return_type: \"dict\"\n      must_have_top_level_key:\
    \ \"constraints\"\n      constraints_must_be_list: true\n      each_constraint_must_have_keys:\
    \ [\"column_name\", \"code_for_constraint\"]\n      code_string_must_start_with_dot:\
    \ true\n      at_least_constraints: 12\n\n  - name: \"Covers core columns used\
    \ by the program\"\n    input: {}\n    expected:\n      description: |\n     \
    \   The constraints list includes at least one constraint entry for each critical\
    \ column\n        used by the program logic and rendering.\n      must_cover_columns:\n\
    \        - Poster_Link\n        - Series_Title\n        - Released_Year\n    \
    \    - Runtime\n        - IMDB_Rating\n        - No_of_Votes\n        - Genre\n\
    \n  - name: \"Pattern constraints for Runtime and Poster_Link\"\n    input: {}\n\
    \    expected:\n      description: |\n        Ensure runtime is in 'NNN min' format\
    \ and poster links look like URLs.\n      must_have_constraint_pairs:\n      \
    \  - column: \"Runtime\"\n          code_contains_all: [\".hasPattern('Runtime'\"\
    , \"^\\\\d+\\\\s*min$\"]\n        - column: \"Poster_Link\"\n          code_contains_all:\
    \ [\".isComplete('Poster_Link')\"]\n        - column: \"Poster_Link\"\n      \
    \    code_contains_all: [\".hasPattern('Poster_Link'\", \"^https?://\"]\n\n  -\
    \ name: \"IMDB_Rating and No_of_Votes numeric sanity\"\n    input: {}\n    expected:\n\
    \      description: |\n        IMDB_Rating should be numeric (Fractional) and\
    \ bounded 0\u201310. No_of_Votes should be integral\n        and non-negative\
    \ (or min >= 0).\n      must_have_any_of:\n        - column: \"IMDB_Rating\"\n\
    \          any_code_snippets:\n            - \".hasDataType('IMDB_Rating', ConstrainableDataTypes.Fractional)\"\
    \n        - column: \"IMDB_Rating\"\n          any_code_snippets:\n          \
    \  - \".hasMin('IMDB_Rating'\"\n            - \".isNonNegative('IMDB_Rating'\"\
    \n        - column: \"IMDB_Rating\"\n          any_code_snippets:\n          \
    \  - \".hasMax('IMDB_Rating'\"\n      must_have_constraint_pairs:\n        - column:\
    \ \"No_of_Votes\"\n          code_contains_any:\n            - \".isNonNegative('No_of_Votes')\"\
    \n            - \".hasMin('No_of_Votes'\"\n        - column: \"No_of_Votes\"\n\
    \          code_contains_any:\n            - \".hasDataType('No_of_Votes', ConstrainableDataTypes.Integral)\"\
    \n\n  - name: \"Released_Year type and bounds\"\n    input: {}\n    expected:\n\
    \      description: |\n        Released_Year should be an integer with plausible\
    \ bounds (e.g., >= 1900 and <= 2026).\n      must_have_constraint_pairs:\n   \
    \     - column: \"Released_Year\"\n          code_contains_any:\n            -\
    \ \".hasDataType('Released_Year', ConstrainableDataTypes.Integral)\"\n       \
    \ - column: \"Released_Year\"\n          code_contains_any:\n            - \"\
    .hasMin('Released_Year'\"\n        - column: \"Released_Year\"\n          code_contains_any:\n\
    \            - \".hasMax('Released_Year'\"\n\n  - name: \"Soft checks for optional\
    \ columns\"\n    input: {}\n    expected:\n      description: |\n        Certificate\
    \ values (when present) should be from a controlled set, but missing is allowed.\n\
    \        Meta_score completeness should be >= ~0.80 and values within 0\u2013\
    100. Gross should match\n        a comma-separated integer pattern when present\
    \ (allow missing).\n      must_have_constraint_pairs:\n        - column: \"Certificate\"\
    \n          code_contains_any:\n            - \".isContainedIn('Certificate'\"\
    \n        - column: \"Meta_score\"\n          code_contains_any:\n           \
    \ - \".hasCompleteness('Meta_score'\"\n        - column: \"Meta_score\"\n    \
    \      code_contains_any:\n            - \".hasMin('Meta_score'\"\n          \
    \  - \".isNonNegative('Meta_score'\"\n        - column: \"Meta_score\"\n     \
    \     code_contains_any:\n            - \".hasMax('Meta_score'\"\n        - column:\
    \ \"Gross\"\n          code_contains_any:\n            - \".hasPattern('Gross'\"\
    \n      notes: \"Thresholds for these may be < 1.0 to allow nulls.\"\n\n  - name:\
    \ \"High-uniqueness for identifiers\"\n    input: {}\n    expected:\n      description:\
    \ |\n        The dataset likely expects high distinctness for id and/or other\
    \ near-identifiers used in rendering.\n      must_have_constraint_pairs:\n   \
    \     - column: \"id\"\n          code_contains_any:\n            - \".hasUniqueness('id'\"\
    \n        - column: \"Poster_Link\"\n          code_contains_any:\n          \
    \  - \".hasUniqueness('Poster_Link'\"\n        - column: \"Series_Title\"\n  \
    \        code_contains_any:\n            - \".hasUniqueness('Series_Title'\"\n\
    ```"
- model: gpt-5
  prompt: "Implement a solution for this problem:\n\nWrite a pydeequ data unit test\
    \ for a dataset consumed by the following program.\n\nHere is a sample of data\
