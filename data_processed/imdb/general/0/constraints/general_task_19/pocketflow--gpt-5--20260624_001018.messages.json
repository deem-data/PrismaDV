    \              {\"column_name\": \"No_of_Votes\", \"code_for_constraint\": \"\
    .isNonNegative('No_of_Votes')\"},\n  \n              # Runtime parsing expects\
    \ \"<digits> min\"\n              {\"column_name\": \"Runtime\", \"code_for_constraint\"\
    : \".containsPattern('Runtime', '^\\\\\\\\d+\\\\\\\\s*min$')\"},\n  \n       \
    \       # Poster link is required and must be http(s)\n              {\"column_name\"\
    : \"Poster_Link\", \"code_for_constraint\": \".isComplete('Poster_Link')\"},\n\
    \              {\"column_name\": \"Poster_Link\", \"code_for_constraint\": \"\
    .containsPattern('Poster_Link', '^https?://')\"},\n  \n              # Certificate\
    \ values constrained to allowed set (nullable upstream; fillna handled in code)\n\
    \              {\"column_name\": \"Certificate\", \"code_for_constraint\": \"\
    .isContainedIn('Certificate', ['U', 'UA', 'A', 'G', 'PG', 'PG-13', 'R', 'NC-17',\
    \ 'Not Rated', 'Unrated', 'Passed', 'Approved'])\"}\n          ]\n      }"
