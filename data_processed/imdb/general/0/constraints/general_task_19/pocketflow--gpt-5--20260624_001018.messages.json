    \ 587\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 2\n    Unknown: 0\n    String: 597\n  isDataTypeInferred: false\n\
    \  histogram: null\nGenre:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 168\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\nCertificate:\n  completeness: 0.8981636060100167\n  approximateNumDistinctValues:\
    \ 13\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 1\n    Unknown: 61\n    String: 537\n  isDataTypeInferred: false\n\
    \  histogram: null\nStar2:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 509\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n\
    \    Integral: 0\n    Unknown: 0\n    String: 599\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\nfrom\
    \ datetime import datetime\nimport numpy as np\nimport pandas as pd\n\n\ndef main():\n\
    \    parser = argparse.ArgumentParser()\n    parser.add_argument('--input', type=str,\
    \ required=True)\n    parser.add_argument('--output', type=str, required=True)\n\
    \    args = parser.parse_args()\n\n    input_file = os.path.join(args.input, 'new_data.csv')\n\
    \    os.makedirs(args.output, exist_ok=True)\n\n    df = pd.read_csv(input_file)\n\
    \n    # Basic type normalization for downstream logic\n    df['IMDB_Rating'] =\
    \ pd.to_numeric(df['IMDB_Rating'], errors='coerce')\n    df['Released_Year'] =\
    \ pd.to_numeric(df['Released_Year'], errors='coerce').astype('Int64')\n    df['No_of_Votes']\
    \ = pd.to_numeric(df['No_of_Votes'], errors='coerce').fillna(0).astype(int)\n\n\
    \    current_year = datetime.now().year\n\n    allowed_genres = {\n        'Action',\
    \ 'Adventure', 'Animation', 'Biography', 'Comedy', 'Crime', 'Documentary', 'Drama',\
    \ 'Family',\n        'Fantasy', 'Film-Noir', 'History', 'Horror', 'Music', 'Musical',\
    \ 'Mystery', 'Romance', 'Sci-Fi', 'Sport',\n        'Thriller', 'War', 'Western'\n\
    \    }\n    allowed_certificates = {\n        'U', 'UA', 'A', 'G', 'PG', 'PG-13',\
    \ 'R', 'NC-17', 'Not Rated', 'Unrated', 'Passed', 'Approved'\n    }\n    # Use\
    \ the unique key as index for deterministic scoring and dedupe safety\n    df\
    \ = df.set_index(['Series_Title', 'Released_Year'], verify_integrity=True)\n \
    \   # Quality component derived from rating; relies on bounded rating to keep\
    \ scores in [0,1]\n    rating_score = (df['IMDB_Rating'] / 10.0).clip(0, 1)\n\n\
    \    # Popularity component (log-scaled votes); calibrated assuming high-rated\
    \ entries have strong vote counts\n    votes_log = np.log10(df['No_of_Votes'].clip(lower=1))\n\
    \    pop_score = ((votes_log - 3.0) / (6.0 - 3.0)).clip(0, 1)  # 1k->0, 1M->1\n\
    \    # Freshness factor decaying after ~30 years\n    age_years = (current_year\
    \ - df.reset_index()['Released_Year']).astype(float)\n    freshness = (1.0 - (age_years\
    \ / 30.0)).clip(0, 1).values\n    # Parse runtime minutes for engagement modeling\n\
    \    runtime_min = df['Runtime'].str.extract(r'(\\d+)', expand=False).astype(int)\n\
    \n    runtime_diff = (runtime_min - 110).astype(float)\n    engagement = np.exp(-((runtime_diff\
    \ / 50.0) ** 2))\n\n    genre_weights = {\n        'Action': 1.1, 'Adventure':\
    \ 1.05, 'Animation': 1.05, 'Biography': 1.0, 'Comedy': 1.0, 'Crime': 1.05,\n \
    \       'Documentary': 0.85, 'Drama': 1.1, 'Family': 1.05, 'Fantasy': 1.0, 'Film-Noir':\
    \ 1.0, 'History': 0.95,\n        'Horror': 0.85, 'Music': 0.95, 'Musical': 0.90,\
    \ 'Mystery': 1.0, 'Romance': 0.95, 'Sci-Fi': 1.0,\n        'Sport': 0.95, 'Thriller':\
    \ 1.05, 'War': 0.90, 'Western': 0.85\n    }\n\n    def avg_genre_weight(genre_str:\
    \ str) -> float:\n        parts = [p.strip() for p in str(genre_str).split(',')\
    \ if p.strip()]\n        weights = [genre_weights.get(p, 1.0) for p in parts]\n\
    \        if not weights:\n            return 1.0\n        return float(np.mean(weights))\n\
    \n    genre_pref = df['Genre'].map(avg_genre_weight)\n\n    cert_weights = {\n\
    \        'U': 1.10, 'G': 1.10, 'PG': 1.05, 'PG-13': 1.00, 'UA': 1.00, 'Passed':\
    \ 0.95, 'Approved': 0.95,\n        'Not Rated': 0.95, 'Unrated': 0.90, 'R': 0.80,\
    \ 'A': 0.75, 'NC-17': 0.00\n    }\n    cert_series = df['Certificate'].fillna('Not\
    \ Rated').astype(str)\n    suitability = cert_series.map(cert_weights).fillna(0.90)\n\
    \n    # Content suitability gating (e.g., avoid NC-17 for licensing)\n    eligible_mask\
    \ = suitability > 0.0\n\n    # Combine signals into recommendation score\n   \
    \ # The weighting structure assumes all upstream fields adhere to the asserted\
    \ contracts\n    combined_score = (\n        (0.55 * rating_score + 0.45 * pop_score)\n\
    \        * (0.6 + 0.4 * freshness)\n        * (0.6 + 0.4 * engagement)\n     \
    \   * (0.85 + 0.15 * genre_pref)\n        * suitability\n    )\n\n    rec = df.copy()\n\
    \    rec['rating_score'] = rating_score\n    rec['pop_score'] = pop_score\n  \
    \  rec['freshness'] = freshness\n    rec['engagement'] = engagement\n    rec['genre_pref']\
    \ = genre_pref\n    rec['suitability'] = suitability\n    rec['priority_score']\
    \ = combined_score\n\n    # Apply eligibility filter and minimum quality threshold\
    \ for licensing\n    quality_gate = rec['IMDB_Rating'] >= 6.5\n    final = rec[eligible_mask\
    \ & quality_gate].sort_values('priority_score', ascending=False)\n\n    # Persist\
    \ results\n    out_cols = [\n        'Poster_Link', 'Certificate', 'Runtime',\
    \ 'Genre', 'IMDB_Rating', 'No_of_Votes',\n        'Meta_score', 'Director', 'Star1',\
    \ 'Star2', 'Star3', 'Star4', 'Gross',\n        'rating_score', 'pop_score', 'freshness',\
    \ 'engagement', 'genre_pref', 'suitability', 'priority_score'\n    ]\n    # Keep\
    \ only columns that exist in the input plus derived metrics\n    out_cols = [c\
    \ for c in out_cols if c in final.columns]\n\n    output_file = os.path.join(args.output,\
    \ 'licensing_recommendations.csv')\n    final.reset_index().to_csv(output_file,\
    \ index=False, columns=['Series_Title', 'Released_Year'] + out_cols)\n\n\nif __name__\
    \ == '__main__':\n    main()\n\n\nFocus on the python code for the Check object\
    \ from pydeequ only. Generate a Python function\n`run_code()` (taking no arguments)\
    \ that returns a JSON object with a single key \"constraints\"\nmapping to a list\
    \ of objects, each with keys \"column_name\" and \"code_for_constraint\", where\n\
    \"code_for_constraint\" is executable pydeequ Check code for that column. Your\
    \ code must not inspect\nany dataframe; only return the constraints.\n\nHere is\
    \ an example of the code to generate, please replace the example constraints with\
    \ the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "reasoning: |\n  The program imposes several implicit data contracts that\
    \ the pydeequ Check constraints should verify:\n  - The composite key (Series_Title,\
    \ Released_Year) is used as an index with verify_integrity=True, so both columns\
    \ must be complete and the pair must be unique. Released_Year should be in a sane\
    \ range.\n  - IMDB_Rating is used to compute rating_score and for a quality gate.\
    \ It must be complete and within [0, 10].\n  - No_of_Votes is converted to int\
    \ and used in a log transformation; values should be non-negative and complete.\n\
    \  - Runtime is parsed as minutes via a regex; it should match the \"<digits>\
    \ min\" pattern.\n  - Poster_Link should be a valid HTTP(S) URL.\n  - Certificate\
    \ gets mapped to weights with an explicit allowed set; if present, values should\
    \ be among that set.\n  - Genre is used for genre-based weighting; at minimum\
    \ it should be a comma-separated list of words (letters and hyphens). \n\n  The\
    \ test cases below validate that a correct run_code() returns a JSON object with\
    \ a \"constraints\" array that includes executable pydeequ Check code strings\
    \ enforcing these contracts. Since run_code() has no parameters and must not inspect\
    \ any data, the tests assert the presence of specific constraint snippets and\
    \ column targets rather than outcomes on actual data.\ntest_cases:\n  - name:\
    \ \"Return structure and minimal content\"\n    input: {}\n    expected:\n   \
    \   description: \"run_code() returns a dict with a non-empty 'constraints' list;\
    \ each item has 'column_name' and 'code_for_constraint' keys, and code strings\
    \ begin with a '.' for chaining on a Check object.\"\n      must_have_keys:\n\
    \        - constraints\n      constraints_item_required_keys:\n        - column_name\n\
    \        - code_for_constraint\n      code_prefix: \".\"\n\n  - name: \"Composite\
    \ key uniqueness and completeness\"\n    input: {}\n    expected:\n      description:\
    \ \"Constraints include completeness for Series_Title and Released_Year, composite\
    \ uniqueness on both, and a sane year range.\"\n      must_include:\n        -\
    \ column_name: \"Series_Title\"\n          code_contains: \".isComplete('Series_Title')\"\
    \n        - column_name: \"Released_Year\"\n          code_contains: \".isComplete('Released_Year')\"\
    \n        - column_name: \"Released_Year\"\n          code_contains: \".isContainedInRange('Released_Year',\
    \ 1900, 2026)\"\n        - column_name: \"Series_Title,Released_Year\"\n     \
    \     code_contains_all:\n            - \".hasUniqueness([\"\n            - \"\
    \ 'Series_Title'\"\n            - \" 'Released_Year'\"\n          note: \"column_name\
    \ may denote composite key; allow any naming as long as code references both columns.\"\
    \n\n  - name: \"IMDB_Rating bounded in [0, 10] and complete\"\n    input: {}\n\
    \    expected:\n      description: \"Constraints ensure IMDB_Rating is present\
    \ and lies within [0, 10].\"\n      must_include:\n        - column_name: \"IMDB_Rating\"\
    \n          code_contains: \".isComplete('IMDB_Rating')\"\n        - column_name:\
    \ \"IMDB_Rating\"\n          code_contains: \".isContainedInRange('IMDB_Rating',\
    \ 0.0, 10.0)\"\n\n  - name: \"Votes are complete and non-negative\"\n    input:\
    \ {}\n    expected:\n      description: \"Constraints ensure No_of_Votes is present\
    \ and not negative.\"\n      must_include:\n        - column_name: \"No_of_Votes\"\
    \n          code_contains: \".isComplete('No_of_Votes')\"\n        - column_name:\
    \ \"No_of_Votes\"\n          code_contains: \".isNonNegative('No_of_Votes')\"\n\
    \n  - name: \"Runtime format is '<digits> min'\"\n    input: {}\n    expected:\n\
    \      description: \"Constraint enforces the exact Runtime format that parsing\
    \ expects.\"\n      must_include:\n        - column_name: \"Runtime\"\n      \
    \    code_contains: \".containsPattern('Runtime', '^\\\\\\\\d+\\\\\\\\s*min$')\"\
    \n      allow_additional: true\n\n  - name: \"Poster link is an HTTP(S) URL\"\n\
    \    input: {}\n    expected:\n      description: \"Constraint enforces that Poster_Link\
    \ starts with http or https.\"\n      must_include:\n        - column_name: \"\
    Poster_Link\"\n          code_contains: \".containsPattern('Poster_Link', '^https?://')\"\
    \n\n  - name: \"Certificate values constrained to allowed set\"\n    input: {}\n\
    \    expected:\n      description: \"Constraint ensures only the allowed certificates\
    \ appear when present.\"\n      must_include:\n        - column_name: \"Certificate\"\
    \n          code_contains_any:\n            - \".isContainedIn('Certificate',\
    \ ['U', 'UA', 'A', 'G', 'PG', 'PG-13', 'R', 'NC-17', 'Not Rated', 'Unrated', 'Passed',\
    \ 'Approved'])\"\n            - '.isContainedIn(\"Certificate\", [\"U\", \"UA\"\
    , \"A\", \"G\", \"PG\", \"PG-13\", \"R\", \"NC-17\", \"Not Rated\", \"Unrated\"\
    , \"Passed\", \"Approved\"])'\n      note: \"Accept either single or double quotes\
    \ and list syntax variations.\""
