    \       .enableHiveSupport()\n      0115:         .getOrCreate()\n      0116:\
    \     )\n      0117:     spark.sparkContext.setLogLevel(\"ERROR\")\n      0118:\
    \     return spark\n      0119: \n      0120: \n      0121: # ---- SQL execution\
    \ -------------------------------------------------------\n      0122: \n    \
    \  0123: # Match `-- [python cell handled by Python adapter] ...` lines that the\n\
    \      0124: # upstream-edit step left behind in the SQL files.\n      0125: _PYTHON_PLACEHOLDER_RE\
    \ = re.compile(r\"^\\s*--\\s*\\[python cell.*$\", re.MULTILINE)\n      0126: \n\
    \      0127: \n      0128: def split_sql_statements(sql_text: str) -> list[str]:\n\
    \      0129:     \"\"\"Strip line comments + placeholder markers, then split on\
    \ `;`.\"\"\"\n      0130:     text = _PYTHON_PLACEHOLDER_RE.sub(\"\", sql_text)\n\
    \      0131:     cleaned_lines = []\n      0132:     for line in text.splitlines():\n\
    \      0133:         if line.strip().startswith(\"--\"):\n      0134:        \
    \     continue\n      0135:         cleaned_lines.append(line)\n      0136:  \
    \   return [stmt.strip() for stmt in \"\\n\".join(cleaned_lines).split(\";\")\
    \ if stmt.strip()]\n      0137: \n      0138: \n      0139: def execute_sql_file(spark:\
    \ Any, path: Path) -> dict[str, Any]:\n      0140:     statements = split_sql_statements(path.read_text(encoding=\"\
    utf-8\"))\n      0141:     executed = 0\n      0142:     failures: list[dict[str,\
    \ Any]] = []\n      0143:     for index, stmt in enumerate(statements):\n    \
    \  0144:         try:\n      0145:             spark.sql(stmt)\n      0146:  \
    \           executed += 1\n      0147:         except Exception as exc:  # noqa:\
    \ BLE001\n      0148:             failures.append({\n      0149:             \
    \    \"file\": path.name,\n      0150:                 \"stmt_index\": index,\n\
    \      0151:                 \"statement_head\": stmt.splitlines()[0][:160],\n\
    \      0152:                 \"error\": f\"{type(exc).__name__}: {exc}\"[:400],\n\
    \      0153:             })\n      0154:     return {\n      0155:         \"\
    file\": path.name,\n      0156:         \"statements_total\": len(statements),\n\
    \      0157:         \"statements_executed\": executed,\n      0158:         \"\
    failures\": failures,\n      0159:     }\n      0160: \n      0161: \n      0162:\
    \ # ---- Vocab loading -------------------------------------------------------\n\
    \      0163: \n      0164: def load_vocab_subset(spark: Any, input_dir: Path)\
    \ -> dict[str, int]:\n      0165:     from pyspark.sql import functions as F\n\
    \      0166: \n      0167:     vocab_dir = input_dir / \"vocab\"\n      0168:\
    \     if not vocab_dir.exists():\n      0169:         raise FileNotFoundError(\n\
    \      0170:             f\"vocab subset not found at {vocab_dir}. \"\n      0171:\
    \             f\"Generate it with `uv run python scripts/filter_omop_vocab.py`.\"\
    \n      0172:         )\n      0173:     counts: dict[str, int] = {}\n      0174:\
    \     for table in VOCAB_TABLES:\n      0175:         path = vocab_dir / f\"{table}.csv.gz\"\
    \n      0176:         if not path.exists():\n      0177:             raise FileNotFoundError(f\"\
    missing {path}\")\n      0178:         df = spark.read.csv(str(path), header=True,\
