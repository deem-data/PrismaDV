    \ in OMOP_OUTPUT_TABLES:\n      0197:         try:\n      0198:             counts[table]\
    \ = int(spark.sql(f\"SELECT COUNT(*) AS n FROM {table}\").collect()[0][\"n\"])\n\
    \      0199:         except Exception:\n      0200:             counts[table]\
    \ = None\n      0201:     return counts\n      0202: \n      0203: \n      0204:\
