    \     spark.sql(\n      0185:             f\"INSERT OVERWRITE TABLE {table} ({column_list})\
    \ \"\n      0186:             f\"SELECT {column_list} FROM _load_{table.lower()}\"\
    \n      0187:         )\n      0188:         counts[table] = df.count()\n    \
    \  0189:     return counts\n      0190: \n      0191: \n      0192: # ---- OMOP\
    \ table accounting ----------------------------------------------\n      0193:\
    \ \n      0194: def collect_omop_table_counts(spark: Any) -> dict[str, int | None]:\n\
