    \ \n      0993: INSERT OVERWRITE cdm_source \n      0994: SELECT\n      0995:\
    \ 'Synthea synthetic health database',\n      0996: 'Synthea',\n      0997: 'Databricks\
    \ HLS',\n      0998: 'SyntheaTM is a Synthetic Patient Population Simulator. The\
    \ goal is to output synthetic, realistic (but not real), patient data and associated\
