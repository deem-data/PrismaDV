    \ 0267:     counts: dict[str, int] = {}\n      0268:     with sqlite3.connect(str(sqlite_path))\
    \ as conn:\n      0269:         for table in tables:\n      0270:            \
    \ pdf = spark.sql(f\"SELECT * FROM {table}\").toPandas()\n      0271:        \
    \     for col in pdf.columns:\n      0272:                 dtype_name = str(pdf[col].dtype).lower()\n\
