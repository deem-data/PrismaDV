    \      0274:                     pdf[col] = pdf[col].astype(\"string\").where(pdf[col].notna(),\
    \ None)\n      0275:             pdf.to_sql(table, conn, if_exists=\"replace\"\
    , index=False)\n      0276:             counts[table] = int(len(pdf))\n      0277:\
    \     return counts\n      0278: \n      0279: \n      0280: def run_chf_cohort(input_dir:\
    \ Path, output_dir: Path) -> dict[str, Any]:\n      0281:     if not PIXI_BIN.exists():\n\
    \      0282:         raise FileNotFoundError(\n      0283:             f\"pixi\
    \ binary not found at {PIXI_BIN}; install with \"\n      0284:             \"\
