    \      1005: from vocabulary \n      1006: where vocabulary_id = 'None';\n   \
    \   1007: \n      1008: SELECT * FROM cdm_source LIMIT 100;\n\n# File: source_repo/5-CHF-cohort-building.r\n\
    \      0001: # CHF cohort identification, ported from the upstream\n      0002:\
    \ # `adapter/source_repo/r_scripts/5-CHF-cohort-building.r`.\n      0003: #\n\
    \      0004: # The upstream targets Databricks SparkR. This port runs against\
    \ a SQLite\n      0005: # database that the Python adapter writes after the OMOP\
    \ CDM ETL. Spark SQL\n      0006: # CTEs translate to SQLite with three small\
    \ syntax tweaks:\n      0007: #   - `date_add(d, n)`  \u2192 `date(d, '+n days')`\n\
    \      0008: #   - `DATEDIFF(a, b)`  \u2192 `CAST(julianday(a) - julianday(b)\
    \ AS INTEGER)`\n      0009: #   - `YEAR(d)`         \u2192 `CAST(strftime('%Y',\
    \ d) AS INTEGER)`\n      0010: #\n      0011: # Arguments (positional): <sqlite-db-path>\
    \ <output-json-path>\n      0012: \n      0013: suppressPackageStartupMessages({\n\
    \      0014:   library(DBI)\n      0015:   library(RSQLite)\n      0016:   library(glue)\n\
    \      0017:   library(jsonlite)\n      0018: })\n      0019: \n      0020: args\
    \ <- commandArgs(trailingOnly = TRUE)\n      0021: if (length(args) != 2) {\n\
    \      0022:   stop(\"usage: Rscript chf_cohort.R <sqlite-db> <output-json>\"\
    )\n      0023: }\n      0024: sqlite_db    <- args[[1]]\n      0025: output_json\
    \  <- args[[2]]\n      0026: \n      0027: con <- dbConnect(RSQLite::SQLite(),\
    \ sqlite_db)\n      0028: on.exit(dbDisconnect(con), add = TRUE)\n      0029:\
    \ \n      0030: target_condition_concept_id <- 4229440  # Chronic congestive heart\
    \ failure (disorder)\n      0031: target_drug_concept_id      <- 1719286  # 10\
    \ ML Furosemide 10 MG/ML Injection\n      0032: \n      0033: # 1. Target cohort:\
    \ newly-diagnosed CHF patients with 3+ years of prior\n      0034: #    observation\
    \ and no prior Furosemide exposure.\n      0035: target_cohort_query <- glue(\"\
    \n      0036: WITH targetConditionSet AS (\n      0037:     SELECT person_id,\
    \ MIN(condition_start_date) AS condition_start_date\n      0038:     FROM condition_occurrence\n\
    \      0039:     WHERE condition_concept_id IN (\n      0040:         SELECT descendant_concept_id\
    \ FROM concept_ancestor\n      0041:         WHERE ancestor_concept_id IN ({target_condition_concept_id})\n\
    \      0042:     )\n      0043:     GROUP BY person_id\n      0044: ),\n     \
    \ 0045: targetDrugExposure AS (\n      0046:     SELECT person_id, MIN(drug_exposure_start_date)\
    \ AS drug_exposure_start_date\n      0047:     FROM drug_exposure\n      0048:\
    \     WHERE drug_concept_id IN (\n      0049:         SELECT descendant_concept_id\
    \ FROM concept_ancestor\n      0050:         WHERE ancestor_concept_id IN ({target_drug_concept_id})\n\
    \      0051:     )\n      0052:     GROUP BY person_id\n      0053: )\n      0054:\
    \ SELECT 1 AS cohort_definition_id,\n      0055:        t.person_id AS subject_id,\n\
    \      0056:        t.condition_start_date AS cohort_start_date,\n      0057:\
    \        op.observation_period_end_date AS cohort_end_date\n      0058: FROM targetConditionSet\
    \ t\n      0059: INNER JOIN observation_period op\n      0060:   ON t.person_id\
    \ = op.person_id\n      0061:   AND t.condition_start_date >= date(op.observation_period_start_date,\
    \ '+1095 days')\n      0062:   AND t.condition_start_date <= op.observation_period_end_date\n\
    \      0063: LEFT JOIN targetDrugExposure dx\n      0064:   ON t.person_id = dx.person_id\n\
    \      0065:   AND t.condition_start_date > dx.drug_exposure_start_date\n    \
    \  0066: WHERE dx.person_id IS NULL\n      0067: \")\n      0068: dbExecute(con,\
    \ \"DROP TABLE IF EXISTS targetCohort\")\n      0069: dbExecute(con, paste0(\"\
    CREATE TABLE targetCohort AS \", target_cohort_query))\n      0070: target_rows\
    \ <- dbGetQuery(con, \"SELECT COUNT(*) AS n FROM targetCohort\")$n\n      0071:\
    \ \n      0072: # 2. Outcome cohort: ER visits.\n      0073: outcome_concept_id\
    \ <- 9203  # Emergency Room Visit\n      0074: outcome_cohort_query <- glue(\"\
    \n      0075: SELECT 2 AS cohort_definition_id,\n      0076:        v.person_id\
    \ AS subject_id,\n      0077:        v.visit_start_date AS cohort_start_date,\n\
    \      0078:        v.visit_end_date AS cohort_end_date\n      0079: FROM visit_occurrence\
    \ v\n      0080: WHERE v.visit_concept_id IN ({outcome_concept_id})\n      0081:\
    \ GROUP BY v.person_id, v.visit_start_date, v.visit_end_date\n      0082: \")\n\
    \      0083: dbExecute(con, \"DROP TABLE IF EXISTS outcomeCohort\")\n      0084:\
    \ dbExecute(con, paste0(\"CREATE TABLE outcomeCohort AS \", outcome_cohort_query))\n\
    \      0085: outcome_rows <- dbGetQuery(con, \"SELECT COUNT(*) AS n FROM outcomeCohort\"\
    )$n\n      0086: \n      0087: # 3. Union into a single cohort table.\n      0088:\
    \ dbExecute(con, \"DROP TABLE IF EXISTS CHF_cohort\")\n      0089: dbExecute(con,\
    \ \"\n      0090: CREATE TABLE CHF_cohort AS\n      0091: SELECT * FROM targetCohort\n\
    \      0092: UNION ALL\n      0093: SELECT * FROM outcomeCohort\n      0094: \"\
    )\n      0095: union_rows <- dbGetQuery(con, \"SELECT COUNT(*) AS n FROM CHF_cohort\"\
    )$n\n      0096: \n      0097: # 4. Incidence rate stratified by age band and\
    \ gender.\n      0098: incident_rate_query <- \"\n      0099: WITH tar AS (\n\
    \      0100:     SELECT c.concept_name AS gender,\n      0101:            (CAST(strftime('%Y',\
    \ chf.cohort_start_date) AS INTEGER) - p.year_of_birth) / 10 * 10 AS age,\n  \
    \    0102:            chf.subject_id,\n      0103:            chf.cohort_start_date,\n\
    \      0104:            CASE\n      0105:              WHEN date(chf.cohort_start_date,\
    \ '+7 days') > op.observation_period_end_date\n      0106:                THEN\
    \ op.observation_period_end_date\n      0107:              ELSE date(chf.cohort_start_date,\
    \ '+7 days')\n      0108:            END AS cohort_end_date\n      0109:     FROM\
    \ CHF_cohort chf\n      0110:     INNER JOIN observation_period op\n      0111:\
    \       ON chf.subject_id = op.person_id\n      0112:       AND op.observation_period_start_date\
    \ < chf.cohort_start_date\n      0113:       AND op.observation_period_end_date\
    \ > chf.cohort_start_date\n      0114:     INNER JOIN person p ON chf.subject_id\
    \ = p.person_id\n      0115:     INNER JOIN concept c ON p.gender_concept_id =\
    \ c.concept_id\n      0116:     WHERE chf.cohort_definition_id = 1\n      0117:\
    \ )\n      0118: SELECT days.gender,\n      0119:        days.age,\n      0120:\
    \        days.days,\n      0121:        CASE WHEN events.events IS NULL THEN 0\
    \ ELSE events.events END AS events,\n      0122:        CASE WHEN days.days =\
    \ 0 THEN NULL\n      0123:             ELSE 1000.0 * (CASE WHEN events.events\
    \ IS NULL THEN 0 ELSE events.events END) / days.days / 7.0\n      0124:      \
    \  END AS incidence_rate_per_1000_person_weeks\n      0125: FROM (\n      0126:\
    \     SELECT gender, age,\n      0127:            SUM(CAST(julianday(cohort_end_date)\
    \ - julianday(cohort_start_date) AS INTEGER)) AS days\n      0128:     FROM tar\n\
    \      0129:     GROUP BY gender, age\n      0130: ) days\n      0131: LEFT JOIN\
    \ (\n      0132:     SELECT tar.gender, tar.age, COUNT(*) AS events\n      0133:\
    \     FROM tar\n      0134:     INNER JOIN CHF_cohort chf\n      0135:       ON\
    \ tar.subject_id = chf.subject_id\n      0136:       AND tar.cohort_start_date\
    \ <= chf.cohort_start_date\n      0137:       AND tar.cohort_end_date   >= chf.cohort_start_date\n\
    \      0138:     WHERE chf.cohort_definition_id = 2\n      0139:     GROUP BY\
    \ tar.gender, tar.age\n      0140: ) events\n      0141: ON days.gender = events.gender\
    \ AND days.age = events.age\n      0142: ORDER BY days.gender, days.age\n    \
    \  0143: \"\n      0144: incident_rate <- dbGetQuery(con, incident_rate_query)\n\
    \      0145: \n      0146: # 5. Top-line target-cohort summary (gender \xD7 age\
    \ band).\n      0147: target_cohort_breakdown_query <- \"\n      0148: SELECT\
    \ c.concept_name AS gender,\n      0149:        (CAST(strftime('%Y', chf.cohort_start_date)\
    \ AS INTEGER) - p.year_of_birth) / 10 * 10 AS age_band,\n      0150:        COUNT(*)\
    \ AS n_patients\n      0151: FROM CHF_cohort chf\n      0152: INNER JOIN person\
    \ p ON chf.subject_id = p.person_id\n      0153: INNER JOIN concept c ON p.gender_concept_id\
    \ = c.concept_id\n      0154: WHERE chf.cohort_definition_id = 1\n      0155:\
    \ GROUP BY c.concept_name, age_band\n      0156: ORDER BY c.concept_name, age_band\n\
    \      0157: \"\n      0158: target_breakdown <- dbGetQuery(con, target_cohort_breakdown_query)\n\
    \      0159: \n      0160: summary <- list(\n      0161:   target_condition_concept_id\
    \ = target_condition_concept_id,\n      0162:   target_drug_concept_id      =\
    \ target_drug_concept_id,\n      0163:   outcome_concept_id          = outcome_concept_id,\n\
    \      0164:   target_cohort_rows          = target_rows,\n      0165:   outcome_cohort_rows\
    \         = outcome_rows,\n      0166:   chf_cohort_union_rows       = union_rows,\n\
    \      0167:   target_cohort_by_age_gender = target_breakdown,\n      0168:  \
    \ incident_rate               = incident_rate\n      0169: )\n      0170: \n \
    \     0171: writeLines(toJSON(summary, dataframe = \"rows\", pretty = TRUE, auto_unbox\
    \ = TRUE), output_json)\n      0172: cat(\"wrote \", output_json, \"\\n\", sep\
    \ = \"\")\n\n# File: source_repo/6-drug-analysis.py\n      0001: # Drug Usage\
    \ Trends \u2014 local PySpark port of the upstream Databricks notebook.\n    \
    \  0002: #\n      0003: # In the upstream notebook this file is a Databricks notebook\
    \ with mixed\n      0004: # `# MAGIC %sql` and `# MAGIC %python` cells. For the\
    \ local RealETLBench\n      0005: # adapter we expose a single function `run_drug_analysis(spark)`\
    \ that runs the\n      0006: # same four analytical queries against an existing\
    \ Spark session (the OMOP\n      0007: # tables must already be populated by the\
    \ SQL ETL).\n      0008: #\n      0009: # Three downstream changes vs. upstream:\n\
    \      0010: #   - No `USE omop531;` \u2014 we rely on Spark's default database\
    \ for managed tables.\n      0011: #   - No plotly rendering \u2014 we capture\
    \ row counts and the top-N sample rows so\n      0012: #     the adapter can serialize\
    \ an analytical summary to JSON.\n      0013: #   - The FP-Growth (mllib) frequent-itemset\
    \ example is not ported; the cosine\n      0014: #     similarity example covers\
    \ the same drug-pair signal with simpler code.\n      0015: from __future__ import\
    \ annotations\n      0016: from typing import Any\n      0017: \n      0018: \n\
    \      0019: # Example 1: usage of Oxycodone (concept_id 1124957) stratified by\
    \ age, year, gender.\n      0020: OXYCODONE_USAGE = \"\"\"\n      0021: SELECT\n\
    \      0022:     tt.drug_concept_name,\n      0023:     tt.drug_concept_id,\n\
    \      0024:     count(1) AS s_count,\n      0025:     tt.age_band,\n      0026:\
    \     tt.year_of_era,\n      0027:     tt.gender\n      0028: FROM (\n      0029:\
    \     SELECT\n      0030:         floor((extract(year FROM t.drug_era_start_date)\
    \ - p.year_of_birth) / 10) AS age_band,\n      0031:         extract(year FROM\
    \ t.drug_era_start_date) AS year_of_era,\n      0032:         p.gender_concept_id,\n\
    \      0033:         t.drug_concept_id,\n      0034:         c.concept_name AS\
    \ drug_concept_name,\n      0035:         c1.concept_name AS gender\n      0036:\
    \     FROM drug_era t, person p, concept c, concept c1\n      0037:     WHERE\
    \ t.person_id = p.person_id\n      0038:       AND c.concept_id = t.drug_concept_id\n\
    \      0039:       AND c1.concept_id = p.gender_concept_id\n      0040:      \
    \ AND c.concept_id = 1124957\n      0041: ) tt\n      0042: WHERE tt.year_of_era\
    \ > 2000\n      0043: GROUP BY tt.age_band, tt.year_of_era, tt.gender, tt.drug_concept_name,\
    \ tt.drug_concept_id\n      0044: ORDER BY tt.age_band, tt.year_of_era, tt.drug_concept_id\n\
    \      0045: \"\"\"\n      0046: \n      0047: # Example 2: top drugs prescribed\
    \ by year.\n      0048: TOP_DRUGS_BY_YEAR = \"\"\"\n      0049: WITH tt AS (\n\
    \      0050:     SELECT\n      0051:         extract(year FROM t.drug_era_start_date)\
    \ AS year_of_era,\n      0052:         t.drug_concept_id,\n      0053:       \
    \  c.concept_name AS drug_concept_name\n      0054:     FROM drug_era t, concept\
    \ c\n      0055:     WHERE t.drug_concept_id = c.concept_id\n      0056: )\n \
    \     0057: SELECT\n      0058:     tt.drug_concept_name,\n      0059:     tt.drug_concept_id,\n\
    \      0060:     tt.year_of_era,\n      0061:     count(1) AS drug_count\n   \
    \   0062: FROM tt\n      0063: GROUP BY tt.drug_concept_name, tt.year_of_era,\
    \ tt.drug_concept_id\n      0064: ORDER BY drug_count DESC\n      0065: \"\"\"\
    \n      0066: \n      0067: # Example 3: age-at-first-exposure distribution for\
    \ Hydrocodone vs Oxycodone.\n      0068: AGE_DISTRIBUTION = \"\"\"\n      0069:\
    \ SELECT\n      0070:     extract(year FROM (min(t.drug_era_start_date) OVER (PARTITION\
    \ BY t.person_id, t.drug_concept_id))) - p.year_of_birth AS age,\n      0071:\
    \     c.concept_name AS d_concept_name\n      0072: FROM drug_era t, person p,\
    \ concept c\n      0073: WHERE t.person_id = p.person_id\n      0074:   AND t.drug_concept_id\
    \ = c.concept_id\n      0075:   AND t.drug_concept_id IN (1124957, 1174888)\n\
    \      0076: \"\"\"\n      0077: \n      0078: # Example 4.1: pairwise co-prescription\
    \ cosine similarity.\n      0079: COPRESCRIBED_VIEW = \"\"\"\n      0080: CREATE\
    \ OR REPLACE TEMPORARY VIEW COPRESCRIBED AS\n      0081: WITH drugs_and_names\
    \ AS (\n      0082:     SELECT PERSON_ID, c.concept_name AS drug_concept_name,\n\
    \      0083:            DRUG_CONCEPT_ID, DRUG_ERA_START_DATE, DRUG_ERA_END_DATE\n\
    \      0084:     FROM drug_era JOIN concept c\n      0085:     WHERE DRUG_CONCEPT_ID\
    \ = c.concept_id\n      0086: ),\n      0087: drugs AS (\n      0088:     SELECT\
    \ d1.PERSON_ID,\n      0089:            d1.DRUG_CONCEPT_ID AS drug_id1,\n    \
    \  0090:            d2.DRUG_CONCEPT_ID AS drug_id2,\n      0091:            d1.drug_concept_name\
    \ AS drug1,\n      0092:            d2.drug_concept_name AS drug2,\n      0093:\
    \            d1.DRUG_ERA_START_DATE AS d1_start,\n      0094:            d1.DRUG_ERA_END_DATE\
    \   AS d1_end,\n      0095:            d2.DRUG_ERA_START_DATE AS d2_start,\n \
    \     0096:            d2.DRUG_ERA_END_DATE   AS d2_end\n      0097:     FROM\
    \ drugs_and_names d1 JOIN drugs_and_names d2\n      0098:     WHERE d1.PERSON_ID\
    \ = d2.PERSON_ID\n      0099:       AND ABS(datediff(d1.DRUG_ERA_START_DATE, d2.DRUG_ERA_START_DATE))\
    \ <= 5\n      0100:       AND ABS(datediff(d1.DRUG_ERA_END_DATE,   d2.DRUG_ERA_END_DATE))\
    \   <= 5\n      0101: ),\n      0102: counts AS (\n      0103:     SELECT drug1,\
    \ drug2, count(*) AS count_d1d2\n      0104:     FROM drugs GROUP BY 1, 2\n  \
    \    0105: ),\n      0106: pairwise_sums AS (\n      0107:     SELECT drug1, drug2,\
    \ count_d1d2,\n      0108:         sum(count_d1d2) OVER (PARTITION BY drug1) AS\
    \ sum_d1,\n      0109:         sum(count_d1d2) OVER (PARTITION BY drug2) AS sum_d2,\n\
    \      0110:         sum(count_d1d2) OVER ()                    AS sum_all\n \
    \     0111:     FROM counts\n      0112: )\n      0113: SELECT drug1, drug2, count_d1d2,\n\
    \      0114:        count_d1d2 / sum_d1 AS supp_d1d2,\n      0115:        count_d1d2\
    \ / sum_d2 AS supp_d2d1,\n      0116:        sum_d1 / sum_all     AS supp_d1,\n\
    \      0117:        sum_d2 / sum_all     AS supp_d2\n      0118: FROM pairwise_sums\n\
    \      0119: \"\"\"\n      0120: \n      0121: COPRESCRIBED_COSINE = \"\"\"\n\
    \      0122: SELECT drug1, drug2, supp_d1d2,\n      0123:        log(supp_d1d2\
    \ / sqrt(supp_d1 * supp_d2)) AS lod_cosine_d1d2,\n      0124:        log(supp_d1d2)\
    \ - log(supp_d1)             AS lod_d1d2\n      0125: FROM COPRESCRIBED\n    \
    \  0126: ORDER BY lod_cosine_d1d2 DESC\n      0127: \"\"\"\n      0128: \n   \
    \   0129: \n      0130: def _rows_as_dicts(spark_df: Any, limit: int) -> list[dict[str,\
    \ Any]]:\n      0131:     rows = spark_df.limit(limit).collect()\n      0132:\
    \     out: list[dict[str, Any]] = []\n      0133:     for row in rows:\n     \
    \ 0134:         d = row.asDict(recursive=True)\n      0135:         for key, val\
    \ in list(d.items()):\n      0136:             if val is None or isinstance(val,\
    \ (bool, int, float, str)):\n      0137:                 continue\n      0138:\
    \             try:\n      0139:                 d[key] = float(val)\n      0140:\
    \             except Exception:\n      0141:                 d[key] = str(val)\n\
    \      0142:         out.append(d)\n      0143:     return out\n      0144: \n\
    \      0145: \n      0146: def run_drug_analysis(spark: Any) -> dict[str, Any]:\n\
    \      0147:     \"\"\"Run the four analytical queries against the already-populated\
    \ OMOP CDM.\n      0148: \n      0149:     Returns a JSON-serializable dict with\
    \ row counts and top-N samples per\n      0150:     query \u2014 enough for the\
    \ benchmark to compare clean and corrupted runs.\n      0151:     \"\"\"\n   \
    \   0152:     oxycodone = spark.sql(OXYCODONE_USAGE)\n      0153:     top_drugs\
    \ = spark.sql(TOP_DRUGS_BY_YEAR)\n      0154:     age_dist = spark.sql(AGE_DISTRIBUTION)\n\
    \      0155:     spark.sql(COPRESCRIBED_VIEW)\n      0156:     cosine = spark.sql(COPRESCRIBED_COSINE)\n\
    \      0157: \n      0158:     return {\n      0159:         \"oxycodone_usage_by_age_year_gender\"\
    : {\n      0160:             \"total_rows\": oxycodone.count(),\n      0161: \
    \            \"sample_rows\": _rows_as_dicts(oxycodone, 10),\n      0162:    \
    \     },\n      0163:         \"top_drugs_by_year\": {\n      0164:          \
    \   \"total_rows\": top_drugs.count(),\n      0165:             \"top_10_rows\"\
    : _rows_as_dicts(top_drugs, 10),\n      0166:         },\n      0167:        \
    \ \"age_distribution_hydrocodone_vs_oxycodone\": {\n      0168:             \"\
    total_rows\": age_dist.count(),\n      0169:             \"sample_rows\": _rows_as_dicts(age_dist,\
    \ 10),\n      0170:         },\n      0171:         \"coprescribed_cosine\": {\n\
    \      0172:             \"total_rows\": cosine.count(),\n      0173:        \
    \     \"top_10_pairs\": _rows_as_dicts(cosine, 10),\n      0174:         },\n\
    \      0175:     }\n\n# File: pyproject.toml\n      0001: [project]\n      0002:\
