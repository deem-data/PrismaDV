    \      0327:         raise ValueError(f\"unknown script_id: {script_id}\")\n \
    \     0328:     clean_output_dir(output_dir)\n      0329:     if script_id ==\
    \ \"sql_etl\":\n      0330:         summary = run_sql_etl(input_dir, output_dir)\n\
    \      0331:     elif script_id == \"drug_analysis\":\n      0332:         summary\
    \ = run_drug_analysis(input_dir, output_dir)\n      0333:     elif script_id ==\
    \ \"chf_cohort\":\n      0334:         summary = run_chf_cohort(input_dir, output_dir)\n\
    \      0335:     else:\n      0336:         raise AssertionError(script_id)\n\
    \      0337:     write_summary(output_dir, summary)\n\n# File: source_repo/1-data-ingest.py\n\
    \      0001: # Synthea bronze ingestion \u2014 local PySpark port of the upstream\
    \ Databricks notebook.\n      0002: #\n      0003: # The upstream notebook reads\
    \ Synthea CSVs from `/dbfs/<synthea_path>/` listed\n      0004: # via `dbutils.fs.ls(...)`,\
    \ then writes them as delta tables in the bronze\n      0005: # layer. For the\
    \ local RealETLBench adapter we expose a single function\n      0006: # `register_bronze_views(spark,\
    \ input_dir)` that registers CSV-backed temp\n      0007: # views matching the\
    \ table names the downstream OMOP ETL expects.\n      0008: #\n      0009: # Three\
    \ downstream changes vs. upstream:\n      0010: #   - No DBFS \u2014 Synthea CSVs\
    \ are read directly from `<input_dir>/*.csv`.\n      0011: #   - No delta writes\
    \ \u2014 bronze tables are Spark temporary views (the OMOP ETL\n      0012: #\
    \     reads from them by name, not by delta path).\n      0013: #   - The benchmark\
    \ only stages six of the upstream's sixteen Synthea tables;\n      0014: #   \
    \  `immunizations` is stubbed empty (the OMOP ETL does a LEFT JOIN on it)\n  \
    \    0015: #     and `procedures.DATE` is renamed to `procedures.START` to match\
    \ the\n      0016: #     upstream Synthea schema.\n      0017: from __future__\
    \ import annotations\n      0018: from pathlib import Path\n      0019: from typing\
    \ import Any\n      0020: \n      0021: \n      0022: # Six Synthea tables our\
    \ 3,000-patient bundled subset actually contains.\n      0023: SYNTHEA_INPUT_TABLES\
    \ = (\n      0024:     \"patients\",\n      0025:     \"encounters\",\n      0026:\
    \     \"conditions\",\n      0027:     \"medications\",\n      0028:     \"observations\"\
    ,\n      0029:     \"procedures\",\n      0030: )\n      0031: \n      0032: #\
    \ Tables the upstream ETL references but our subset does not include \u2014 they\n\
