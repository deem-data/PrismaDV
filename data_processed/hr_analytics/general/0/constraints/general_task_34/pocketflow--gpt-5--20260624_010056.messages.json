    \ 'alert_priority', 'hrbp_owner']].to_csv(alerts_path,\n                     \
    \                                                                           index=False)\n\
    \nworkload = alerts.groupby('hrbp_owner', as_index=False).size().rename(columns={'size':\
    \ 'alert_count'})\nworkload_path = os.path.join(args.output, 'hrbp_workload.csv')\n\
    workload.to_csv(workload_path, index=False)\n\nsummary = {\n    'base_yes_rate':\
