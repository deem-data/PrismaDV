    # Features for risk\nsafe_yac = yac.fillna(0)\nsafe_ysp = ysp.fillna(0)\nden =\
    \ safe_yac.replace(0, np.nan)\ntenure_ratio = (safe_ysp / den).fillna(0.0)\n\n\
    ot_flag = (df['OverTime'] == 'Yes').astype(float)\njob_sat_map = {1: 0.4, 2: 0.2,\
    \ 3: -0.1, 4: -0.2}\nwlb_map = {1: 0.5, 2: 0.2, 3: 0.0, 4: -0.1}\njob_penalty\
