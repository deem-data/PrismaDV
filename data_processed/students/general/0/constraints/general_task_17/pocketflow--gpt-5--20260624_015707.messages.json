    mac_infl = pd.to_numeric(df[col_infl], errors='coerce')\n# Macro stress feature\
    \ (higher = worse environment)\nzg = (mac_gdp - mac_gdp.mean()) / mac_gdp.std(ddof=0)\n\
    zu = (mac_unemp - mac_unemp.mean()) / mac_unemp.std(ddof=0)\nzi = (mac_infl -\
    \ mac_infl.mean()) / mac_infl.std(ddof=0)\nmacro_stress = sigmoid(zu - zg + 0.3\
    \ * zi)\n\n# Application order checks before mapping to weights\napp_order = pd.to_numeric(df[col_app_order],\
    \ errors='coerce').astype('Int64')\n# Map application order to commitment weights\
