    import argparse\nimport os\n\nimport numpy as np\nimport pandas as pd\n\n\ndef\
    \ main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--input',\
    \ type=str, required=True)\n    parser.add_argument('--output', type=str, required=True)\n\
    \    args = parser.parse_args()\n\n    os.makedirs(args.output, exist_ok=True)\n\
    \    input_file = os.path.join(args.input, 'new_data.csv')\n    df = pd.read_csv(input_file)\n\
    \n    # Normalize numeric columns\n    numeric_cols = [\n        'Daily Steps',\
    \ 'Physical Activity Level', 'Sleep Duration',\n        'Quality of Sleep', 'Age',\
    \ 'Stress Level', 'Heart Rate'\n    ]\n    for c in numeric_cols:\n        if\
    \ c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\
    \n    mask_activity = df['Daily Steps'].notna() & df['Physical Activity Level'].notna()\n\
    \    # Fit a simple linear model to predict expected steps from activity level\n\
    \    slope, intercept = np.polyfit(\n        df.loc[mask_activity, 'Physical Activity\
    \ Level'],\n        df.loc[mask_activity, 'Daily Steps'], 1\n    )\n    expected_steps\
    \ = df['Physical Activity Level'] * slope + intercept\n\n    high_pa_mask = df['Physical\
    \ Activity Level'].notna() & (df['Physical Activity Level'] >= 90)\n    sd = df['Sleep\
    \ Duration']\n    duration_log = np.log(sd)\n\n    q = df['Quality of Sleep']\n\
    \    int_like = q.dropna().apply(lambda x: float(x).is_integer())\n    q_idx =\
    \ q.astype(int)\n    quality_penalty_map = np.array([0, 40, 35, 30, 25, 20, 15,\
    \ 10, 5, 2, 0])\n    quality_penalty = pd.Series(quality_penalty_map[q_idx.values],\
    \ index=df.index)\n    sys_dia = df['Blood Pressure'].str.split('/', expand=True).astype(int)\n\
    \    df['systolic'] = sys_dia[0]\n    df['diastolic'] = sys_dia[1]\n\n    s =\
    \ df['systolic']\n    d = df['diastolic']\n    pulse_pressure = s - d\n    pulse_pressure_log\
    \ = np.log(pulse_pressure)\n\n    # Sleep-related components\n    sleep_duration_component\
    \ = np.abs(sd - 8.0) * 7.0\n    sleep_quality_component = quality_penalty\n  \
    \  sleep_disorder_component = df.get('Sleep Disorder', pd.Series(index=df.index,\
    \ dtype=object)).fillna(\n        '').str.strip().isin(['Insomnia', 'Sleep Apnea']).astype(int)\
    \ * 25.0\n\n    # Activity components\n    steps = df['Daily Steps']\n    expected_clipped\
    \ = expected_steps.clip(lower=1)\n    shortfall_ratio = np.maximum(0.0, 8000.0\
    \ - steps) / 8000.0\n    shortfall_component = shortfall_ratio * 25.0\n    mismatch_component\
    \ = (np.abs(steps - expected_steps) / expected_clipped).clip(upper=1.5) * 8.0\n\
    \    activity_component = shortfall_component + mismatch_component\n\n    # Blood\
    \ pressure components\n    bp_stage_component = np.select(\n        [\n      \
    \      (s >= 140) | (d >= 90),\n            ((s >= 130) & (s < 140)) | ((d >=\
    \ 80) & (d < 90)),\n            ((s >= 120) & (s < 130)) & (d < 80)\n        ],\n\
    \        [30.0, 20.0, 10.0],\n        default=0.0\n    )\n    pulse_pressure_component\
    \ = np.clip((pulse_pressure_log - np.log(40.0)) * 5.0, 0.0, 10.0)\n\n    # Other\
    \ modifiers\n    stress = df['Stress Level'].fillna(0)\n    stress_component =\
    \ (stress / 10.0) * 20.0\n\n    bmi_map = {\n        'Obese': 25.0,\n        'Overweight':\
    \ 10.0,\n        'Normal': 0.0,\n        'Normal Weight': 0.0\n    }\n    bmi_component\
    \ = df['BMI Category'].map(bmi_map).fillna(5.0)\n\n    age = df['Age'].fillna(0)\n\
    \    age_component = np.select(\n        [age >= 60, age >= 45],\n        [10.0,\
    \ 5.0],\n        default=0.0\n    )\n\n    # Aggregate and cap risk score\n  \
    \  risk_score = (\n            sleep_duration_component\n            + sleep_quality_component\n\
    \            + sleep_disorder_component\n            + activity_component\n  \
    \          + bp_stage_component\n            + pulse_pressure_component\n    \
    \        + stress_component\n            + bmi_component\n            + age_component\n\
    \    ).clip(lower=0.0, upper=100.0)\n\n    # Tiering for outreach prioritization\n\
    \    risk_tier = pd.cut(\n        risk_score,\n        bins=[-np.inf, 39.999,\
    \ 69.999, np.inf],\n        labels=['Low', 'Medium', 'High']\n    ).astype(str)\n\
    \n    # Output\n    out_df = df[['Person ID']].copy()\n    out_df['sleep_risk_score']\
    \ = risk_score.round(2)\n    out_df['risk_tier'] = risk_tier\n\n    output_file\
    \ = os.path.join(args.output, 'member_sleep_risk_scores.csv')\n    out_df.to_csv(output_file,\
    \ index=False)\n\n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python\
    \ code for the Check object from pydeequ only. Generate a Python function\n`run_code()`\
    \ (taking no arguments) that returns a JSON object with a single key \"constraints\"\
    \nmapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "reasoning: |\n  Goal: Provide pydeequ Check constraints that ensure the\
    \ input data will not crash or mis-score the provided program. The program requires:\n\
    \  - Specific columns to exist and be complete (non-null), especially numeric\
    \ ones used in modeling and arithmetic.\n  - Correct datatypes: several columns\
    \ must be integral or fractional as used (casting and indexing).\n  - Domain/range\
    \ constraints so that operations like numpy.log and array indexing never fail.\n\
    \  - Blood Pressure must be parseable as \"systolic/diastolic\" with systolic\
    \ > diastolic, otherwise pulse pressure log will fail.\n\n  Key risk points covered\
    \ by constraints:\n  - Blood Pressure pattern and systolic > diastolic (prevents\
    \ parse errors and log of non-positive).\n  - Sleep Duration > 0 (required by\
    \ log).\n  - Quality of Sleep is integral within [0, 10] (safe for indexing quality_penalty_map).\n\
    \  - Stress Level within [0, 10] as used in scaling.\n  - Activity columns complete\
    \ and numeric to allow np.polyfit and computations.\n  - Domain checks (BMI Category,\
    \ Gender, Sleep Disorder) to align with mapping and boolean conversion.\n  - Person\
    \ ID uniqueness (expected as identifier for output alignment).\n\n  The function\
    \ below returns only the Check chaining snippets; it does not inspect any DataFrame.\n\
    \n  Python function to generate the constraints (to be appended to a pydeequ Check\
    \ object):\n  ---\n  def run_code():\n      return {\n          \"constraints\"\
    : [\n              # Identifier constraints\n              {\"column_name\": \"\
    Person ID\", \"code_for_constraint\": \".isComplete('Person ID')\"},\n       \
    \       {\"column_name\": \"Person ID\", \"code_for_constraint\": \".isUnique('Person\
    \ ID')\"},\n              {\"column_name\": \"Person ID\", \"code_for_constraint\"\
    : \".hasDataType('Person ID', ConstrainableDataTypes.Integral)\"},\n\n       \
    \       # Activity columns (polyfit requires complete numeric)\n             \
    \ {\"column_name\": \"Daily Steps\", \"code_for_constraint\": \".isComplete('Daily\
    \ Steps')\"},\n              {\"column_name\": \"Daily Steps\", \"code_for_constraint\"\
    : \".hasDataType('Daily Steps', ConstrainableDataTypes.Integral)\"},\n       \
    \       {\"column_name\": \"Daily Steps\", \"code_for_constraint\": \".hasMin('Daily\
    \ Steps', lambda v: v >= 0)\"},\n              {\"column_name\": \"Physical Activity\
    \ Level\", \"code_for_constraint\": \".isComplete('Physical Activity Level')\"\
    },\n              {\"column_name\": \"Physical Activity Level\", \"code_for_constraint\"\
    : \".hasDataType('Physical Activity Level', ConstrainableDataTypes.Integral)\"\
    },\n              {\"column_name\": \"Physical Activity Level\", \"code_for_constraint\"\
    : \".hasMin('Physical Activity Level', lambda v: v >= 0)\"},\n              {\"\
    column_name\": \"Physical Activity Level\", \"code_for_constraint\": \".hasMax('Physical\
    \ Activity Level', lambda v: v <= 200)\"},\n\n              # Sleep duration and\
    \ quality (log and indexing safety)\n              {\"column_name\": \"Sleep Duration\"\
    , \"code_for_constraint\": \".isComplete('Sleep Duration')\"},\n             \
    \ {\"column_name\": \"Sleep Duration\", \"code_for_constraint\": \".hasDataType('Sleep\
    \ Duration', ConstrainableDataTypes.Fractional)\"},\n              {\"column_name\"\
    : \"Sleep Duration\", \"code_for_constraint\": \".satisfies('`Sleep Duration`\
    \ > 0', 'sleep_duration_positive', lambda d: d == 1.0)\"},\n              {\"\
    column_name\": \"Quality of Sleep\", \"code_for_constraint\": \".isComplete('Quality\
    \ of Sleep')\"},\n              {\"column_name\": \"Quality of Sleep\", \"code_for_constraint\"\
    : \".hasDataType('Quality of Sleep', ConstrainableDataTypes.Integral)\"},\n  \
    \            {\"column_name\": \"Quality of Sleep\", \"code_for_constraint\":\
    \ \".hasMin('Quality of Sleep', lambda v: v >= 0)\"},\n              {\"column_name\"\
    : \"Quality of Sleep\", \"code_for_constraint\": \".hasMax('Quality of Sleep',\
    \ lambda v: v <= 10)\"},\n\n              # Blood Pressure (format and logical\
    \ consistency)\n              {\"column_name\": \"Blood Pressure\", \"code_for_constraint\"\
    : \".isComplete('Blood Pressure')\"},\n              {\"column_name\": \"Blood\
    \ Pressure\", \"code_for_constraint\": \".containsPattern('Blood Pressure', '^[0-9]{2,3}/[0-9]{2,3}$')\"\
    },\n              {\"column_name\": \"Blood Pressure\", \"code_for_constraint\"\
    : \".satisfies('cast(split(`Blood Pressure`, \\\"/\\\")[0] as int) > cast(split(`Blood\
    \ Pressure`, \\\"/\\\")[1] as int)', 'bp_systolic_gt_diastolic', lambda d: d ==\
    \ 1.0)\"},\n\n              # Stress Level\n              {\"column_name\": \"\
    Stress Level\", \"code_for_constraint\": \".isComplete('Stress Level')\"},\n \
    \             {\"column_name\": \"Stress Level\", \"code_for_constraint\": \"\
    .hasDataType('Stress Level', ConstrainableDataTypes.Integral)\"},\n          \
    \    {\"column_name\": \"Stress Level\", \"code_for_constraint\": \".hasMin('Stress\
    \ Level', lambda v: v >= 0)\"},\n              {\"column_name\": \"Stress Level\"\
    , \"code_for_constraint\": \".hasMax('Stress Level', lambda v: v <= 10)\"},\n\n\
    \              # BMI Category mapping domain\n              {\"column_name\":\
    \ \"BMI Category\", \"code_for_constraint\": \".isComplete('BMI Category')\"},\n\
    \              {\"column_name\": \"BMI Category\", \"code_for_constraint\": \"\
    .isContainedIn('BMI Category', ['Obese', 'Overweight', 'Normal', 'Normal Weight'])\"\
    },\n\n              # Gender domain\n              {\"column_name\": \"Gender\"\
    , \"code_for_constraint\": \".isComplete('Gender')\"},\n              {\"column_name\"\
    : \"Gender\", \"code_for_constraint\": \".isContainedIn('Gender', ['Male', 'Female'])\"\
    },\n\n              # Sleep Disorder domain (nullable)\n              {\"column_name\"\
    : \"Sleep Disorder\", \"code_for_constraint\": \".satisfies('(`Sleep Disorder`\
    \ IS NULL) OR (`Sleep Disorder` IN (\\\\'Insomnia\\\\', \\\\'Sleep Apnea\\\\'))',\
    \ 'sleep_disorder_domain', lambda d: d == 1.0)\"},\n\n              # Age constraints\n\
    \              {\"column_name\": \"Age\", \"code_for_constraint\": \".isComplete('Age')\"\
    },\n              {\"column_name\": \"Age\", \"code_for_constraint\": \".hasDataType('Age',\
    \ ConstrainableDataTypes.Integral)\"},\n              {\"column_name\": \"Age\"\
    , \"code_for_constraint\": \".hasMin('Age', lambda v: v >= 0)\"},\n          \
    \    {\"column_name\": \"Age\", \"code_for_constraint\": \".hasMax('Age', lambda\
    \ v: v <= 120)\"},\n\n              # Heart Rate constraints\n              {\"\
    column_name\": \"Heart Rate\", \"code_for_constraint\": \".isComplete('Heart Rate')\"\
    },\n              {\"column_name\": \"Heart Rate\", \"code_for_constraint\": \"\
    .hasDataType('Heart Rate', ConstrainableDataTypes.Integral)\"},\n            \
    \  {\"column_name\": \"Heart Rate\", \"code_for_constraint\": \".hasMin('Heart\
    \ Rate', lambda v: v >= 30)\"},\n              {\"column_name\": \"Heart Rate\"\
    , \"code_for_constraint\": \".hasMax('Heart Rate', lambda v: v <= 220)\"},\n\n\
    \              # Optional: Occupation domain (from profiling)\n              {\"\
    column_name\": \"Occupation\", \"code_for_constraint\": \".isComplete('Occupation')\"\
    },\n              {\"column_name\": \"Occupation\", \"code_for_constraint\": \"\
    .isContainedIn('Occupation', ['Nurse', 'Software Engineer', 'Sales Representative',\
    \ 'Engineer', 'Lawyer', 'Teacher', 'Accountant', 'Salesperson', 'Scientist', 'Doctor'])\"\
    }\n          ]\n      }\ntest_cases:\n  - name: \"Structure: returns constraints\
    \ list with expected keys\"\n    input: {}\n    expected:\n      description:\
    \ \"run_code() returns a dict with key 'constraints' mapping to a non-empty list\
    \ of {column_name, code_for_constraint}.\"\n  - name: \"Numeric types present\
    \ for core computations\"\n    input: {}\n    expected:\n      must_include_code_for_constraint:\n\
    \        - \".hasDataType('Daily Steps', ConstrainableDataTypes.Integral)\"\n\
    \        - \".hasDataType('Physical Activity Level', ConstrainableDataTypes.Integral)\"\
    \n        - \".hasDataType('Sleep Duration', ConstrainableDataTypes.Fractional)\"\
    \n        - \".hasDataType('Stress Level', ConstrainableDataTypes.Integral)\"\n\
    \        - \".hasDataType('Age', ConstrainableDataTypes.Integral)\"\n        -\
    \ \".hasDataType('Heart Rate', ConstrainableDataTypes.Integral)\"\n  - name: \"\
    Completeness checks for required columns\"\n    input: {}\n    expected:\n   \
    \   must_include_code_for_constraint:\n        - \".isComplete('Person ID')\"\n\
    \        - \".isComplete('Daily Steps')\"\n        - \".isComplete('Physical Activity\
    \ Level')\"\n        - \".isComplete('Sleep Duration')\"\n        - \".isComplete('Quality\
    \ of Sleep')\"\n        - \".isComplete('Blood Pressure')\"\n  - name: \"Blood\
    \ Pressure: format and logical validity\"\n    input: {}\n    expected:\n    \
    \  must_include_code_for_constraint:\n        - \".containsPattern('Blood Pressure',\
    \ '^[0-9]{2,3}/[0-9]{2,3}$')\"\n        - \".satisfies('cast(split(`Blood Pressure`,\
    \ \\\"/\\\")[0] as int) > cast(split(`Blood Pressure`, \\\"/\\\")[1] as int)',\
    \ 'bp_systolic_gt_diastolic', lambda d: d == 1.0)\"\n  - name: \"Sleep safety:\
    \ duration positive and quality within [0,10]\"\n    input: {}\n    expected:\n\
    \      must_include_code_for_constraint:\n        - \".satisfies('`Sleep Duration`\
    \ > 0', 'sleep_duration_positive', lambda d: d == 1.0)\"\n        - \".hasDataType('Quality\
    \ of Sleep', ConstrainableDataTypes.Integral)\"\n        - \".hasMin('Quality\
    \ of Sleep', lambda v: v >= 0)\"\n        - \".hasMax('Quality of Sleep', lambda\
    \ v: v <= 10)\"\n  - name: \"Domain constraints: BMI, Gender, Sleep Disorder\"\
    \n    input: {}\n    expected:\n      must_include_code_for_constraint:\n    \
    \    - \".isContainedIn('BMI Category', ['Obese', 'Overweight', 'Normal', 'Normal\
