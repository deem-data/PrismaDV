    \ {}\n  isDataTypeInferred: false\n  histogram: null\n\n\nHere is the program:\n\
    import argparse\nimport os\n\nimport numpy as np\nimport pandas as pd\n\n\ndef\
    \ main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--input',\
    \ type=str, required=True)\n    parser.add_argument('--output', type=str, required=True)\n\
    \    args = parser.parse_args()\n\n    os.makedirs(args.output, exist_ok=True)\n\
    \n    input_file = os.path.join(args.input, 'new_data.csv')\n    df = pd.read_csv(input_file)\n\
    \n    # Basic type coercion for numeric fields\n    num_cols = ['Sleep Duration',\
    \ 'Quality of Sleep', 'Physical Activity Level', 'Stress Level', 'Daily Steps',\
    \ 'Age',\n                'Heart Rate']\n    for c in num_cols:\n        if c\
    \ in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n\
    \    # Parse blood pressure into systolic/diastolic\n    bp_str = df['Blood Pressure'].astype(str)\n\
    \    bp_parts = bp_str.str.extract(r'(?P<SBP>\\d{2,3})/(?P<DBP>\\d{2,3})')\n \
    \   df['SBP'] = pd.to_numeric(bp_parts['SBP'], errors='coerce')\n    df['DBP']\
    \ = pd.to_numeric(bp_parts['DBP'], errors='coerce')\n    # Blood pressure derived\
    \ metrics\n    df['PP'] = df['SBP'] - df['DBP']\n    df['MAP'] = df['DBP'] + df['PP']\
    \ / 3.0\n\n    # Sleep duration range guard before computing debt and regression\
    \ features\n    sleep_hours = df['Sleep Duration'].astype(float)\n    # Sleep\
    \ debt relative to 8 hours (clipped at [-2, 5] to bound effect)\n    df['sleep_debt']\
    \ = np.clip(8.0 - sleep_hours, -2.0, 5.0)\n    df['sleep_debt_pos'] = np.maximum(df['sleep_debt'],\
    \ 0.0)\n\n    # Relationship between sleep duration and quality; compute correlation\
    \ then guard before regression-based features\n    qual = df['Quality of Sleep'].astype(float)\n\
    \    # Handle potential constant vectors safely\n    if sleep_hours.std(ddof=0)\
    \ == 0 or qual.std(ddof=0) == 0:\n        corr_sleep_qual = np.nan\n    else:\n\
    \        corr_sleep_qual = float(np.corrcoef(sleep_hours, qual)[0, 1])\n    slope_sq\
    \ = corr_sleep_qual * (qual.std(ddof=0) / (sleep_hours.std(ddof=0) + 1e-9))\n\
    \    intercept_sq = qual.mean() - slope_sq * sleep_hours.mean()\n    pred_quality\
    \ = slope_sq * sleep_hours + intercept_sq\n    df['restfulness_residual'] = qual\
    \ - pred_quality\n\n    # Steps vs physical activity calibration\n    steps =\
    \ df['Daily Steps'].astype(float)\n    pal = df['Physical Activity Level'].astype(float)\n\
    \    if steps.std(ddof=0) == 0 or pal.std(ddof=0) == 0:\n        corr_steps_pal\
    \ = np.nan\n    else:\n        corr_steps_pal = float(np.corrcoef(steps, pal)[0,\
    \ 1])\n    slope_sp = corr_steps_pal * (pal.std(ddof=0) / (steps.std(ddof=0) +\
    \ 1e-9))\n    intercept_sp = pal.mean() - slope_sp * steps.mean()\n    pal_from_steps\
    \ = slope_sp * steps + intercept_sp\n    df['activity_blend'] = 0.5 * pal + 0.5\
    \ * pal_from_steps\n\n    # Validate apnea-BMI coupling before using apnea factor\
    \ in scoring\n    # Scoring helpers\n    def scale01(x, lo, hi):\n        return\
    \ np.clip((x - lo) / (hi - lo + 1e-9), 0.0, 1.0)\n\n    # Risk components\n  \
    \  df['bp_index'] = scale01(df['MAP'], 85.0, 130.0)\n\n    bmi_map = {\n     \
    \   'Normal': 0.0,\n        'Normal Weight': 0.0,\n        'Overweight': 0.6,\n\
    \        'Obese': 1.0,\n    }\n    df['bmi_risk'] = df['BMI Category'].astype(str).map(bmi_map).fillna(0.3)\n\
    \n    df['age_index'] = scale01(df['Age'].astype(float), 30.0, 70.0)\n    df['hr_index']\
    \ = scale01(df['Heart Rate'].astype(float), 55.0, 95.0)\n    df['stress_index']\
    \ = scale01(df['Stress Level'].astype(float), 3.0, 8.0)\n\n    # Sleep risk combines\
    \ debt and negative residuals (i.e., worse-than-expected QoS for the hours slept)\n\
    \    sleep_debt_index = scale01(df['sleep_debt_pos'], 0.0, 5.0)\n    resid_penalty\
    \ = np.clip(-df['restfulness_residual'], 0.0, None)\n    resid_index = scale01(resid_penalty,\
    \ 0.0, max(1.0, float(resid_penalty.quantile(0.9))))\n    df['sleep_risk'] = 0.6\
    \ * sleep_debt_index + 0.4 * resid_index\n\n    # Activity protection (higher\
    \ activity lowers risk)\n    act_index = scale01(df['activity_blend'], float(df['activity_blend'].quantile(0.1)),\n\
    \                        float(df['activity_blend'].quantile(0.9)))\n    df['activity_protect']\
    \ = 1.0 - act_index\n\n    # Apnea factor\n    apnea_mask = df['Sleep Disorder'].astype(str)\
    \ == 'Sleep Apnea'\n    overweight_obese = df['BMI Category'].astype(str).isin(['Overweight',\
    \ 'Obese'])\n    apnea_cnt = int(apnea_mask.sum())\n    if apnea_cnt > 0:\n  \
    \      apnea_ratio = ((apnea_mask & overweight_obese).sum()) / max(apnea_cnt,\
    \ 1)\n    else:\n        apnea_ratio = 0.60\n    apnea_multiplier = 1.0 + max(0.0,\
    \ apnea_ratio - 0.60)\n    df['apnea_component'] = apnea_multiplier * (\n    \
    \        apnea_mask.astype(float) * (0.05 + 0.05 * overweight_obese.astype(float)))\n\
    \n    # Aggregate cardiometabolic risk [0,1]\n    df['risk_score'] = (\n     \
    \       0.25 * df['bp_index'] +\n            0.20 * df['bmi_risk'] +\n       \
    \     0.15 * df['age_index'] +\n            0.10 * df['stress_index'] +\n    \
    \        0.10 * df['hr_index'] +\n            0.15 * df['sleep_risk'] +\n    \
    \        0.10 * df['activity_protect'] +\n            df['apnea_component']\n\
    \    )\n    df['risk_score'] = df['risk_score'].clip(0.0, 1.0)\n\n    # Prioritization:\
    \ top quartile of risk\n    threshold = float(df['risk_score'].quantile(0.75))\n\
    \    df['prioritized_for_outreach'] = df['risk_score'] >= threshold\n\n    # Save\
    \ outputs\n    out_full = df[['Person ID', 'risk_score', 'prioritized_for_outreach']].copy()\n\
    \    out_full.sort_values(by=['prioritized_for_outreach', 'risk_score', 'Person\
    \ ID'], ascending=[False, False, True],\n                         inplace=True)\n\
    \    out_full.to_csv(os.path.join(args.output, 'prioritized_members.csv'), index=False)\n\
    \n    detail_cols = [\n        'Person ID', 'SBP', 'DBP', 'MAP', 'PP', 'bp_index',\
    \ 'bmi_risk', 'age_index',\n        'hr_index', 'stress_index', 'sleep_risk',\
    \ 'activity_protect', 'apnea_component', 'risk_score'\n    ]\n    df[detail_cols].to_csv(os.path.join(args.output,\
    \ 'risk_scores_detailed.csv'), index=False)\n\n\nif __name__ == '__main__':\n\
    \    main()\n\n\nFocus on the python code for the Check object from pydeequ only.\
    \ Generate a Python function\n`run_code()` (taking no arguments) that returns\
    \ a JSON object with a single key \"constraints\"\nmapping to a list of objects,\
    \ each with keys \"column_name\" and \"code_for_constraint\", where\n\"code_for_constraint\"\
    \ is executable pydeequ Check code for that column. Your code must not inspect\n\
    any dataframe; only return the constraints.\n\nHere is an example of the code\
    \ to generate, please replace the example constraints with the ones\nyou generate:\n\
    \ndef run_code():\n    return {\n        \"constraints\": [\n            {\"column_name\"\
    : \"some_column\", \"code_for_constraint\": \".isComplete('some_column')\"},\n\
    \            {\"column_name\": \"another_column\", \"code_for_constraint\": \"\
    .isPositive('another_column')\"},\n        ]\n    }\n\n\nOutput in this YAML format\
    \ with reasoning:\n```yaml\nreasoning: |\n    The input parameters should be:\
    \ param1 as a string, and param2 as a number.\n    To test the function, I will\
    \ consider basic cases, edge cases, and corner cases.\n    For this problem, I\
    \ need to test...\ntest_cases:\n  - name: \"Basic case\"\n    input: {param1:\
    \ value1, param2: value2}\n    expected: result1\n  - name: \"Edge case - empty\"\
    \n    input: {param1: value3, param2: value4}\n    expected: result2\n```"
  response: "reasoning: |\n  The function under test, run_code(), must return a JSON-like\
    \ Python dict that contains only a list of pydeequ Check constraints for a dataset\
    \ used by the provided Python program. The constraints should focus on:\n  - Mandatory\
    \ completeness for columns that the program uses directly (e.g., Blood Pressure,\
    \ BMI Category, Sleep Duration, Quality of Sleep, Physical Activity Level, Stress\
    \ Level, Daily Steps, Age, Heart Rate, Person ID).\n  - Conformance to expected\
    \ formats/domains (e.g., Blood Pressure regex, categorical sets for BMI Category\
    \ and Gender).\n  - Sensible numeric bounds aligned with program logic and the\
    \ provided profile (e.g., Stress Level 3\u20138, Sleep Duration 0\u201324, Physical\
    \ Activity Level 0\u2013100).\n  - Allowing nullability for Sleep Disorder (as\
    \ profile shows ~41.5% completeness) while restricting non-null values to a known\
    \ set.\n  - Ensuring Person ID is complete and unique.\n  The test cases below\
    \ validate that:\n  - The function returns a pure constraint specification (no\
    \ DataFrame inspection/reads).\n  - Specific critical constraints are present\
    \ and correctly formed.\n  - Domain and range validations align with the program\u2019\
    s expectations and the profiling summary.\n\ntest_cases:\n  - name: \"Structure\
    \ - returns pure constraints for pydeequ Check\"\n    input: {}\n    expected:\n\
    \      must_have_top_level_key: \"constraints\"\n      constraints_item_schema:\n\
    \        required_keys: [\"column_name\", \"code_for_constraint\"]\n      code_string_requirements:\n\
    \        - description: \"Every code_for_constraint must start with a dot to be\
    \ chainable on a Check() object\"\n          predicate: \"all(code.startswith('.'))\"\
    \n        - description: \"No code_for_constraint should attempt to inspect dataframes\
    \ or read files\"\n          must_not_contain_any_substrings: [\"spark.read\"\
    , \"DataFrame(\", \"df.\", \".collect(\", \".agg(\", \"approxQuantile\", \"read.csv\"\
    , \"read.parquet\"]\n\n  - name: \"Completeness for required input columns\"\n\
    \    input: {}\n    expected:\n      must_include_constraints:\n        - column_name:\
    \ \"Person ID\"\n          code_contains: \".isComplete('Person ID')\"\n     \
    \   - column_name: \"Blood Pressure\"\n          code_contains: \".isComplete('Blood\
    \ Pressure')\"\n        - column_name: \"BMI Category\"\n          code_contains:\
    \ \".isComplete('BMI Category')\"\n        - column_name: \"Sleep Duration\"\n\
    \          code_contains: \".isComplete('Sleep Duration')\"\n        - column_name:\
    \ \"Quality of Sleep\"\n          code_contains: \".isComplete('Quality of Sleep')\"\
    \n        - column_name: \"Physical Activity Level\"\n          code_contains:\
    \ \".isComplete('Physical Activity Level')\"\n        - column_name: \"Stress\
    \ Level\"\n          code_contains: \".isComplete('Stress Level')\"\n        -\
    \ column_name: \"Daily Steps\"\n          code_contains: \".isComplete('Daily\
    \ Steps')\"\n        - column_name: \"Age\"\n          code_contains: \".isComplete('Age')\"\
    \n        - column_name: \"Heart Rate\"\n          code_contains: \".isComplete('Heart\
    \ Rate')\"\n\n  - name: \"Uniqueness of Person ID enforced\"\n    input: {}\n\
    \    expected:\n      must_include_constraints:\n        - column_name: \"Person\
    \ ID\"\n          code_contains: \".isUnique('Person ID')\"\n\n  - name: \"Blood\
    \ Pressure pattern is validated\"\n    input: {}\n    expected:\n      must_include_constraints:\n\
    \        - column_name: \"Blood Pressure\"\n          code_contains: \".hasPattern('Blood\
    \ Pressure', r'^\\\\\\\\d{2,3}/\\\\\\\\d{2,3}$'\"\n      assertion_threshold:\n\
    \        description: \"Pattern match ratio assertion present and sufficiently\
    \ strict (>= 0.98)\"\n        code_contains_any:\n          - \"lambda v: v >=\
    \ 0.98\"\n          - \"lambda x: x >= 0.98\"\n\n  - name: \"Categorical domains\
    \ are enforced\"\n    input: {}\n    expected:\n      must_include_constraints:\n\
    \        - column_name: \"BMI Category\"\n          code_contains: \".isContainedIn('BMI\
    \ Category', ['Normal', 'Normal Weight', 'Overweight', 'Obese'])\"\n        -\
    \ column_name: \"Gender\"\n          code_contains: \".isContainedIn('Gender',\
    \ ['Male', 'Female'])\"\n      optional_domain_constraints:\n        description:\
    \ \"If Occupation is validated, ensure it uses the profiled 10-value set\"\n \
    \       any_of_code_contains:\n          - \".isContainedIn('Occupation', ['Nurse',\
    \ 'Software Engineer', 'Sales Representative', 'Engineer', 'Lawyer', 'Teacher',\
    \ 'Accountant', 'Salesperson', 'Scientist', 'Doctor'])\"\n\n  - name: \"Numeric\
    \ ranges align with business logic\"\n    input: {}\n    expected:\n      must_include_constraints:\n\
    \        - column_name: \"Stress Level\"\n          code_contains: \".isContainedInRange('Stress\
    \ Level', lowerBound=3.0, upperBound=8.0)\"\n        - column_name: \"Sleep Duration\"\
    \n          code_contains: \".isContainedInRange('Sleep Duration', lowerBound=0.0,\
    \ upperBound=24.0)\"\n        - column_name: \"Physical Activity Level\"\n   \
    \       code_contains: \".isContainedInRange('Physical Activity Level', lowerBound=0.0,\
    \ upperBound=100.0)\"\n        - column_name: \"Daily Steps\"\n          code_contains_any:\n\
    \            - \".isNonNegative('Daily Steps')\"\n            - \".isContainedInRange('Daily\
    \ Steps', lowerBound=0.0, upperBound=\"\n        - column_name: \"Age\"\n    \
    \      code_contains: \".isContainedInRange('Age', lowerBound=18.0, upperBound=90.0)\"\
    \n        - column_name: \"Heart Rate\"\n          code_contains: \".isContainedInRange('Heart\
    \ Rate', lowerBound=40.0, upperBound=200.0)\"\n        - column_name: \"Quality\
    \ of Sleep\"\n          code_contains_any:\n            - \".isContainedIn('Quality\
    \ of Sleep', [4, 5, 6, 7, 8, 9])\"\n            - \".isContainedInRange('Quality\
    \ of Sleep', lowerBound=1.0, upperBound=10.0)\"\n\n  - name: \"Sleep Disorder\
    \ allows nulls but restricts values when present\"\n    input: {}\n    expected:\n\
    \      must_include_constraints:\n        - column_name: \"Sleep Disorder\"\n\
    \          code_contains: \".hasCompleteness('Sleep Disorder',\"\n        - column_name:\
    \ \"Sleep Disorder\"\n          code_contains_any:\n            - \"lambda v:\
    \ v >= 0.4\"\n            - \"lambda x: x >= 0.4\"\n        - column_name: \"\
    Sleep Disorder\"\n          code_contains: \".isContainedIn('Sleep Disorder',\
    \ ['Insomnia', 'Sleep Apnea'])\""
