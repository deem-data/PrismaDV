    \ hr_vals, default=0)\n\n    # Age risk\n    age = df['Age']\n    age_conds =\
    \ [age >= 65, (age >= 50) & (age < 65)]\n    age_vals = [5, 3]\n    df['age_risk']\
    \ = np.select(age_conds, age_vals, default=0)\n\n    # Sleep disorder risk\n \
    \   sd = df['Sleep Disorder'].fillna('')\n    df['sd_risk'] = np.select([sd.str.contains('Sleep\
