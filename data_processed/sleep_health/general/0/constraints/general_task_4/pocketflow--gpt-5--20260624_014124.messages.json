    id:\n  completeness: 1.0\n  approximateNumDistinctValues: 220\n  dataType: Integral\n\
    \  typeCounts: {}\n  isDataTypeInferred: false\n  histogram: null\nAge:\n  completeness:\
    \ 1.0\n  approximateNumDistinctValues: 30\n  dataType: Integral\n  typeCounts:\
