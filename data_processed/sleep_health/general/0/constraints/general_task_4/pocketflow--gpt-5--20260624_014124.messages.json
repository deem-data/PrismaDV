    \ 'Physical Activity Level': 60, 'Stress Level': 4, 'BMI Category': 'Normal',\
    \ 'Blood Pressure': '125/80', 'Heart Rate': 65, 'Daily Steps': 5000, 'Sleep Disorder':\
