    \ 1.0\n  approximateNumDistinctValues: 6\n  dataType: Integral\n  typeCounts:\
    \ {}\n  isDataTypeInferred: false\n  histogram:\n  - value: '8'\n    count: 39\n\
    \    ratio: 0.174\n  - value: '4'\n    count: 38\n    ratio: 0.17\n  - value:\
    \ '5'\n    count: 36\n    ratio: 0.161\n  - value: '6'\n    count: 34\n    ratio:\
    \ 0.152\n  - value: '7'\n    count: 33\n    ratio: 0.147\n  - value: '3'\n   \
    \ count: 44\n    ratio: 0.196\nDaily Steps:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: Integral\n  typeCounts: {}\n  isDataTypeInferred: false\n  histogram:\
    \ null\nSleep Duration:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 27\n  dataType: Fractional\n  typeCounts: {}\n  isDataTypeInferred: false\n\
    \  histogram: null\nGender:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 2\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n  \
    \  Integral: 0\n    Unknown: 0\n    String: 224\n  isDataTypeInferred: false\n\
    \  histogram:\n  - value: Male\n    count: 114\n    ratio: 0.509\n  - value: Female\n\
    \    count: 110\n    ratio: 0.491\nQuality of Sleep:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 6\n  dataType: Integral\n  typeCounts: {}\n  isDataTypeInferred: false\n  histogram:\n\
    \  - value: '8'\n    count: 64\n    ratio: 0.286\n  - value: '4'\n    count: 4\n\
    \    ratio: 0.018\n  - value: '9'\n    count: 43\n    ratio: 0.192\n  - value:\
    \ '5'\n    count: 5\n    ratio: 0.022\n  - value: '6'\n    count: 61\n    ratio:\
    \ 0.272\n  - value: '7'\n    count: 47\n    ratio: 0.21\nHeart Rate:\n  completeness:\
    \ 1.0\n  approximateNumDistinctValues: 17\n  dataType: Integral\n  typeCounts:\
    \ {}\n  isDataTypeInferred: false\n  histogram: null\n\n\nHere is the program:\n\
    import argparse\nimport os\n\nimport numpy as np\nimport pandas as pd\n\n\ndef\
    \ main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--input',\
    \ type=str, required=True)\n    parser.add_argument('--output', type=str, required=True)\n\
    \    args = parser.parse_args()\n\n    input_csv = os.path.join(args.input, 'new_data.csv')\n\
    \    df = pd.read_csv(input_csv)\n    bp_split = df[\"Blood Pressure\"].str.split(\"\
    /\", expand=True)\n    df[\"BP_SYS\"] = bp_split[0].astype(int)\n    df[\"BP_DIA\"\
    ] = bp_split[1].astype(int)\n    # Correlation checks and preparation for model\
    \ calibration\n    pa = df[\"Physical Activity Level\"].astype(float)\n    steps\
    \ = df[\"Daily Steps\"].astype(float)\n    corr_pa_steps = pa.corr(steps)\n  \
    \  slope = ((pa - pa.mean()) * (steps - steps.mean())).mean() / (pa.var(ddof=0)\
    \ if pa.var(ddof=0) != 0 else 1.0)\n    intercept = steps.mean() - slope * pa.mean()\n\
    \    steps_pred = slope * pa + intercept\n\n    corr_sd_q = df[\"Sleep Duration\"\
    ].astype(float).corr(df[\"Quality of Sleep\"].astype(float))\n    stress = df[\"\
    Stress Level\"].astype(float)\n    corr_stress_q = stress.corr(df[\"Quality of\
    \ Sleep\"].astype(float))\n    # Feature scaling\n    duration_norm = (df[\"Sleep\
    \ Duration\"].astype(float) - 3.0) / 9.0\n    qos_norm = (df[\"Quality of Sleep\"\
    ].astype(float) - 4.0) / 5.0\n\n    smin, smax = float(stress.min()), float(stress.max())\n\
    \    stress_range = (smax - smin) if (smax - smin) > 0 else 1.0\n    stress_score\
    \ = 1.0 - (stress - smin) / stress_range\n\n    sys_dev = (df[\"BP_SYS\"].astype(float)\
    \ - 120.0).abs() / 80.0\n    dia_dev = (df[\"BP_DIA\"].astype(float) - 80.0).abs()\
    \ / 50.0\n    bp_score = 1.0 - np.clip(0.5 * sys_dev + 0.5 * dia_dev, 0.0, 1.0)\n\
    \n    steps_mean = max(steps.mean(), 1.0)\n    activity_score = 1.0 - np.clip((steps\
    \ - steps_pred).abs() / steps_mean, 0.0, 1.0)\n\n    bmi_penalty_map = {\n   \
    \     \"Normal\": 0.0,\n        \"Normal Weight\": 0.0,\n        \"Overweight\"\
    : 0.10,\n        \"Obese\": 0.20,\n    }\n    bmi_penalty = df[\"BMI Category\"\
    ].map(bmi_penalty_map).astype(float)\n\n    unknown_penalty = 0.05\n    disorder_penalty\
    \ = (\n        df[\"Sleep Disorder\"].map({\"Insomnia\": 0.20, \"Sleep Apnea\"\
    : 0.30}).fillna(unknown_penalty)\n    ).astype(float)\n\n    synergy = np.clip(0.6\
    \ * (qos_norm + duration_norm) / 2.0 + 0.4 * np.sqrt(qos_norm * duration_norm),\
    \ 0.0, 1.0)\n\n    # Weight calibration using correlations\n    w_synergy = 0.35\
    \ + 0.10 * float(min(max((corr_sd_q - 0.2) / 0.6, 0.0), 1.0))\n    w_stress =\
    \ 0.20 + 0.10 * float(min(max(((-corr_stress_q) - 0.3) / 0.5, 0.0), 1.0))\n  \
    \  w_activity = 0.20\n    w_bp = 0.15\n\n    w_sum = w_synergy + w_stress + w_activity\
    \ + w_bp\n    w_synergy /= w_sum\n    w_stress /= w_sum\n    w_activity /= w_sum\n\
    \    w_bp /= w_sum\n\n    base_score = (\n            w_synergy * synergy +\n\
    \            w_activity * activity_score +\n            w_bp * bp_score +\n  \
    \          w_stress * stress_score\n    )\n\n    penalty_total = np.clip(0.5 *\
    \ bmi_penalty + 0.5 * disorder_penalty, 0.0, 1.0)\n    shi = np.clip(100.0 * (base_score\
    \ * (1.0 - penalty_total)), 0.0, 100.0)\n\n    df[\"SleepHealthIndex\"] = shi.round(2)\n\
    \n    # Risk rules\n    high_bp = (df[\"BP_SYS\"] >= 140) | (df[\"BP_DIA\"] >=\
    \ 90)\n    low_sleep = (df[\"Sleep Duration\"] < 5.5) | (df[\"Quality of Sleep\"\
    ] <= 5)\n    low_index = df[\"SleepHealthIndex\"] < 60\n\n    reasons = []\n \
    \   for i in range(len(df)):\n        r = []\n        if high_bp.iat[i]:\n   \
    \         r.append(\"bp\")\n        if low_sleep.iat[i]:\n            r.append(\"\
    sleep\")\n        if low_index.iat[i]:\n            r.append(\"index\")\n    \
    \    reasons.append(\";\".join(r) if r else \"\")\n\n    df[\"RiskAlert\"] = high_bp\
    \ | low_sleep | low_index\n    df[\"RiskReasons\"] = reasons\n\n    # Array-based\
    \ write relying on positive, unique Person IDs\n    max_id = int(df[\"Person ID\"\
    ].max())\n    shi_array = np.zeros(max_id + 1, dtype=float)\n    alert_array =\
    \ np.zeros(max_id + 1, dtype=np.int8)\n\n    for pid, s, a in df[[\"Person ID\"\
    , \"SleepHealthIndex\", \"RiskAlert\"]].itertuples(index=False):\n        shi_array[int(pid)]\
    \ = float(s)\n        alert_array[int(pid)] = 1 if bool(a) else 0\n\n    os.makedirs(args.output,\
    \ exist_ok=True)\n    df_out = df[[\"Person ID\", \"SleepHealthIndex\", \"RiskAlert\"\
    , \"RiskReasons\"]].copy()\n    df_out.to_csv(os.path.join(args.output, 'sleep_health_index.csv'),\
    \ index=False)\n\n    alerts = df_out[df_out[\"RiskAlert\"]]\n    alerts.to_csv(os.path.join(args.output,\
    \ 'alerts.csv'), index=False)\n\n    # Persist simple calibration summary\n  \
    \  calib = pd.DataFrame({\n        \"metric\": [\n            \"corr_physicalActivity_dailySteps\"\
    ,\n            \"corr_sleepDuration_qualityOfSleep\",\n            \"corr_stress_qualityOfSleep\"\
    \n        ],\n        \"value\": [\n            round(float(corr_pa_steps), 4),\n\
    \            round(float(corr_sd_q), 4),\n            round(float(corr_stress_q),\
    \ 4)\n        ]\n    })\n    calib.to_csv(os.path.join(args.output, 'calibration_summary.csv'),\
    \ index=False)\n\n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python\
    \ code for the Check object from pydeequ only. Generate a Python function\n`run_code()`\
    \ (taking no arguments) that returns a JSON object with a single key \"constraints\"\
    \nmapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  Goal: Provide pydeequ column-level constraints\
    \ that reflect the program\u2019s assumptions and the provided profiling, without\
    \ inspecting any data at runtime. The checks emphasize:\n  - Completeness and\
    \ domain validity for critical columns used directly by the program (e.g., Blood\
    \ Pressure string parsing, BMI Category, Gender, Occupation).\n  - Uniqueness\
    \ and positivity of Person ID (the program uses array indexing by Person ID and\
    \ assumes positive, unique IDs).\n  - Reasonable bounds or domain membership for\
    \ numeric attributes used in normalization and scoring (Sleep Duration, Quality\
    \ of Sleep, Stress Level, Daily Steps, Physical Activity Level, Heart Rate, Age).\n\
    \  - Correlational sanity aligned with the program\u2019s calibration summary:\
    \ Physical Activity vs Daily Steps should be positively correlated, and Stress\
    \ Level vs Quality of Sleep should be non-positive.\n\n  The function below returns\
    \ a JSON structure with Check code fragments (to be appended to a Check object).\
    \ It does not inspect any dataframe.\n\n  Python function to generate the constraints:\n\
    \  def run_code():\n      from pydeequ.checks import ConstrainableDataTypes  #\
    \ Only for reference in code strings\n      return {\n          \"constraints\"\
    : [\n              # Person ID: required positive and unique integral IDs\n  \
    \            {\"column_name\": \"Person ID\", \"code_for_constraint\": \".isComplete('Person\
    \ ID')\"},\n              {\"column_name\": \"Person ID\", \"code_for_constraint\"\
    : \".hasDataType('Person ID', ConstrainableDataTypes.Integral)\"},\n         \
    \     {\"column_name\": \"Person ID\", \"code_for_constraint\": \".isPositive('Person\
    \ ID')\"},\n              {\"column_name\": \"Person ID\", \"code_for_constraint\"\
    : \".isUnique('Person ID')\"},\n\n              # Blood Pressure: must be present\
    \ and split-able into integers\n              {\"column_name\": \"Blood Pressure\"\
    , \"code_for_constraint\": \".isComplete('Blood Pressure')\"},\n             \
    \ {\"column_name\": \"Blood Pressure\", \"code_for_constraint\": \".hasPattern('Blood\
    \ Pressure', r'^\\\\d{2,3}/\\\\d{2,3}$', lambda v: v == 1.0)\"},\n\n         \
    \     # Gender: closed set\n              {\"column_name\": \"Gender\", \"code_for_constraint\"\
    : \".isComplete('Gender')\"},\n              {\"column_name\": \"Gender\", \"\
    code_for_constraint\": \".isContainedIn('Gender', ['Male', 'Female'])\"},\n\n\
    \              # BMI Category: closed set\n              {\"column_name\": \"\
    BMI Category\", \"code_for_constraint\": \".isComplete('BMI Category')\"},\n \
    \             {\"column_name\": \"BMI Category\", \"code_for_constraint\": \"\
    .isContainedIn('BMI Category', ['Normal', 'Normal Weight', 'Overweight', 'Obese'])\"\
    },\n\n              # Occupation: closed set from profiling\n              {\"\
    column_name\": \"Occupation\", \"code_for_constraint\": \".isComplete('Occupation')\"\
    },\n              {\"column_name\": \"Occupation\", \"code_for_constraint\": \"\
    .isContainedIn('Occupation', ['Nurse', 'Software Engineer', 'Sales Representative',\
    \ 'Engineer', 'Lawyer', 'Teacher', 'Accountant', 'Salesperson', 'Scientist', 'Doctor'])\"\
    },\n\n              # Sleep Disorder: allow nulls but constrain domain and ensure\
    \ minimum presence\n              {\"column_name\": \"Sleep Disorder\", \"code_for_constraint\"\
    : \".hasCompleteness('Sleep Disorder', lambda v: v >= 0.35)\"},\n            \
    \  {\"column_name\": \"Sleep Disorder\", \"code_for_constraint\": \".isContainedIn('Sleep\
    \ Disorder', ['Insomnia', 'Sleep Apnea'])\"},\n\n              # Physical Activity\
    \ Level: integral, non-negative, reasonable upper bound\n              {\"column_name\"\
    : \"Physical Activity Level\", \"code_for_constraint\": \".isComplete('Physical\
    \ Activity Level')\"},\n              {\"column_name\": \"Physical Activity Level\"\
    , \"code_for_constraint\": \".hasDataType('Physical Activity Level', ConstrainableDataTypes.Integral)\"\
    },\n              {\"column_name\": \"Physical Activity Level\", \"code_for_constraint\"\
    : \".isNonNegative('Physical Activity Level')\"},\n              {\"column_name\"\
    : \"Physical Activity Level\", \"code_for_constraint\": \".hasMax('Physical Activity\
    \ Level', lambda v: v <= 300)\"},\n\n              # Daily Steps: non-negative\
    \ with a generous upper bound\n              {\"column_name\": \"Daily Steps\"\
    , \"code_for_constraint\": \".isComplete('Daily Steps')\"},\n              {\"\
    column_name\": \"Daily Steps\", \"code_for_constraint\": \".isNonNegative('Daily\
    \ Steps')\"},\n              {\"column_name\": \"Daily Steps\", \"code_for_constraint\"\
    : \".hasMax('Daily Steps', lambda v: v <= 40000)\"},\n\n              # Age: adult\
    \ population within a reasonable range\n              {\"column_name\": \"Age\"\
    , \"code_for_constraint\": \".isComplete('Age')\"},\n              {\"column_name\"\
    : \"Age\", \"code_for_constraint\": \".isPositive('Age')\"},\n              {\"\
    column_name\": \"Age\", \"code_for_constraint\": \".hasMin('Age', lambda v: v\
    \ >= 18)\"},\n              {\"column_name\": \"Age\", \"code_for_constraint\"\
    : \".hasMax('Age', lambda v: v <= 80)\"},\n\n              # Sleep Duration: fractional\
    \ and plausible human range (used in normalization)\n              {\"column_name\"\
    : \"Sleep Duration\", \"code_for_constraint\": \".isComplete('Sleep Duration')\"\
    },\n              {\"column_name\": \"Sleep Duration\", \"code_for_constraint\"\
    : \".hasDataType('Sleep Duration', ConstrainableDataTypes.Fractional)\"},\n  \
    \            {\"column_name\": \"Sleep Duration\", \"code_for_constraint\": \"\
    .hasMin('Sleep Duration', lambda v: v >= 3.0)\"},\n              {\"column_name\"\
    : \"Sleep Duration\", \"code_for_constraint\": \".hasMax('Sleep Duration', lambda\
    \ v: v <= 12.0)\"},\n\n              # Quality of Sleep: integral and constrained\
    \ domain (affects normalization and rules)\n              {\"column_name\": \"\
    Quality of Sleep\", \"code_for_constraint\": \".isComplete('Quality of Sleep')\"\
    },\n              {\"column_name\": \"Quality of Sleep\", \"code_for_constraint\"\
    : \".hasDataType('Quality of Sleep', ConstrainableDataTypes.Integral)\"},\n  \
    \            {\"column_name\": \"Quality of Sleep\", \"code_for_constraint\":\
    \ \".isContainedIn('Quality of Sleep', [4, 5, 6, 7, 8, 9])\"},\n\n           \
    \   # Stress Level: integral and constrained domain\n              {\"column_name\"\
    : \"Stress Level\", \"code_for_constraint\": \".isComplete('Stress Level')\"},\n\
    \              {\"column_name\": \"Stress Level\", \"code_for_constraint\": \"\
    .hasDataType('Stress Level', ConstrainableDataTypes.Integral)\"},\n          \
    \    {\"column_name\": \"Stress Level\", \"code_for_constraint\": \".isContainedIn('Stress\
    \ Level', [3, 4, 5, 6, 7, 8])\"},\n\n              # Heart Rate: plausible physiological\
    \ range\n              {\"column_name\": \"Heart Rate\", \"code_for_constraint\"\
    : \".isComplete('Heart Rate')\"},\n              {\"column_name\": \"Heart Rate\"\
    , \"code_for_constraint\": \".isPositive('Heart Rate')\"},\n              {\"\
    column_name\": \"Heart Rate\", \"code_for_constraint\": \".hasMin('Heart Rate',\
    \ lambda v: v >= 40)\"},\n              {\"column_name\": \"Heart Rate\", \"code_for_constraint\"\
    : \".hasMax('Heart Rate', lambda v: v <= 120)\"},\n\n              # Correlational\
    \ sanity checks used in calibration summary\n              {\"column_name\": \"\
    Physical Activity Level\", \"code_for_constraint\": \".hasCorrelation('Physical\
    \ Activity Level', 'Daily Steps', lambda v: v >= 0.2)\"},\n              {\"column_name\"\
    : \"Stress Level\", \"code_for_constraint\": \".hasCorrelation('Stress Level',\
    \ 'Quality of Sleep', lambda v: v <= 0.0)\"}\n          ]\n      }\n\ntest_cases:\n\
    \  - name: \"Happy path: dataset similar to profiling\"\n    input:\n      description:\
    \ Dataset where all columns are present; BP formatted as NNN/NN; Person ID positive\
    \ and unique; values within observed ranges; categories from profiled lists; typical\
    \ positive PA-Steps correlation and non-positive Stress-QoS correlation.\n   \
    \ expected:\n      outcome: \"All constraints should pass.\"\n\n  - name: \"Malformed\
    \ Blood Pressure\"\n    input:\n      description: Include rows with Blood Pressure\
    \ values like '130-85' or '130/85 mmHg' and/or nulls.\n    expected:\n      failing_constraints:\n\
    \        - column_name: \"Blood Pressure\"\n          reason: \"Pattern must match\
    \ ^\\\\d{2,3}/\\\\d{2,3}$ and completeness must be 1.0.\"\n\n  - name: \"Person\
    \ ID not positive and not unique\"\n    input:\n      description: Duplicate Person\
    \ ID across two rows and at least one row with Person ID = 0 or negative.\n  \
    \  expected:\n      failing_constraints:\n        - column_name: \"Person ID\"\
    \n          reason: \"Must be complete, integral, positive (>0), and unique.\"\
    \n\n  - name: \"Out-of-range sleep metrics\"\n    input:\n      description: Rows\
    \ with Sleep Duration = 2.5 and/or 13.0; Quality of Sleep = 3 or 10.\n    expected:\n\
    \      failing_constraints:\n        - column_name: \"Sleep Duration\"\n     \
    \     reason: \"Min >= 3.0 and Max <= 12.0; must be fractional and complete.\"\
    \n        - column_name: \"Quality of Sleep\"\n          reason: \"Must be in\
    \ {4,...,9} and complete.\"\n\n  - name: \"Invalid categorical values\"\n    input:\n\
    \      description: Gender = 'Other'; BMI Category = 'Underweight'; Occupation\
    \ = 'Artist'; Sleep Disorder = 'Narcolepsy'.\n    expected:\n      failing_constraints:\n\
    \        - column_name: \"Gender\"\n          reason: \"Must be in ['Male','Female'].\"\
    \n        - column_name: \"BMI Category\"\n          reason: \"Must be in ['Normal','Normal\
    \ Weight','Overweight','Obese'].\"\n        - column_name: \"Occupation\"\n  \
