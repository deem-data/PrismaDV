    \    'super_over_flag': (df_train['super_over'] == 'Y').astype(int),\n    'target_runs':\
    \ df_train['target_runs'].astype(float),\n    'target_overs': df_train['target_overs'].astype(float),\n\
    \    'target_run_rate': (df_train['target_runs'] / df_train['target_overs']).astype(float),\n\
    \    'revised_overs_shortfall': (20.0 - df_train['target_overs']).astype(float),\n\
    \    'result_type_wickets': (df_train['result'] == 'wickets').astype(int),\n \
    \   'margin_runs': np.where(df_train['result'].eq('runs'), df_train['result_margin'].fillna(0),\
