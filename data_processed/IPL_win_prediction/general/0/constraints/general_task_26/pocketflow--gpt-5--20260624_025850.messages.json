    : \"target_overs\", \"code_for_constraint\": \".hasMin('target_overs', lambda\
    \ v: v > 0.0)\"}\n        - {\"column_name\": \"target_overs\", \"code_for_constraint\"\
    : \".hasMax('target_overs', lambda v: v <= 20.0)\"}\n        - {\"column_name\"\
    : \"target_runs\", \"code_for_constraint\": \".hasMin('target_runs', lambda v:\
    \ v >= 1.0)\"}\n\n  - name: \"result_margin semantics by result type\"\n    input:\
