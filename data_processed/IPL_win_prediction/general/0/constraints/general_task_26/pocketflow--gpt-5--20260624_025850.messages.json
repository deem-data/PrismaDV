    : \"result_margin\", \"code_for_constraint\": \".isNonNegative('result_margin')\"\
    }\n        - {\"column_name\": \"result_margin\", \"code_for_constraint\": \"\
    .hasMin('result_margin', lambda v: v >= 1.0, where=\\\"result = 'runs'\\\")\"\
    }\n        - {\"column_name\": \"result_margin\", \"code_for_constraint\": \"\
    .hasMin('result_margin', lambda v: v >= 1.0, where=\\\"result = 'wickets'\\\"\
    )\"}\n        - {\"column_name\": \"result_margin\", \"code_for_constraint\":\
    \ \".hasMax('result_margin', lambda v: v <= 10.0, where=\\\"result = 'wickets'\\\
    \")\"}\n        - {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".hasMax('result_margin', lambda v: v <= 0.0, where=\\\"result = 'tie'\\\"\
    )\"}\n        - {\"column_name\": \"result_margin\", \"code_for_constraint\":\
    \ \".hasMin('result_margin', lambda v: v >= 0.0, where=\\\"result = 'tie'\\\"\
    )\"}\n\n  - name: \"date pattern and toss_winner logical consistency\"\n    input:\
    \ {}\n    expected: |\n      The constraints include:\n        - {\"column_name\"\
    : \"date\", \"code_for_constraint\": \".isComplete('date')\"}\n        - {\"column_name\"\
    : \"date\", \"code_for_constraint\": \".hasPattern('date', r'\\\\d{4}-\\\\d{2}-\\\
    \\d{2}')\"}\n        - {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".isComplete('toss_winner')\"}\n        - {\"column_name\": \"toss_winner\"\
    , \"code_for_constraint\": \".satisfies(\\\"toss_winner = team1 OR toss_winner\
    \ = team2\\\", 'toss_winner_in_teams', lambda v: v == 1.0)\"}\ncode: |\n  def\
    \ run_code():\n      return {\n          \"constraints\": [\n              {\"\
    column_name\": \"id\", \"code_for_constraint\": \".isComplete('id')\"},\n    \
    \          {\"column_name\": \"id\", \"code_for_constraint\": \".isNonNegative('id')\"\
    },\n\n              {\"column_name\": \"date\", \"code_for_constraint\": \".isComplete('date')\"\
    },\n              {\"column_name\": \"date\", \"code_for_constraint\": \".hasPattern('date',\
    \ r'\\\\d{4}-\\\\d{2}-\\\\d{2}')\"},\n\n              {\"column_name\": \"season\"\
    , \"code_for_constraint\": \".isComplete('season')\"},\n              {\"column_name\"\
    : \"season\", \"code_for_constraint\": \".hasMin('season', lambda v: v >= 2008)\"\
    },\n              {\"column_name\": \"season\", \"code_for_constraint\": \".hasMax('season',\
    \ lambda v: v <= 2025)\"},\n\n              {\"column_name\": \"match_type\",\
    \ \"code_for_constraint\": \".isContainedIn('match_type', ['League','Eliminator','Qualifier\
    \ 1','Qualifier 2','Final','Semi Final','Elimination Final'])\"},\n\n        \
    \      {\"column_name\": \"team1\", \"code_for_constraint\": \".isComplete('team1')\"\
    },\n              {\"column_name\": \"team2\", \"code_for_constraint\": \".isComplete('team2')\"\
    },\n\n              {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".isComplete('toss_winner')\"},\n              {\"column_name\": \"toss_winner\"\
    , \"code_for_constraint\": \".satisfies(\\\"toss_winner = team1 OR toss_winner\
    \ = team2\\\", 'toss_winner_in_teams', lambda v: v == 1.0)\"},\n\n           \
    \   {\"column_name\": \"toss_decision\", \"code_for_constraint\": \".isComplete('toss_decision')\"\
    },\n              {\"column_name\": \"toss_decision\", \"code_for_constraint\"\
    : \".isContainedIn('toss_decision', ['bat','field'])\"},\n\n              {\"\
    column_name\": \"super_over\", \"code_for_constraint\": \".isComplete('super_over')\"\
    },\n              {\"column_name\": \"super_over\", \"code_for_constraint\": \"\
    .isContainedIn('super_over', ['Y','N'])\"},\n\n              {\"column_name\"\
    : \"result\", \"code_for_constraint\": \".isComplete('result')\"},\n         \
    \     {\"column_name\": \"result\", \"code_for_constraint\": \".isContainedIn('result',\
    \ ['runs','wickets','tie','no result'])\"},\n\n              {\"column_name\"\
    : \"winner\", \"code_for_constraint\": \".isComplete('winner', where=\\\"result\
    \ <> 'no result'\\\")\"},\n\n              {\"column_name\": \"target_overs\"\
    , \"code_for_constraint\": \".hasMin('target_overs', lambda v: v > 0.0)\"},\n\
    \              {\"column_name\": \"target_overs\", \"code_for_constraint\": \"\
    .hasMax('target_overs', lambda v: v <= 20.0)\"},\n\n              {\"column_name\"\
    : \"target_runs\", \"code_for_constraint\": \".hasMin('target_runs', lambda v:\
    \ v >= 1.0)\"},\n\n              {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".isNonNegative('result_margin')\"},\n              {\"column_name\": \"result_margin\"\
    , \"code_for_constraint\": \".hasMin('result_margin', lambda v: v >= 1.0, where=\\\
    \"result = 'runs'\\\")\"},\n              {\"column_name\": \"result_margin\"\
    , \"code_for_constraint\": \".hasMin('result_margin', lambda v: v >= 1.0, where=\\\
    \"result = 'wickets'\\\")\"},\n              {\"column_name\": \"result_margin\"\
    , \"code_for_constraint\": \".hasMax('result_margin', lambda v: v <= 10.0, where=\\\
    \"result = 'wickets'\\\")\"},\n              {\"column_name\": \"result_margin\"\
    , \"code_for_constraint\": \".hasMax('result_margin', lambda v: v <= 0.0, where=\\\
    \"result = 'tie'\\\")\"},\n              {\"column_name\": \"result_margin\",\
    \ \"code_for_constraint\": \".hasMin('result_margin', lambda v: v >= 0.0, where=\\\
    \"result = 'tie'\\\")\"},\n\n              {\"column_name\": \"method\", \"code_for_constraint\"\
    : \".isContainedIn('method', ['D/L'], where='method IS NOT NULL')\"},\n\n    \
    \          {\"column_name\": \"venue\", \"code_for_constraint\": \".isComplete('venue')\"\
    },\n              {\"column_name\": \"umpire1\", \"code_for_constraint\": \".isComplete('umpire1')\"\
