    \  Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram:\n  - value: Y\n    count: 5\n    ratio: 0.009\n  - value: N\n  \
    \  count: 545\n    ratio: 0.991\ntoss_winner:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ pandas as pd\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--input',\
    \ type=str, required=True)\n    parser.add_argument('--output', type=str, required=True)\n\
    \    args = parser.parse_args()\n\n    input_csv = os.path.join(args.input, 'new_data.csv')\n\
    \    df = pd.read_csv(input_csv)\n\n    for col in ['result', 'toss_decision',\
    \ 'super_over', 'method']:\n        if col in df.columns:\n            df[col]\
    \ = df[col].astype(str)\n\n    toss_decision_lower = df['toss_decision'].str.strip().str.lower()\n\
    \    field_ratio = (toss_decision_lower == 'field').mean()\n    season_context_prefix\
    \ = \"Chasing trend continued as\"\n\n    standings = {}\n\n    def ensure_team(season,\
    \ team):\n        key = (season, team)\n        if key not in standings:\n   \
    \         standings[key] = {\n                'season': season,\n            \
    \    'team': team,\n                'matches_played': 0,\n                'wins':\
    \ 0,\n                'losses': 0,\n                'ties': 0,\n             \
    \   'no_results': 0,\n                'points': 0\n            }\n\n    summaries\
    \ = []\n\n    if 'date' in df.columns:\n        try:\n            df['_date']\
    \ = pd.to_datetime(df['date'], errors='coerce')\n        except Exception:\n \
    \           df['_date'] = pd.NaT\n        df = df.sort_values(by=['_date', 'id'],\
    \ ascending=[True, True]).drop(columns=['_date'], errors='ignore')\n\n    for\
    \ _, row in df.iterrows():\n        season = str(row['season'])\n        team1\
    \ = row['team1']\n        team2 = row['team2']\n        ensure_team(season, team1)\n\
    \        ensure_team(season, team2)\n        result = str(row['result']).strip().lower()\n\
    \        winner = row['winner'] if pd.notna(row['winner']) else None\n       \
    \ method = row['method'] if pd.notna(row['method']) else None\n        method\
    \ = str(method) if method is not None else None\n        target_overs = row['target_overs']\
    \ if 'target_overs' in row and pd.notna(row['target_overs']) else None\n     \
    \   target_runs = row['target_runs'] if 'target_runs' in row and pd.notna(row['target_runs'])\
    \ else None\n\n        dl_snippet = \"\"\n        if method == 'D/L':\n      \
    \      if target_runs is not None:\n                dl_snippet = f\" Target set\
    \ to {int(float(target_runs))} in {float(target_overs):g} overs (D/L).\"\n   \
    \         else:\n                dl_snippet = f\" Innings reduced to {float(target_overs):g}\
    \ overs (D/L).\"\n\n        summary = None\n\n        if result in ('runs', 'wickets'):\n\
    \            margin = row['result_margin']\n            if result == 'runs':\n\
    \                m_int = int(float(margin))\n                loser = team2 if\
    \ winner == team1 else team1\n                summary = f\"{season_context_prefix}\
    \ {winner} defended and beat {loser} by {m_int} runs.\" + dl_snippet\n\n     \
    \           standings[(season, winner)]['wins'] += 1\n                standings[(season,\
    \ winner)]['matches_played'] += 1\n                standings[(season, winner)]['points']\
    \ += 2\n                standings[(season, loser)]['losses'] += 1\n          \
    \      standings[(season, loser)]['matches_played'] += 1\n\n            else:\n\
    \                m_int = int(float(margin))\n                loser = team2 if\
    \ winner == team1 else team1\n                summary = f\"{season_context_prefix}\
    \ {winner} chased successfully, winning against {loser} by {m_int} wickets.\"\
    \ + dl_snippet\n\n                standings[(season, winner)]['wins'] += 1\n \
    \               standings[(season, winner)]['matches_played'] += 1\n         \
    \       standings[(season, winner)]['points'] += 2\n                standings[(season,\
    \ loser)]['losses'] += 1\n                standings[(season, loser)]['matches_played']\
    \ += 1\n\n        elif result == 'tie':\n            if (winner in {team1, team2}):\n\
    \                loser = team2 if winner == team1 else team1\n               \
    \ summary = f\"{season_context_prefix} scores were level after regular play; {winner}\
    \ prevailed in the Super Over against {loser}.\" + dl_snippet\n              \
    \  standings[(season, winner)]['wins'] += 1\n                standings[(season,\
    \ winner)]['matches_played'] += 1\n                standings[(season, winner)]['points']\
    \ += 2\n                standings[(season, loser)]['losses'] += 1\n          \
    \      standings[(season, loser)]['matches_played'] += 1\n            else:\n\
    \                summary = f\"{season_context_prefix} scores were level and the\
    \ contest remained tied after the Super Over.\" + dl_snippet\n               \
    \ standings[(season, team1)]['ties'] += 1\n                standings[(season,\
    \ team2)]['ties'] += 1\n                standings[(season, team1)]['matches_played']\
    \ += 1\n                standings[(season, team2)]['matches_played'] += 1\n  \
    \              standings[(season, team1)]['points'] += 1\n                standings[(season,\
    \ team2)]['points'] += 1\n\n        elif result == 'no result':\n            summary\
    \ = f\"{season_context_prefix} play was inconclusive; no result was recorded.\"\
    \ + dl_snippet\n            standings[(season, team1)]['no_results'] += 1\n  \
    \          standings[(season, team2)]['no_results'] += 1\n            standings[(season,\
    \ team1)]['matches_played'] += 1\n            standings[(season, team2)]['matches_played']\
    \ += 1\n            standings[(season, team1)]['points'] += 1\n            standings[(season,\
    \ team2)]['points'] += 1\n        else:\n            summary = f\"{season_context_prefix}\
    \ outcome category '{result}' unrecognized.\"\n\n        summaries.append({\n\
    \            'id': int(row['id']),\n            'season': season,\n          \
    \  'date': row['date'],\n            'city': row['city'] if pd.notna(row['city'])\
    \ else '',\n            'venue': row['venue'],\n            'team1': team1,\n\
    \            'team2': team2,\n            'toss_winner': row['toss_winner'],\n\
    \            'toss_decision': row['toss_decision'],\n            'winner': winner\
    \ if winner is not None else '',\n            'result': row['result'],\n     \
    \       'result_margin': row['result_margin'],\n            'method': method if\
    \ method is not None else '',\n            'super_over': row['super_over'],\n\
    \            'summary': summary.strip()\n        })\n\n    standings_df = pd.DataFrame(list(standings.values()))\n\
    \    standings_df = standings_df.sort_values(by=['season', 'points', 'wins'],\
    \ ascending=[True, False, False])\n\n    os.makedirs(args.output, exist_ok=True)\n\
    \    summaries_df = pd.DataFrame(summaries)\n    summaries_df.to_csv(os.path.join(args.output,\
    \ 'match_summaries.csv'), index=False)\n    standings_df.to_csv(os.path.join(args.output,\
    \ 'standings.csv'), index=False)\n\n\nif __name__ == '__main__':\n    main()\n\
    \n\nFocus on the python code for the Check object from pydeequ only. Generate\
    \ a Python function\n`run_code()` (taking no arguments) that returns a JSON object\
    \ with a single key \"constraints\"\nmapping to a list of objects, each with keys\
    \ \"column_name\" and \"code_for_constraint\", where\n\"code_for_constraint\"\
    \ is executable pydeequ Check code for that column. Your code must not inspect\n\
    any dataframe; only return the constraints.\n\nHere is an example of the code\
    \ to generate, please replace the example constraints with the ones\nyou generate:\n\
    \ndef run_code():\n    return {\n        \"constraints\": [\n            {\"column_name\"\
    : \"some_column\", \"code_for_constraint\": \".isComplete('some_column')\"},\n\
    \            {\"column_name\": \"another_column\", \"code_for_constraint\": \"\
    .isPositive('another_column')\"},\n        ]\n    }\n\n\nOutput in this YAML format\
    \ with reasoning:\n```yaml\nreasoning: |\n    The input parameters should be:\
    \ param1 as a string, and param2 as a number.\n    To test the function, I will\
    \ consider basic cases, edge cases, and corner cases.\n    For this problem, I\
    \ need to test...\ntest_cases:\n  - name: \"Basic case\"\n    input: {param1:\
    \ value1, param2: value2}\n    expected: result1\n  - name: \"Edge case - empty\"\
    \n    input: {param1: value3, param2: value4}\n    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  We need to validate that a student\u2019s run_code()\
    \ function returns a JSON-like Python object\n  describing a set of pydeequ Check\
    \ constraints (as strings of chained Check calls) for the\n  dataset and program\
    \ provided. The program depends on specific columns and semantics:\n  - result\
    \ is expected to be one of {runs, wickets, tie, no result} and complete.\n  -\
    \ toss_decision is complete and in {bat, field}.\n  - super_over is complete and\
    \ in {Y, N}.\n  - winner, when present, must be either team1 or team2.\n  - toss_winner\
    \ must be either team1 or team2.\n  - id and season should be integral (and non-negative\
    \ for id).\n  - date should be ISO-8601 (YYYY-MM-DD) since the program parses\
    \ and sorts by it.\n  - numeric columns such as result_margin, target_runs, target_overs\
    \ should be non-negative\n    or constrained to reasonable ranges (e.g., T20 overs\
    \ \u2264 20).\n  - match_type is one of the enumerated values found in profiling\
    \ and typical IPL metadata.\n  - venue, umpire1, umpire2, and other required columns\
    \ used by the program should be complete\n    if the code assumes their presence.\n\
    \n  The tests below focus on:\n  - Structure: run_code returns a dict with \"\
    constraints\" containing list of dicts.\n  - Presence of critical constraints\
    \ tied to program logic and profiling.\n  - Domains for enumerated columns and\
    \ data type constraints.\n  - Cross-column logical constraints (e.g., winner,\
    \ toss_winner \u2208 {team1, team2}).\n\n  Note:\n  - Tests assert the presence\
    \ of specific constraint code strings that are valid Check\n    chain snippets\
    \ (e.g., \".isComplete('result')\", \".isContainedIn('result', [...])\").\n  -\
    \ The function must not inspect any dataframes; it should only return constraint\
    \ descriptors.\n  - Exact string matching is used for clarity; acceptable equivalent\
    \ variations (e.g., quote style)\n    may be allowed by a grader, but these expectations\
    \ define a clear target.\n\ntest_cases:\n  - name: \"Structure - returns constraints\
    \ list with required keys\"\n    input: {}\n    expected: |\n      Calling run_code()\
    \ returns a dict with key \"constraints\" mapping to a list.\n      Each item\
    \ in the list is a dict with keys \"column_name\" (string) and \"code_for_constraint\"\
    \ (string).\n      No dataframe or Spark inspection should occur inside run_code().\n\
    \n  - name: \"Enumerations - core categorical domains\"\n    input: {}\n    expected:\
    \ |\n      The returned constraints include the following exact domain checks:\n\
    \      - {\"column_name\": \"result\", \"code_for_constraint\": \".isContainedIn('result',\
    \ ['runs', 'wickets', 'tie', 'no result'])\"}\n      - {\"column_name\": \"toss_decision\"\
    , \"code_for_constraint\": \".isContainedIn('toss_decision', ['bat', 'field'])\"\
    }\n      - {\"column_name\": \"super_over\", \"code_for_constraint\": \".isContainedIn('super_over',\
    \ ['Y', 'N'])\"}\n      And completeness checks for those columns:\n      - \"\
    .isComplete('result')\"\n      - \".isComplete('toss_decision')\"\n      - \"\
    .isComplete('super_over')\"\n\n  - name: \"Relational constraints - winner and\
    \ toss_winner must be participating teams\"\n    input: {}\n    expected: |\n\
    \      The returned constraints include cross-column satisfies checks:\n     \
    \ - {\"column_name\": \"winner\", \"code_for_constraint\": \".satisfies('(winner\
    \ IS NULL) OR (winner = team1) OR (winner = team2)', 'winner in {team1,team2}\
    \ or null')\"}\n      - {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".satisfies('(toss_winner = team1) OR (toss_winner = team2)', 'toss_winner\
    \ in {team1,team2}')\"}\n\n  - name: \"Data types and numeric sanity for id and\
    \ season\"\n    input: {}\n    expected: |\n      The returned constraints include:\n\
    \      - {\"column_name\": \"id\", \"code_for_constraint\": \".hasDataType('id',\
    \ ConstrainableDataTypes.Integral)\"}\n      - {\"column_name\": \"id\", \"code_for_constraint\"\
    : \".isNonNegative('id')\"}\n      - {\"column_name\": \"season\", \"code_for_constraint\"\
    : \".hasDataType('season', ConstrainableDataTypes.Integral)\"}\n      - {\"column_name\"\
    : \"season\", \"code_for_constraint\": \".satisfies('season >= 2008 AND season\
    \ <= 2026', 'season range 2008-2026')\"}\n\n  - name: \"Date formatting\"\n  \
    \  input: {}\n    expected: |\n      The returned constraints include:\n     \
    \ - {\"column_name\": \"date\", \"code_for_constraint\": \".isComplete('date')\"\
    }\n      - {\"column_name\": \"date\", \"code_for_constraint\": \".hasPattern('date',\
    \ r'^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"}\n\n  - name: \"Numeric columns used by summaries\
    \ - margins and targets\"\n    input: {}\n    expected: |\n      The returned\
    \ constraints include:\n      - {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".isNonNegative('result_margin')\"}\n      - {\"column_name\": \"target_runs\"\
    , \"code_for_constraint\": \".satisfies('(target_runs IS NULL) OR (target_runs\
    \ > 0)', 'target_runs positive when present')\"}\n      - {\"column_name\": \"\
    target_overs\", \"code_for_constraint\": \".satisfies('(target_overs IS NULL)\
    \ OR (target_overs > 0 AND target_overs <= 20)', 'target_overs in (0,20] when\
    \ present')\"}\n\n  - name: \"Required text fields and match_type domain\"\n \
    \   input: {}\n    expected: |\n      The returned constraints include completeness\
    \ for required text fields:\n      - {\"column_name\": \"venue\", \"code_for_constraint\"\
    : \".isComplete('venue')\"}\n      - {\"column_name\": \"umpire1\", \"code_for_constraint\"\
    : \".isComplete('umpire1')\"}\n      - {\"column_name\": \"umpire2\", \"code_for_constraint\"\
    : \".isComplete('umpire2')\"}\n      And match_type enumeration:\n      - {\"\
    column_name\": \"match_type\", \"code_for_constraint\": \".isContainedIn('match_type',\
    \ ['League', 'Eliminator', 'Qualifier 1', 'Qualifier 2', 'Final', 'Semi Final',\
    \ 'Elimination Final'])\"}\n```"
- model: gpt-5
  prompt: "Implement a solution for this problem:\n\nWrite a pydeequ data unit test\
    \ for a dataset consumed by the following program.\n\nHere is a sample of data\
    \ that can be processed by the program:\n[{'id': 130, 'season': 2024, 'city':\
