    \n        code_for_constraint: \".isContainedIn('result', ['runs','wickets','tie','no\
    \ result'])\"\n\n  - name: \"Ensure super_over allowed set constraint exists\"\
    \n    input: {}\n    expected:\n      must_include_constraint:\n        column_name:\
    \ \"super_over\"\n        code_for_constraint: \".isContainedIn('super_over',\
    \ ['Y','N'])\"\n\n  - name: \"Ensure season data type constraint exists (Integral)\"\
    \n    input: {}\n    expected:\n      must_include_constraint:\n        column_name:\
