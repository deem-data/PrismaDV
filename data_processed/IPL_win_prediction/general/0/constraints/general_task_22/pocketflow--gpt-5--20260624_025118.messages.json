    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport json\nimport\
    \ os\n\nimport numpy as np\nimport pandas as pd\n\n\ndef compute_group_kpis(g:\
    \ pd.DataFrame) -> pd.Series:\n    total = len(g)\n    played_cnt = int(g['played'].sum())\n\
