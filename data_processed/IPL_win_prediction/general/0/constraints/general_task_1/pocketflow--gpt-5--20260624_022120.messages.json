    \ Python function to produce the constraints JSON (do not execute against any\
    \ DataFrame; just return constraints):\n  def run_code():\n      return {\n  \
    \        \"constraints\": [\n              {\"column_name\": \"id\", \"code_for_constraint\"\
    : \".isComplete('id')\"},\n              {\"column_name\": \"id\", \"code_for_constraint\"\
    : \".hasDataType('id', ConstrainableDataTypes.Integral)\"},\n              {\"\
    column_name\": \"id\", \"code_for_constraint\": \".isNonNegative('id')\"},\n\n\
    \              {\"column_name\": \"season\", \"code_for_constraint\": \".isComplete('season')\"\
    },\n              {\"column_name\": \"season\", \"code_for_constraint\": \".hasDataType('season',\
    \ ConstrainableDataTypes.Integral)\"},\n              {\"column_name\": \"season\"\
    , \"code_for_constraint\": \".isNonNegative('season')\"},\n\n              {\"\
    column_name\": \"date\", \"code_for_constraint\": \".isComplete('date')\"},\n\
    \              {\"column_name\": \"date\", \"code_for_constraint\": \".hasPattern('date',\
    \ r'^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"},\n\n              {\"column_name\": \"result\"\
    , \"code_for_constraint\": \".isContainedIn('result', ['runs', 'wickets', 'tie',\
    \ 'no result'])\"},\n\n              {\"column_name\": \"toss_decision\", \"code_for_constraint\"\
    : \".isComplete('toss_decision')\"},\n              {\"column_name\": \"toss_decision\"\
    , \"code_for_constraint\": \".isContainedIn('toss_decision', ['bat', 'field'])\"\
    },\n\n              {\"column_name\": \"super_over\", \"code_for_constraint\"\
    : \".isContainedIn('super_over', ['Y', 'N'])\"},\n\n              {\"column_name\"\
    : \"match_type\", \"code_for_constraint\": \".isContainedIn('match_type', ['League',\
    \ 'Eliminator', 'Qualifier 1', 'Qualifier 2', 'Final', 'Semi Final', 'Elimination\
    \ Final'])\"},\n\n              {\"column_name\": \"method\", \"code_for_constraint\"\
    : \".satisfies(\\\"`method` IS NULL OR `method` = 'D/L'\\\", 'method_allowed',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"target_overs\"\
    , \"code_for_constraint\": \".hasMin('target_overs', lambda v: v >= 0.0)\"},\n\
    \              {\"column_name\": \"target_overs\", \"code_for_constraint\": \"\
    .hasMax('target_overs', lambda v: v <= 20.0)\"},\n\n              {\"column_name\"\
    : \"target_runs\", \"code_for_constraint\": \".hasMin('target_runs', lambda v:\
    \ v > 0.0)\"},\n\n              {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".satisfies(\\\"CASE WHEN `result` IN ('runs','wickets') THEN `result_margin`\
    \ > 0 ELSE (`result_margin` IS NULL OR `result_margin` = 0) END\\\", 'valid_result_margin',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"team1\", \"code_for_constraint\"\
    : \".satisfies(\\\"`team1` <> `team2`\\\", 'no_self_play', lambda v: v == 1.0)\"\
    },\n\n              {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".satisfies(\\\"`toss_winner` = `team1` OR `toss_winner` = `team2`\\\", 'valid_toss_winner',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"winner\", \"code_for_constraint\"\
    : \".satisfies(\\\"CASE WHEN `result` IN ('runs','wickets') THEN (`winner` = `team1`\
    \ OR `winner` = `team2`) ELSE (`winner` IS NULL OR `winner` = '') END\\\", 'winner_in_teams_or_null',\
    \ lambda v: v >= 0.99)\"}\n          ]\n      }\n\ntest_cases:\n  - name: \"Happy\
    \ path - valid decisive match\"\n    input:\n      rows:\n        - {id: 1001,\
    \ season: 2024, date: \"2024-04-09\", result: \"runs\", result_margin: 10, toss_decision:\
