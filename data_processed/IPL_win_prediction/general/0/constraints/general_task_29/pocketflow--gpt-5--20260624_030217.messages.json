    \ 2\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n  \
    \  Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram:\n  - value: Y\n    count: 5\n    ratio: 0.009\n  - value: N\n  \
    \  count: 545\n    ratio: 0.991\ntoss_winner:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ numpy as np\nimport pandas as pd\n\n\ndef compute_standings(df: pd.DataFrame)\
    \ -> pd.DataFrame:\n    played_mask = df[\"result\"] != \"no result\"\n    df_played\
    \ = df.loc[played_mask, [\"season_int\", \"team1\", \"team2\", \"winner\", \"\
    result\"]].copy()\n    df_played[\"loser\"] = np.where(df_played[\"winner\"] ==\
    \ df_played[\"team1\"], df_played[\"team2\"],\n                              \
    \    df_played[\"team1\"])  # relies on winner being one of the teams\n\n    wins\
    \ = (\n        df_played.groupby([\"season_int\", \"winner\"]).size().rename(\"\
    wins\")\n    )\n    losses = (\n        df_played.groupby([\"season_int\", \"\
    loser\"]).size().rename(\"losses\")\n    )\n\n    # Matches played counts both\
    \ teams for all rows\n    side_a = df[[\"season_int\", \"team1\"]].rename(columns={\"\
    team1\": \"team\"})\n    side_b = df[[\"season_int\", \"team2\"]].rename(columns={\"\
    team2\": \"team\"})\n    matches = (\n        pd.concat([side_a, side_b], ignore_index=True)\n\
    \        .groupby([\"season_int\", \"team\"]).size().rename(\"matches\")\n   \
    \ )\n\n    # No result counts both teams\n    nr = df.loc[df[\"result\"] == \"\
    no result\", [\"season_int\", \"team1\", \"team2\"]]\n    if not nr.empty:\n \
    \       nr_flat = pd.concat([\n            nr[[\"season_int\", \"team1\"]].rename(columns={\"\
    team1\": \"team\"}),\n            nr[[\"season_int\", \"team2\"]].rename(columns={\"\
    team2\": \"team\"}),\n        ], ignore_index=True)\n        no_result = nr_flat.groupby([\"\
    season_int\", \"team\"]).size().rename(\"no_result\")\n    else:\n        no_result\
    \ = pd.Series(dtype=\"int64\", name=\"no_result\")\n\n    # Ties (occur before\
    \ super over) count participation for both teams\n    ties = df.loc[df[\"result\"\
    ] == \"tie\", [\"season_int\", \"team1\", \"team2\"]]\n    if not ties.empty:\n\
    \        ties_flat = pd.concat([\n            ties[[\"season_int\", \"team1\"\
    ]].rename(columns={\"team1\": \"team\"}),\n            ties[[\"season_int\", \"\
    team2\"]].rename(columns={\"team2\": \"team\"}),\n        ], ignore_index=True)\n\
    \        ties_count = ties_flat.groupby([\"season_int\", \"team\"]).size().rename(\"\
    ties\")\n    else:\n        ties_count = pd.Series(dtype=\"int64\", name=\"ties\"\
    )\n\n    # Assemble standings\n    standings = (\n        pd.concat([matches,\
    \ wins, losses, no_result, ties_count], axis=1)\n        .fillna(0)\n        .reset_index()\n\
    \        .rename(columns={\"winner\": \"team\"})\n    )\n    # wins and losses\
    \ currently keyed by team value under their respective Series index names\n  \
    \  # After concat, columns names remain aligned\n\n    # Ensure integer types\
    \ for counts\n    for col in [\"matches\", \"wins\", \"losses\", \"no_result\"\
    , \"ties\"]:\n        if col in standings.columns:\n            standings[col]\
    \ = standings[col].astype(int)\n        else:\n            standings[col] = 0\n\
    \n    standings[\"points\"] = standings[\"wins\"] * 2 + standings[\"no_result\"\
    ] * 1\n\n    # Sort within season\n    standings = standings.sort_values([\"season_int\"\
    , \"points\", \"wins\"], ascending=[True, False, False]).reset_index(\n      \
    \  drop=True)\n    return standings\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n\
    \    parser.add_argument('--input', type=str, required=True)\n    parser.add_argument('--output',\
    \ type=str, required=True)\n    args = parser.parse_args()\n\n    input_csv =\
    \ os.path.join(args.input, 'new_data.csv')\n    os.makedirs(args.output, exist_ok=True)\n\
    \n    df = pd.read_csv(input_csv)\n\n    # Normalize dtypes used downstream\n\
    \    df[\"date_dt\"] = pd.to_datetime(df[\"date\"], errors=\"coerce\")\n    df[\"\
    season_int\"] = pd.to_numeric(df[\"season\"], errors=\"coerce\").astype(\"Int64\"\
    )\n    # Guard winner semantics before computing loser and points\n    mask_played\
    \ = df[\"result\"] != \"no result\"\n    # Result margin semantics used for KPI\
    \ calculations\n    mask_runs = df[\"result\"] == \"runs\"\n    mask_wkts = df[\"\
    result\"] == \"wickets\"\n    mask_tie_or_no = df[\"result\"].isin([\"tie\", \"\
    no result\"])  # used to ensure null margins\n    # Safe integer margins after\
    \ checks\n    df[\"margin_int\"] = df[\"result_margin\"].where(mask_runs | mask_wkts).astype(\"\
    Int64\")\n    # Standings per season\n    standings = compute_standings(df)\n\
    \    standings.to_csv(os.path.join(args.output, 'standings.csv'), index=False)\n\
    \n    # Player of the Match leaderboards (top 10 per season)\n    pom = df[[\"\
    season_int\", \"player_of_match\"]].dropna()\n    pom_counts = pom.groupby([\"\
    season_int\", \"player_of_match\"]).size().rename(\"awards\").reset_index()\n\
    \    pom_counts = pom_counts.sort_values([\"season_int\", \"awards\"], ascending=[True,\
    \ False])\n    pom_counts[\"rank\"] = pom_counts.groupby(\"season_int\")[\"awards\"\
    ].rank(method=\"first\", ascending=False).astype(int)\n    top_pom = pom_counts.loc[pom_counts[\"\
    rank\"] <= 10]\n    top_pom.to_csv(os.path.join(args.output, 'leaderboard_player_of_match.csv'),\
    \ index=False)\n\n    # Broadcast KPIs per season\n    played = df[df[\"result\"\
    ] != \"no result\"].copy()\n    played[\"toss_win_and_match_win\"] = (played[\"\
    toss_winner\"] == played[\"winner\"]).astype(int)\n    toss_win_rate = (\n   \
    \     played.groupby(\"season_int\")[\"toss_win_and_match_win\"].mean().rename(\"\
    toss_win_match_win_rate\")\n    )\n\n    avg_margin_runs = (\n        df.loc[mask_runs].groupby(\"\
    season_int\")[\"margin_int\"].mean().rename(\"avg_margin_runs\")\n    )\n    avg_margin_wkts\
    \ = (\n        df.loc[mask_wkts].groupby(\"season_int\")[\"margin_int\"].mean().rename(\"\
    avg_margin_wickets\")\n    )\n    super_over_counts = df.loc[df[\"super_over\"\
    ] == \"Y\"].groupby(\"season_int\").size().rename(\"super_over_matches\")\n  \
    \  tie_counts = df.loc[df[\"result\"] == \"tie\"].groupby(\"season_int\").size().rename(\"\
    ties\")\n\n    kpis = pd.concat([toss_win_rate, avg_margin_runs, avg_margin_wkts,\
    \ super_over_counts, tie_counts], axis=1).fillna(0)\n    # Ensure numeric types\n\
    \    for col in [\"toss_win_match_win_rate\", \"avg_margin_runs\", \"avg_margin_wickets\"\
    ]:\n        if col in kpis.columns:\n            kpis[col] = kpis[col].astype(float)\n\
    \    for col in [\"super_over_matches\", \"ties\"]:\n        if col in kpis.columns:\n\
    \            kpis[col] = kpis[col].astype(int)\n\n    kpis.reset_index().to_csv(os.path.join(args.output,\
    \ 'broadcast_kpis_by_season.csv'), index=False)\n\n    # Super over matches detail\
    \ for editorial\n    super_over_detail = df.loc[df[\"super_over\"] == \"Y\", [\n\
    \        \"id\", \"season_int\", \"date\", \"team1\", \"team2\", \"winner\", \"\
    player_of_match\", \"city\", \"venue\"\n    ]].sort_values([\"season_int\", \"\
    date\"])\n    super_over_detail.to_csv(os.path.join(args.output, 'super_over_matches.csv'),\
    \ index=False)\n\n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python\
    \ code for the Check object from pydeequ only. Generate a Python function\n`run_code()`\
    \ (taking no arguments) that returns a JSON object with a single key \"constraints\"\
    \nmapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "reasoning: |\n  Goal: Provide a run_code() function that returns only\
    \ pydeequ Check constraints (as strings to be chained on a Check builder) without\
    \ reading any data. The constraints should reflect:\n  - The program\u2019s downstream\
    \ assumptions (winner semantics, points computation, KPI derivations).\n  - The\
    \ profiling observations (domains, optionality).\n  - Defensive, conditional rules\
    \ to avoid program logic pitfalls.\n\n  Key expectations derived from code and\
    \ profiling:\n  - Required columns used directly downstream should be complete:\
    \ id, season, date, team1, team2, toss_decision, toss_winner, result, super_over\
    \ (profiling shows 100% completeness for many of these).\n  - Domains:\n    -\
    \ result \u2208 {runs, wickets, tie, no result}\n    - toss_decision \u2208 {bat,\
    \ field}\n    - super_over \u2208 {Y, N}\n  - Types and formats:\n    - season\
    \ as integral\n    - date format YYYY-MM-DD\n  - Relational/conditional rules\
    \ to match program logic:\n    - When result is runs/wickets, winner must be one\
    \ of the two teams (used in compute_standings).\n    - When result is no result,\
    \ winner must be NULL.\n    - Toss winner must be one of the two teams.\n    -\
    \ team1 and team2 must be different.\n    - For runs/wickets, result_margin must\
    \ be positive; for tie/no result, result_margin must be NULL (program builds margin_int\
    \ assuming this).\n    - If super_over is Y, result should be tie (profiling suggests\
    \ tie count equals super over count).\n    - If the match was played (result !=\
    \ 'no result'), player_of_match should be present.\n\n  Below are 7 test cases:\
    \ the first includes the complete function specification; the remainder target\
    \ coverage of requirement clusters (domains, types, relational, conditionals).\n\
    \ntest_cases:\n  - name: \"Returns a valid constraints function\"\n    input:\
    \ {}\n    expected: |\n      def run_code():\n          return {\n           \
    \   \"constraints\": [\n                  # Core completeness and types\n    \
    \              {\"column_name\": \"id\", \"code_for_constraint\": \".isComplete('id')\"\
    },\n                  {\"column_name\": \"season\", \"code_for_constraint\": \"\
    .isComplete('season')\"},\n                  {\"column_name\": \"season\", \"\
    code_for_constraint\": \".hasDataType('season', ConstrainableDataTypes.Integral)\"\
    },\n                  {\"column_name\": \"date\", \"code_for_constraint\": r\"\
    .hasPattern('date', '^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"},\n                  {\"\
    column_name\": \"team1\", \"code_for_constraint\": \".isComplete('team1')\"},\n\
    \                  {\"column_name\": \"team2\", \"code_for_constraint\": \".isComplete('team2')\"\
    },\n                  {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".isComplete('toss_winner')\"},\n                  {\"column_name\": \"toss_decision\"\
    , \"code_for_constraint\": \".isComplete('toss_decision')\"},\n              \
    \    {\"column_name\": \"result\", \"code_for_constraint\": \".isComplete('result')\"\
    },\n                  {\"column_name\": \"super_over\", \"code_for_constraint\"\
    : \".isComplete('super_over')\"},\n\n                  # Domains\n           \
    \       {\"column_name\": \"result\", \"code_for_constraint\": \".isContainedIn('result',\
    \ ['runs', 'wickets', 'tie', 'no result'])\"},\n                  {\"column_name\"\
    : \"toss_decision\", \"code_for_constraint\": \".isContainedIn('toss_decision',\
    \ ['bat', 'field'])\"},\n                  {\"column_name\": \"super_over\", \"\
    code_for_constraint\": \".isContainedIn('super_over', ['Y', 'N'])\"},\n\n    \
    \              # Cross-column and conditional rules supporting compute_standings\
    \ and KPIs\n                  {\"column_name\": \"winner\", \"code_for_constraint\"\
    : \".satisfies(\\\"CASE WHEN result IN ('runs','wickets') THEN (winner = team1\
    \ OR winner = team2) ELSE true END\\\", 'winner_in_teams_when_played')\"},\n \
    \                 {\"column_name\": \"winner\", \"code_for_constraint\": \".satisfies(\\\
    \"CASE WHEN result = 'no result' THEN winner IS NULL ELSE true END\\\", 'winner_null_when_no_result')\"\
    },\n                  {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".satisfies(\\\"(toss_winner = team1 OR toss_winner = team2)\\\", 'toss_winner_is_participating_team')\"\
    },\n                  {\"column_name\": \"team1\", \"code_for_constraint\": \"\
    .satisfies(\\\"team1 <> team2\\\", 'teams_are_distinct')\"},\n\n             \
    \     # Margin semantics used for KPI calculations and margin_int\n          \
    \        {\"column_name\": \"result_margin\", \"code_for_constraint\": \".satisfies(\\\
    \"CASE WHEN result IN ('runs','wickets') THEN result_margin > 0 ELSE true END\\\
    \", 'positive_margin_for_played')\"},\n                  {\"column_name\": \"\
    result_margin\", \"code_for_constraint\": \".satisfies(\\\"CASE WHEN result IN\
    \ ('tie','no result') THEN result_margin IS NULL ELSE true END\\\", 'null_margin_for_tie_or_no_result')\"\
    },\n\n                  # Super over and tie consistency (profiling: counts align)\n\
    \                  {\"column_name\": \"super_over\", \"code_for_constraint\":\
    \ \".satisfies(\\\"CASE WHEN super_over = 'Y' THEN result = 'tie' ELSE true END\\\
    \", 'super_over_implies_tie')\"},\n\n                  # Player of the match should\
    \ be present for played games\n                  {\"column_name\": \"player_of_match\"\
    , \"code_for_constraint\": \".satisfies(\\\"CASE WHEN result <> 'no result' THEN\
