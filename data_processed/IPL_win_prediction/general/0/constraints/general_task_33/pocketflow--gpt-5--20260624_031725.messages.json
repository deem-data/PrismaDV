    \ 0.002\n  - value: Qualifier 1\n    count: 8\n    ratio: 0.015\n  - value: League\n\
    \    count: 519\n    ratio: 0.944\nvenue:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 54\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\nsuper_over:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 2\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n  \
    \  Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram:\n  - value: Y\n    count: 5\n    ratio: 0.009\n  - value: N\n  \
    \  count: 545\n    ratio: 0.991\ntoss_winner:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ numpy as np\nimport pandas as pd\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n\
    \    parser.add_argument('--input', type=str, required=True)\n    parser.add_argument('--output',\
    \ type=str, required=True)\n    args = parser.parse_args()\n\n    in_path = os.path.join(args.input,\
    \ 'new_data.csv')\n    out_dir = args.output\n    os.makedirs(out_dir, exist_ok=True)\n\
    \n    df = pd.read_csv(in_path)\n\n    # Normalize dtypes used downstream\n  \
    \  for col in ['result_margin', 'target_runs', 'target_overs']:\n        if col\
    \ in df.columns:\n            df[col] = pd.to_numeric(df[col], errors='coerce')\n\
    \    # Only league matches contribute to league table and seeding\n    league\
    \ = df[df['match_type'] == 'League'].copy()\n    # Expand matches to team-centric\
    \ rows\n    a = league.copy()\n    a['team'] = a['team1']\n    a['opponent'] =\
    \ a['team2']\n\n    b = league.copy()\n    b['team'] = b['team2']\n    b['opponent']\
    \ = b['team1']\n\n    long = pd.concat([a, b], ignore_index=True, sort=False)\n\
    \n    # Points: 2 for winner (including super-over tie winner), 1 each for no\
    \ result\n    conds = [\n        long['result'].eq('no result'),\n        long['team'].eq(long['winner'])\n\
    \    ]\n    choices = [1, 2]\n    long['points'] = np.select(conds, choices, default=0).astype(int)\n\
    \n    long['win'] = (long['team'] == long['winner']).astype(int)\n    long['loss']\
    \ = ((long['team'] != long['winner']) & long['result'].isin(['runs', 'wickets',\
    \ 'tie'])).astype(int)\n    long['nr'] = long['result'].eq('no result').astype(int)\n\
    \n    # Net performance proxy used for seeding tie-break (uses D/L-adjusted overs\
    \ when present)\n    # Positive for winner, negative for loser; scaled for comparability\
    \ across contexts\n    sign = np.where(long['team'] == long['winner'], 1.0, -1.0)\n\
    \    nrr_runs = np.where(long['result'].eq('runs'), sign * (long['result_margin']\
    \ / long['target_overs']), 0.0)\n    nrr_wkts = np.where(long['result'].eq('wickets'),\
    \ sign * (long['result_margin'] / 10.0), 0.0)\n    nrr_tie = np.where(long['result'].eq('tie'),\
    \ np.where(long['team'] == long['winner'], 0.02, -0.02), 0.0)\n    long['nrr_proxy_delta']\
    \ = nrr_runs + nrr_wkts + nrr_tie\n\n    # Track super-over wins/losses explicitly\
    \ for transparency and potential tie-breaks\n    long['so_win'] = ((long['result']\
    \ == 'tie') & (long['team'] == long['winner'])).astype(int)\n\n    # Aggregate\
    \ season/team\n    agg = long.groupby(['season', 'team'], as_index=False).agg(\n\
    \        points=('points', 'sum'),\n        won=('win', 'sum'),\n        lost=('loss',\
    \ 'sum'),\n        nr=('nr', 'sum'),\n        nrr_proxy=('nrr_proxy_delta', 'sum'),\n\
    \        so_wins=('so_win', 'sum')\n    )\n    agg['played'] = agg['won'] + agg['lost']\
    \ + agg['nr']\n\n    # Order points table\n    points_table = (\n        agg.sort_values(['season',\
    \ 'points', 'nrr_proxy', 'won', 'so_wins', 'team'],\n                        ascending=[True,\
    \ False, False, False, False, True])\n    )\n\n    # Seeding per season (top 4)\n\
    \    points_table['seed'] = points_table.groupby('season').cumcount() + 1\n  \
    \  playoff_seeding = points_table[points_table['seed'] <= 4][['season', 'seed',\
    \ 'team']]\n\n    points_out = os.path.join(out_dir, 'league_points_table.csv')\n\
    \    seeding_out = os.path.join(out_dir, 'playoff_seeding.csv')\n\n    points_cols\
    \ = ['season', 'team', 'played', 'won', 'lost', 'nr', 'points', 'nrr_proxy', 'so_wins']\n\
    \    points_table.to_csv(points_out, index=False, columns=points_cols)\n    playoff_seeding.to_csv(seeding_out,\
    \ index=False)\n\n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python\
    \ code for the Check object from pydeequ only. Generate a Python function\n`run_code()`\
    \ (taking no arguments) that returns a JSON object with a single key \"constraints\"\
    \nmapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  Goal: Provide pydeequ Check constraints that\
    \ validate the dataset assumptions required by the downstream pandas program.\
    \ The constraints should protect against nulls where the code assumes presence,\
    \ mismatched categorical values, and arithmetic hazards (e.g., division by zero\
    \ on target_overs for runs results). They also encode basic domain rules (e.g.,\
    \ team1 != team2, toss_winner is one of the teams, winner is a team except for\
    \ \"no result\", wicket margins are within 1..10, super-over only occurs for ties,\
    \ and method is null or 'D/L').\n\n  The function below returns only constraint\
    \ fragments to be chained on a pydeequ Check object; it does not inspect any dataframe.\n\
    \n  Python function to generate the constraints:\n  def run_code():\n      return\
    \ {\n          \"constraints\": [\n              {\"column_name\": \"id\", \"\
    code_for_constraint\": \".isComplete('id')\"},\n              {\"column_name\"\
    : \"id\", \"code_for_constraint\": \".isUnique('id')\"},\n\n              {\"\
    column_name\": \"season\", \"code_for_constraint\": \".isComplete('season')\"\
    },\n\n              {\"column_name\": \"match_type\", \"code_for_constraint\"\
    : \".isComplete('match_type')\"},\n              {\"column_name\": \"match_type\"\
    , \"code_for_constraint\": \".isContainedIn('match_type', ['League', 'Eliminator',\
    \ 'Qualifier 1', 'Qualifier 2', 'Final', 'Semi Final', 'Elimination Final'])\"\
    },\n\n              {\"column_name\": \"team1\", \"code_for_constraint\": \".isComplete('team1')\"\
    },\n              {\"column_name\": \"team2\", \"code_for_constraint\": \".isComplete('team2')\"\
    },\n              {\"column_name\": \"team1\", \"code_for_constraint\": \".satisfies('team1\
    \ <> team2', 'team1_ne_team2_all_rows', lambda v: v == 1.0)\"},\n\n          \
    \    {\"column_name\": \"result\", \"code_for_constraint\": \".isComplete('result')\"\
    },\n              {\"column_name\": \"result\", \"code_for_constraint\": \".isContainedIn('result',\
    \ ['runs', 'wickets', 'tie', 'no result'])\"},\n\n              {\"column_name\"\
    : \"toss_decision\", \"code_for_constraint\": \".isComplete('toss_decision')\"\
    },\n              {\"column_name\": \"toss_decision\", \"code_for_constraint\"\
    : \".isContainedIn('toss_decision', ['bat', 'field'])\"},\n\n              {\"\
    column_name\": \"toss_winner\", \"code_for_constraint\": \".isComplete('toss_winner')\"\
    },\n              {\"column_name\": \"toss_winner\", \"code_for_constraint\":\
    \ \".satisfies('(toss_winner = team1) OR (toss_winner = team2)', 'toss_winner_in_teams',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"winner\", \"code_for_constraint\"\
    : \".isComplete('winner', where=\\\"result <> 'no result'\\\")\"},\n         \
    \     {\"column_name\": \"winner\", \"code_for_constraint\": \".satisfies(\\\"\
    (result = 'no result') OR (winner = team1) OR (winner = team2)\\\", 'winner_is_a_team_when_applicable',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"super_over\", \"\
    code_for_constraint\": \".isContainedIn('super_over', ['Y', 'N'])\"},\n      \
    \        {\"column_name\": \"super_over\", \"code_for_constraint\": \".satisfies(\\\
    \"(super_over = 'N') OR (result = 'tie')\\\", 'super_over_only_on_tie', lambda\
    \ v: v == 1.0)\"},\n\n              {\"column_name\": \"method\", \"code_for_constraint\"\
    : \".satisfies(\\\"(method IS NULL) OR (method = 'D/L')\\\", 'method_null_or_dl',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"target_runs\",\
    \ \"code_for_constraint\": \".satisfies(\\\"(result = 'no result') OR (target_runs\
    \ > 0)\\\", 'target_runs_positive_when_result_exists', lambda v: v == 1.0)\"},\n\
    \n              {\"column_name\": \"target_overs\", \"code_for_constraint\": \"\
    .isComplete('target_overs', where=\\\"result = 'runs'\\\")\"},\n             \
    \ {\"column_name\": \"target_overs\", \"code_for_constraint\": \".satisfies(\\\
    \"(result <> 'runs') OR (target_overs > 0)\\\", 'target_overs_positive_for_runs',\
    \ lambda v: v == 1.0)\"},\n\n              {\"column_name\": \"result_margin\"\
    , \"code_for_constraint\": \".satisfies(\\\"(result <> 'runs') OR (result_margin\
    \ > 0)\\\", 'result_margin_positive_for_runs', lambda v: v == 1.0)\"},\n     \
    \         {\"column_name\": \"result_margin\", \"code_for_constraint\": \".satisfies(\\\
    \"(result <> 'wickets') OR (result_margin >= 1 AND result_margin <= 10)\\\", 'result_margin_bounds_for_wickets',\
    \ lambda v: v == 1.0)\"}\n          ]\n      }\n\n  Notes on key constraints:\n\
    \  - winner completeness is conditional, allowing nulls only when result = 'no\
    \ result'.\n  - target_overs safeguards the division in nrr_runs for 'runs' results.\n\
    \  - Wicket margins restricted to 1..10, matching cricket rules.\n  - super_over\
    \ 'Y' enforced to appear only on ties.\n  - method constrained to null or 'D/L'\
    \ per profiling.\ntest_cases:\n  - name: \"Happy path across outcomes\"\n    input:\n\
    \      rows:\n        - {id: 1, season: 2024, match_type: League, team1: A, team2:\
    \ B, result: runs, winner: A, result_margin: 12.0, target_runs: 150.0, target_overs:\
    \ 20.0, toss_decision: bat, toss_winner: A, super_over: N, method: null}\n   \
    \     - {id: 2, season: 2024, match_type: League, team1: C, team2: D, result:\
    \ wickets, winner: D, result_margin: 6.0, target_runs: 160.0, target_overs: 20.0,\
    \ toss_decision: field, toss_winner: C, super_over: N, method: null}\n       \
    \ - {id: 3, season: 2024, match_type: League, team1: E, team2: F, result: tie,\
    \ winner: E, result_margin: null, target_runs: 140.0, target_overs: 20.0, toss_decision:\
    \ field, toss_winner: F, super_over: Y, method: null}\n        - {id: 4, season:\
    \ 2024, match_type: League, team1: G, team2: H, result: \"no result\", winner:\
    \ null, result_margin: null, target_runs: null, target_overs: null, toss_decision:\
    \ bat, toss_winner: H, super_over: N, method: null}\n    expected:\n      all_constraints_pass:\
    \ true\n\n  - name: \"Missing winner on completed match (wickets)\"\n    input:\n\
    \      rows:\n        - {id: 10, season: 2021, match_type: League, team1: A, team2:\
    \ B, result: wickets, winner: null, result_margin: 3.0, target_runs: 130.0, target_overs:\
    \ 20.0, toss_decision: field, toss_winner: A, super_over: N, method: null}\n \
    \   expected:\n      failing_constraints:\n        - \".isComplete('winner', where=\\\
    \"result <> 'no result'\\\")\"\n        - \"winner_is_a_team_when_applicable\"\
    \n\n  - name: \"Invalid toss_decision value\"\n    input:\n      rows:\n     \
    \   - {id: 11, season: 2021, match_type: League, team1: A, team2: B, result: runs,\
    \ winner: A, result_margin: 5.0, target_runs: 150.0, target_overs: 20.0, toss_decision:\
    \ bowl, toss_winner: A, super_over: N, method: null}\n    expected:\n      failing_constraints:\n\
    \        - \".isContainedIn('toss_decision', ['bat', 'field'])\"\n\n  - name:\
    \ \"team1 equals team2\"\n    input:\n      rows:\n        - {id: 12, season:\
    \ 2021, match_type: League, team1: A, team2: A, result: runs, winner: A, result_margin:\
    \ 10.0, target_runs: 140.0, target_overs: 20.0, toss_decision: bat, toss_winner:\
    \ A, super_over: N, method: null}\n    expected:\n      failing_constraints:\n\
    \        - \"team1_ne_team2_all_rows\"\n\n  - name: \"Runs result with zero target_overs\"\
    \n    input:\n      rows:\n        - {id: 13, season: 2021, match_type: League,\
    \ team1: A, team2: B, result: runs, winner: A, result_margin: 8.0, target_runs:\
    \ 160.0, target_overs: 0.0, toss_decision: field, toss_winner: B, super_over:\
    \ N, method: null}\n    expected:\n      failing_constraints:\n        - \"target_overs_positive_for_runs\"\
    \n\n  - name: \"Wickets result with impossible margin (>10)\"\n    input:\n  \
    \    rows:\n        - {id: 14, season: 2021, match_type: League, team1: A, team2:\
    \ B, result: wickets, winner: B, result_margin: 11.0, target_runs: 150.0, target_overs:\
    \ 20.0, toss_decision: field, toss_winner: A, super_over: N, method: null}\n \
    \   expected:\n      failing_constraints:\n        - \"result_margin_bounds_for_wickets\"\
    \n\n  - name: \"Super-over flag inconsistent with result\"\n    input:\n     \
    \ rows:\n        - {id: 15, season: 2021, match_type: League, team1: A, team2:\
    \ B, result: runs, winner: A, result_margin: 1.0, target_runs: 120.0, target_overs:\
    \ 20.0, toss_decision: bat, toss_winner: B, super_over: Y, method: null}\n   \
