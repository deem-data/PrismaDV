    \ 550\n  isDataTypeInferred: false\n  histogram:\n  - value: Elimination Final\n\
    \    count: 1\n    ratio: 0.002\n  - value: Eliminator\n    count: 5\n    ratio:\
    \ 0.009\n  - value: Qualifier 2\n    count: 8\n    ratio: 0.015\n  - value: Final\n\
