    \            return f'{base}: {row['winner']} beat {row['loser']} by {margin}\
    \ wickets at {venue} on {date_str}. {toss_part}{innings_part}{method_part}'\n\
    \        if row['result'] == 'tie':\n            return f'{base}: {row['winner']}\
    \ won in Super Over after a tie at {venue} on {date_str}. {toss_part}{innings_part}{method_part}'\n\
    \        return f'{base}: Result {row['result']} at {venue} on {date_str}. {toss_part}{innings_part}{method_part}'\n\
    \n    summaries = df.apply(build_summary, axis=1)\n\n    publish_df = pd.DataFrame({\n\
    \        'id': df['id'],\n        'season': df['season'],\n        'date': df['date'],\n\
    \        'city': df['city'],\n        'venue': df['venue'],\n        'team1':\
