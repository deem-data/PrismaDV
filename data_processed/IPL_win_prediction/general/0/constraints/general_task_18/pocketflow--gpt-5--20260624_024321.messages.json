    \        venue = row['venue']\n        season_val = row['season']\n        match_id\
    \ = row['id']\n        tw = row['toss_winner']\n        td = row['toss_decision']\n\
    \        bf = row['batting_first']\n        base = f'Season {season_val} - Match\
