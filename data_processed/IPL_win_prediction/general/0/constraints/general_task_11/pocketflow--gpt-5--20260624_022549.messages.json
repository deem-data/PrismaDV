    \  histogram: null\n\n\nHere is the program:\nimport pandas as pd\nimport numpy\
    \ as np\nimport argparse\nimport os\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n\
    \    parser.add_argument('--input', type=str, required=True)\n    parser.add_argument('--output',\
    \ type=str, required=True)\n    args = parser.parse_args()\n\n    os.makedirs(args.output,\
    \ exist_ok=True)\n\n    input_csv = os.path.join(args.input, 'new_data.csv')\n\
    \    df = pd.read_csv(input_csv)\n\n    # Normalize values used downstream\n \
    \   for col in ['result', 'toss_decision']:\n        if col in df.columns:\n \
    \           df[col] = df[col].astype(str).str.strip().str.lower()\n    if 'super_over'\
    \ in df.columns:\n        df['super_over'] = df['super_over'].astype(str).str.strip().str.upper()\n\
    \    if 'method' in df.columns:\n        df['method'] = df['method'].replace(['',\
    \ 'NA', 'NaN', 'nan', 'NULL', 'Null', 'null', 'None', 'NullValue'], np.nan)\n\n\
    \    # Coerce numerics\n    for num_col in ['target_runs', 'target_overs', 'result_margin']:\n\
    \        if num_col in df.columns:\n            df[num_col] = pd.to_numeric(df[num_col],\
    \ errors='coerce')\n\n    # Parse date and season\n    df['parsed_date'] = pd.to_datetime(df['date'],\
    \ errors='coerce')\n    df['season_int'] = pd.to_numeric(df['season'], errors='coerce')\n\
    \    # Settlement needs result domain to be tight\n    allowed_results = {'runs',\
    \ 'wickets', 'tie', 'no result'}\n    # Result margin consistency before converting\
    \ to ints for settlement text\n    runs_mask = df['result'] == 'runs'\n    wkts_mask\
    \ = df['result'] == 'wickets'\n    # Prepare integers for margins used in settlement\
    \ text\n    df['margin_int'] = np.where(runs_mask | wkts_mask, df['result_margin'].astype('Int64'),\
    \ pd.NA)\n\n    # Build loser for resulted matches\n    def other_team(row):\n\
    \        if pd.isna(row['winner']):\n            return pd.NA\n        return\
    \ row['team2'] if row['winner'] == row['team1'] else row['team1']\n\n    df['loser']\
    \ = df.apply(other_team, axis=1)\n\n    # Build settlement strings for outcome\
    \ and margin markets\n    def settlement_text(row):\n        if row['result']\
    \ == 'no result':\n            return 'VOID: no result'\n        if row['result']\
    \ == 'tie':\n            return f\"{row['winner']} won after Super Over\"\n  \
    \      if row['result'] == 'runs':\n            return f\"{row['winner']} beat\
    \ {row['loser']} by {int(row['margin_int'])} runs\"\n        if row['result']\
    \ == 'wickets':\n            return f\"{row['winner']} beat {row['loser']} by\
    \ {int(row['margin_int'])} wickets\"\n        return 'UNSETTLED'\n\n    settlement\
    \ = df.copy()\n    settlement['settlement'] = settlement.apply(settlement_text,\
    \ axis=1)\n\n    # Save settled markets view\n    settlement_out = settlement[['id',\
    \ 'season', 'date', 'team1', 'team2', 'winner', 'result', 'result_margin', 'super_over',\
    \ 'settlement']].copy()\n    settlement_out.to_csv(os.path.join(args.output, 'settled_markets.csv'),\
    \ index=False)\n    # Required run rate per match\n    df['req_run_rate'] = df['target_runs']\
    \ / df['target_overs']\n    # Build season-level toss advantage KPIs\n    kpi_df\
    \ = df[df['result'] != 'no result'].copy()\n    kpi_df['toss_winner_won'] = (kpi_df['toss_winner']\
    \ == kpi_df['winner']).astype(int)\n\n    # Overall per-season rates\n    season_rates\
    \ = (\n        kpi_df.groupby('season_int')\n              .agg(matches=('id',\
    \ 'size'),\n                   toss_winner_match_win_rate=('toss_winner_won',\
    \ 'mean'),\n                   avg_req_run_rate=('req_run_rate', 'mean'))\n  \
    \            .reset_index()\n    )\n\n    # Decision-conditional success of toss\
    \ winner\n    decision_rates = (\n        kpi_df.groupby(['season_int', 'toss_decision'])\n\
    \              .agg(decision_toss_winner_win_rate=('toss_winner_won', 'mean'),\n\
    \                   decision_matches=('id', 'size'))\n              .reset_index()\n\
    \              .pivot(index='season_int', columns='toss_decision', values='decision_toss_winner_win_rate')\n\
    \              .rename(columns={'field': 'field_toss_winner_win_rate', 'bat':\
    \ 'bat_toss_winner_win_rate'})\n    )\n\n    kpis = season_rates.merge(decision_rates,\
    \ on='season_int', how='left')\n    kpis['toss_decision_advantage'] = kpis['field_toss_winner_win_rate']\
    \ - kpis['bat_toss_winner_win_rate']\n\n    kpis = kpis.rename(columns={'season_int':\
    \ 'season'})\n    kpis.to_csv(os.path.join(args.output, 'season_toss_kpis.csv'),\
    \ index=False)\n\n\nif __name__ == '__main__':\n    main()\n\n\nFocus on the python\
    \ code for the Check object from pydeequ only. Generate a Python function\n`run_code()`\
    \ (taking no arguments) that returns a JSON object with a single key \"constraints\"\
    \nmapping to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "reasoning: |\n  Goal: verify that the candidate\u2019s run_code() returns\
    \ only a static set of pydeequ Check-chain snippets (no data access), and that\
    \ these constraints are well aligned to the downstream program\u2019s assumptions:\n\
    \  - Domain constraints for categorical columns normalized by the program (result,\
    \ toss_decision, super_over).\n  - Type/range/completeness constraints for numeric\
    \ columns used in rates and computations (season, target_runs, target_overs).\n\
    \  - Conditional integrity for margin and winner based on result.\n  - Date format\
    \ parseability for downstream datetime parsing.\n\n  The tests assert presence\
    \ of key constraints without requiring data. They focus on pydeequ Check method\
    \ calls that would be chained on a Check object (strings beginning with a period),\
    \ and ensure the function contract (returns a dict with \"constraints\" and each\
    \ item has the required keys).\n\n  Notes:\n  - Domain checks use isContainedIn\
    \ for categorical columns.\n  - Numeric checks use hasDataType (ConstrainableDataTypes),\
    \ isPositive/isNonNegative, hasMax, and hasCompleteness thresholds compatible\
    \ with profiling and safe downstream usage.\n  - Conditional requirements use\
    \ satisfies with Spark SQL predicates.\n  - Date format uses containsPattern for\
    \ ISO date strings.\n\ntest_cases:\n  - name: \"Output schema is correct and contains\
    \ only Check-chain snippets\"\n    input: {}\n    expected:\n      must_have_keys:\
    \ [\"constraints\"]\n      constraints_list_type: \"list\"\n      each_item_must_have_keys:\
    \ [\"column_name\", \"code_for_constraint\"]\n      code_starts_with_dot: true\n\
    \n  - name: \"Result domain and completeness enforced\"\n    input: {}\n    expected:\n\
    \      contains:\n        - column_name: \"result\"\n          code_for_constraint:\
    \ \".isComplete('result')\"\n        - column_name: \"result\"\n          code_for_constraint:\
    \ \".isContainedIn('result', ['runs', 'wickets', 'tie', 'no result'])\"\n\n  -\
    \ name: \"Toss decision domain and toss winner completeness\"\n    input: {}\n\
    \    expected:\n      contains:\n        - column_name: \"toss_decision\"\n  \
    \        code_for_constraint: \".isComplete('toss_decision')\"\n        - column_name:\
    \ \"toss_decision\"\n          code_for_constraint: \".isContainedIn('toss_decision',\
    \ ['field', 'bat'])\"\n        - column_name: \"toss_winner\"\n          code_for_constraint:\
    \ \".isComplete('toss_winner')\"\n\n  - name: \"Super over domain is uppercase\
    \ Y/N and complete\"\n    input: {}\n    expected:\n      contains:\n        -\
    \ column_name: \"super_over\"\n          code_for_constraint: \".isComplete('super_over')\"\
    \n        - column_name: \"super_over\"\n          code_for_constraint: \".isContainedIn('super_over',\
    \ ['Y', 'N'])\"\n\n  - name: \"Numeric inputs for rate calculation are typed and\
    \ safe\"\n    input: {}\n    expected:\n      contains:\n        - column_name:\
    \ \"target_runs\"\n          code_for_constraint: \".hasDataType('target_runs',\
    \ ConstrainableDataTypes.Fractional)\"\n        - column_name: \"target_runs\"\
    \n          code_for_constraint: \".hasCompleteness('target_runs', lambda v: v\
    \ >= 0.99)\"\n        - column_name: \"target_runs\"\n          code_for_constraint:\
    \ \".isNonNegative('target_runs')\"\n        - column_name: \"target_overs\"\n\
    \          code_for_constraint: \".hasDataType('target_overs', ConstrainableDataTypes.Fractional)\"\
    \n        - column_name: \"target_overs\"\n          code_for_constraint: \".isPositive('target_overs')\"\
    \n        - column_name: \"target_overs\"\n          code_for_constraint: \".hasMax('target_overs',\
    \ lambda v: v <= 20.0)\"\n\n  - name: \"Conditional presence: margin and winner\
    \ based on result\"\n    input: {}\n    expected:\n      contains:\n        -\
    \ column_name: \"result_margin\"\n          code_for_constraint: \".satisfies(\\\
    \"(result != 'runs' AND result != 'wickets') OR result_margin IS NOT NULL\\\"\
    , 'resulted matches have margin', lambda v: v >= 0.99)\"\n        - column_name:\
    \ \"winner\"\n          code_for_constraint: \".satisfies(\\\"(result = 'no result')\
    \ OR winner IS NOT NULL\\\", 'winner present except no result', lambda v: v >=\
    \ 0.99)\"\n\n  - name: \"Date format and season type\"\n    input: {}\n    expected:\n\
    \      contains:\n        - column_name: \"date\"\n          code_for_constraint:\
    \ \".containsPattern('date', '^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}$')\"\n \
    \       - column_name: \"season\"\n          code_for_constraint: \".hasDataType('season',\
    \ ConstrainableDataTypes.Integral')\""
