    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\nsuper_over:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 2\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n  \
    \  Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram:\n  - value: Y\n    count: 5\n    ratio: 0.009\n  - value: N\n  \
    \  count: 545\n    ratio: 0.991\ntoss_winner:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ numpy as np\nimport pandas as pd\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n\
    \    parser.add_argument('--input', type=str, required=True)\n    parser.add_argument('--output',\
    \ type=str, required=True)\n    args = parser.parse_args()\n\n    input_file =\
    \ os.path.join(args.input, 'new_data.csv')\n    os.makedirs(args.output, exist_ok=True)\n\
    \n    df = pd.read_csv(input_file)\n\n    # Normalize fields used for decision\
    \ logic\n    df['result'] = df['result'].astype(str).str.strip().str.lower()\n\
    \    df['toss_decision'] = df['toss_decision'].astype(str).str.strip().str.lower()\n\
    \    df['super_over'] = df['super_over'].astype(str).str.strip().str.upper()\n\
    \n    # Coerce margin to numeric for validations and downstream numeric ops\n\
    \    df['result_margin'] = pd.to_numeric(df['result_margin'], errors='coerce')\n\
    \    # Safe integer representation for margins, used later in averages\n    df['result_margin_int']\
    \ = df['result_margin'].round(0).astype('Int64')\n\n    # Build a per-team match\
    \ view (two rows per match)\n    base_cols = ['id', 'match_type', 'toss_winner',\
    \ 'toss_decision', 'winner', 'result', 'super_over', 'method',\n             \
    \    'result_margin_int']\n    left = df[['team1', 'team2'] + base_cols].copy()\n\
    \    left = left.rename(columns={'team1': 'team', 'team2': 'opponent'})\n\n  \
    \  right = df[['team2', 'team1'] + base_cols].copy()\n    right = right.rename(columns={'team2':\
    \ 'team', 'team1': 'opponent'})\n\n    teams_long = pd.concat([left, right], ignore_index=True)\n\
    \n    teams_long['toss_made_by_team'] = teams_long['team'] == teams_long['toss_winner']\n\
    \n    # Outcome points and denominator handling\n    tie_no_so_mask = (teams_long['result']\
    \ == 'tie') & (teams_long['super_over'] != 'Y')\n    won_mask = teams_long['team']\
    \ == teams_long['winner']\n\n    denom = np.where(teams_long['result'] == 'no\
    \ result', 0.0, 1.0)\n    points = np.where(teams_long['result'] == 'no result',\
    \ 0.0,\n                      np.where(tie_no_so_mask, 0.5, np.where(won_mask,\
    \ 1.0, 0.0)))\n\n    teams_long['denom'] = denom\n    teams_long['points'] = points\n\
    \n    # Winning margins by type for additional analytics\n    teams_long['winning_runs_margin']\
    \ = teams_long['result_margin_int'].where(\n        won_mask & (teams_long['result']\
    \ == 'runs'))\n    teams_long['winning_wickets_margin'] = teams_long['result_margin_int'].where(\n\
    \        won_mask & (teams_long['result'] == 'wickets'))\n\n    # Focus on matches\
    \ where the team actually made the toss decision\n    decided = teams_long[teams_long['toss_made_by_team']].copy()\n\
    \n    # Aggregate by team, match stage, and toss decision\n    group_cols = ['team',\
    \ 'match_type', 'toss_decision']\n    agg = decided.groupby(group_cols).agg(\n\
    \        matches=('denom', 'sum'),\n        win_points=('points', 'sum'),\n  \
    \      ties_wo_super_over=(\n        'result', lambda s: (s.eq('tie')).sum() -\
    \ ((decided.loc[s.index, 'super_over'] == 'Y').sum() if len(s) else 0)),\n   \
    \     super_over_deciders=('super_over', lambda s: (s.eq('Y')).sum()),\n     \
    \   avg_runs_margin=('winning_runs_margin', 'mean'),\n        avg_wickets_margin=('winning_wickets_margin',\
    \ 'mean')\n    ).reset_index()\n\n    # Filter out groups with zero denominator\
    \ to avoid divide-by-zero\n    agg = agg[agg['matches'] > 0]\n    agg['win_rate']\
    \ = agg['win_points'] / agg['matches']\n\n    # Order columns and write output\n\
    \    agg = agg[['team', 'match_type', 'toss_decision', 'matches', 'win_points',\
    \ 'win_rate',\n               'ties_wo_super_over', 'super_over_deciders', 'avg_runs_margin',\
    \ 'avg_wickets_margin']]\n\n    out_file = os.path.join(args.output, 'team_win_rates_by_toss_and_stage.csv')\n\
    \    agg.to_csv(out_file, index=False)\n\n\nif __name__ == '__main__':\n    main()\n\
    \n\nFocus on the python code for the Check object from pydeequ only. Generate\
    \ a Python function\n`run_code()` (taking no arguments) that returns a JSON object\
    \ with a single key \"constraints\"\nmapping to a list of objects, each with keys\
    \ \"column_name\" and \"code_for_constraint\", where\n\"code_for_constraint\"\
    \ is executable pydeequ Check code for that column. Your code must not inspect\n\
    any dataframe; only return the constraints.\n\nHere is an example of the code\
    \ to generate, please replace the example constraints with the ones\nyou generate:\n\
    \ndef run_code():\n    return {\n        \"constraints\": [\n            {\"column_name\"\
    : \"some_column\", \"code_for_constraint\": \".isComplete('some_column')\"},\n\
    \            {\"column_name\": \"another_column\", \"code_for_constraint\": \"\
    .isPositive('another_column')\"},\n        ]\n    }\n\n\nOutput in this YAML format\
    \ with reasoning:\n```yaml\nreasoning: |\n    The input parameters should be:\
    \ param1 as a string, and param2 as a number.\n    To test the function, I will\
    \ consider basic cases, edge cases, and corner cases.\n    For this problem, I\
    \ need to test...\ntest_cases:\n  - name: \"Basic case\"\n    input: {param1:\
    \ value1, param2: value2}\n    expected: result1\n  - name: \"Edge case - empty\"\
    \n    input: {param1: value3, param2: value4}\n    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  Goal: Provide robust pydeequ Check constraints\
    \ aligned with the program\u2019s logic and observed profiling so that downstream\
    \ analytics (win-rate by toss and stage) are reliable.\n\n  Rationale for constraints:\n\
    \  - Categorical normalization in the program relies on specific value vocabularies:\n\
    \    \u2022 result \u2208 {runs, wickets, tie, no result} and is complete.\n \
    \   \u2022 toss_decision \u2208 {field, bat} and is complete.\n    \u2022 super_over\
    \ \u2208 {Y, N} and is complete.\n    These are enforced with isComplete and isContainedIn.\n\
    \n  - Data types and domains:\n    \u2022 result_margin is coerced to numeric;\
    \ must be non-negative when present.\n    \u2022 target_runs and target_overs\
    \ are numeric domains used later; must be non-negative.\n    \u2022 id, season\
    \ are mandatory; id should be non-negative.\n    \u2022 winner has ~99.8% completeness;\
    \ enforce with a tolerance using hasCompleteness.\n    \u2022 date should be ISO-8601\
    \ yyyy-mm-dd to support stable parsing.\n\n  - Relational (row-level) constraints\
    \ necessary for consistent match logic:\n    \u2022 team1 != team2 (a team can\u2019\
    t play itself).\n    \u2022 winner is either team1 or team2, or null (for ties/no\
    \ result).\n\n  - Business rule whitelists:\n    \u2022 method, if present, must\
    \ be \"D/L\" (profiling indicates only 'D/L' or null).\n    \u2022 match_type\
    \ is one of the known IPL stages.\n\n  These constraints avoid overfitting (e.g.,\
    \ no uniqueness constraint on id due to profiling showing duplicates) while protecting\
    \ critical assumptions the program makes.\n\n  Below is the function that returns\
    \ only the Check code fragments (no DataFrame inspection):\n\n  def run_code():\n\
    \      return {\n          \"constraints\": [\n              {\"column_name\"\
    : \"result\", \"code_for_constraint\": \".isComplete('result')\"},\n         \
    \     {\"column_name\": \"result\", \"code_for_constraint\": \".isContainedIn('result',\
    \ ['runs', 'wickets', 'tie', 'no result'])\"},\n              {\"column_name\"\
    : \"toss_decision\", \"code_for_constraint\": \".isComplete('toss_decision')\"\
    },\n              {\"column_name\": \"toss_decision\", \"code_for_constraint\"\
    : \".isContainedIn('toss_decision', ['field', 'bat'])\"},\n              {\"column_name\"\
    : \"super_over\", \"code_for_constraint\": \".isComplete('super_over')\"},\n \
    \             {\"column_name\": \"super_over\", \"code_for_constraint\": \".isContainedIn('super_over',\
    \ ['Y', 'N'])\"},\n              {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".isNonNegative('result_margin')\"},\n              {\"column_name\": \"winner\"\
    , \"code_for_constraint\": \".hasCompleteness('winner', lambda v: v >= 0.995)\"\
    },\n              {\"column_name\": \"method\", \"code_for_constraint\": \".isContainedIn('method',\
    \ ['D/L'])\"},\n              {\"column_name\": \"team1_vs_team2\", \"code_for_constraint\"\
    : \".satisfies('team1 != team2', 'team1_not_equal_team2')\"},\n              {\"\
    column_name\": \"winner_is_team_participant\", \"code_for_constraint\": \".satisfies('(winner\
    \ = team1) OR (winner = team2) OR (winner IS NULL)', 'winner_is_team1_or_team2_or_null')\"\
    },\n              {\"column_name\": \"date\", \"code_for_constraint\": \".containsPattern('date',\
    \ r'^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"},\n              {\"column_name\": \"id\"\
    , \"code_for_constraint\": \".isComplete('id')\"},\n              {\"column_name\"\
    : \"id\", \"code_for_constraint\": \".isNonNegative('id')\"},\n              {\"\
    column_name\": \"season\", \"code_for_constraint\": \".isComplete('season')\"\
    },\n              {\"column_name\": \"match_type\", \"code_for_constraint\": \"\
    .isContainedIn('match_type', ['League', 'Eliminator', 'Qualifier 1', 'Qualifier\
    \ 2', 'Final', 'Semi Final', 'Elimination Final'])\"},\n              {\"column_name\"\
    : \"target_runs\", \"code_for_constraint\": \".isNonNegative('target_runs')\"\
    },\n              {\"column_name\": \"target_overs\", \"code_for_constraint\"\
    : \".isNonNegative('target_overs')\"}\n          ]\n      }\n\ntest_cases:\n \
    \ - name: \"Core categorical enumerations are enforced\"\n    input: {}\n    expected:\n\
    \      must_include_constraints:\n        - {column_name: \"result\", code_for_constraint:\
    \ \".isContainedIn('result', ['runs', 'wickets', 'tie', 'no result'])\"}\n   \
    \     - {column_name: \"toss_decision\", code_for_constraint: \".isContainedIn('toss_decision',\
    \ ['field', 'bat'])\"}\n        - {column_name: \"super_over\", code_for_constraint:\
    \ \".isContainedIn('super_over', ['Y', 'N'])\"}\n\n  - name: \"Mandatory completeness\
    \ on normalized categoricals\"\n    input: {}\n    expected:\n      must_include_constraints:\n\
    \        - {column_name: \"result\", code_for_constraint: \".isComplete('result')\"\
    }\n        - {column_name: \"toss_decision\", code_for_constraint: \".isComplete('toss_decision')\"\
    }\n        - {column_name: \"super_over\", code_for_constraint: \".isComplete('super_over')\"\
    }\n        - {column_name: \"id\", code_for_constraint: \".isComplete('id')\"\
    }\n        - {column_name: \"season\", code_for_constraint: \".isComplete('season')\"\
    }\n\n  - name: \"Row-level invariants for teams and winner\"\n    input: {}\n\
    \    expected:\n      must_include_constraints:\n        - {column_name: \"team1_vs_team2\"\
    , code_for_constraint: \".satisfies('team1 != team2', 'team1_not_equal_team2')\"\
    }\n        - {column_name: \"winner_is_team_participant\", code_for_constraint:\
    \ \".satisfies('(winner = team1) OR (winner = team2) OR (winner IS NULL)', 'winner_is_team1_or_team2_or_null')\"\
    }\n\n  - name: \"Completeness tolerance and method whitelist\"\n    input: {}\n\
    \    expected:\n      must_include_constraints:\n        - {column_name: \"winner\"\
    , code_for_constraint: \".hasCompleteness('winner', lambda v: v >= 0.995)\"}\n\
    \        - {column_name: \"method\", code_for_constraint: \".isContainedIn('method',\
    \ ['D/L'])\"}\n\n  - name: \"Non-negative numeric domains\"\n    input: {}\n \
    \   expected:\n      must_include_constraints:\n        - {column_name: \"result_margin\"\
    , code_for_constraint: \".isNonNegative('result_margin')\"}\n        - {column_name:\
    \ \"target_runs\", code_for_constraint: \".isNonNegative('target_runs')\"}\n \
    \       - {column_name: \"target_overs\", code_for_constraint: \".isNonNegative('target_overs')\"\
    }\n        - {column_name: \"id\", code_for_constraint: \".isNonNegative('id')\"\
    }\n\n  - name: \"Date ISO-8601 format and match_type whitelist\"\n    input: {}\n\
    \    expected:\n      must_include_constraints:\n        - {column_name: \"date\"\
    , code_for_constraint: \".containsPattern('date', r'^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"\
    }\n        - {column_name: \"match_type\", code_for_constraint: \".isContainedIn('match_type',\
    \ ['League', 'Eliminator', 'Qualifier 1', 'Qualifier 2', 'Final', 'Semi Final',\
    \ 'Elimination Final'])\"}\n\n  - name: \"Full set presence sanity\"\n    input:\
    \ {}\n    expected:\n      must_include_constraints:\n        - {column_name:\
    \ \"result\", code_for_constraint: \".isContainedIn('result', ['runs', 'wickets',\
    \ 'tie', 'no result'])\"}\n        - {column_name: \"toss_decision\", code_for_constraint:\
    \ \".isContainedIn('toss_decision', ['field', 'bat'])\"}\n        - {column_name:\
    \ \"super_over\", code_for_constraint: \".isContainedIn('super_over', ['Y', 'N'])\"\
    }\n        - {column_name: \"winner_is_team_participant\", code_for_constraint:\
    \ \".satisfies('(winner = team1) OR (winner = team2) OR (winner IS NULL)', 'winner_is_team1_or_team2_or_null')\"\
    }\n        - {column_name: \"result_margin\", code_for_constraint: \".isNonNegative('result_margin')\"\
    }\n        - {column_name: \"date\", code_for_constraint: \".containsPattern('date',\
    \ r'^\\\\d{4}-\\\\d{2}-\\\\d{2}$')\"}\n```"
- model: gpt-5
  prompt: "Implement a solution for this problem:\n\nWrite a pydeequ data unit test\
    \ for a dataset consumed by the following program.\n\nHere is a sample of data\
    \ that can be processed by the program:\n[{'id': 130, 'season': 2024, 'city':\
    \ 'Mohali', 'date': '2024-04-09', 'match_type': 'League', 'player_of_match': 'Nithish\
    \ Kumar Reddy', 'venue': 'Maharaja Yadavindra Singh International Cricket Stadium,\
    \ Mullanpur', 'team1': 'Sunrisers Hyderabad', 'team2': 'Punjab Kings', 'toss_winner':\
