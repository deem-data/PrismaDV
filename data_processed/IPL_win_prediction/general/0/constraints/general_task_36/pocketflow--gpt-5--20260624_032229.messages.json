    \  count: 545\n    ratio: 0.991\ntoss_winner:\n  completeness: 1.0\n  approximateNumDistinctValues:\
    \ 19\n  dataType: String\n  typeCounts:\n    Boolean: 0\n    Fractional: 0\n \
    \   Integral: 0\n    Unknown: 0\n    String: 550\n  isDataTypeInferred: false\n\
    \  histogram: null\n\n\nHere is the program:\nimport argparse\nimport os\n\nimport\
    \ numpy as np\nimport pandas as pd\n\n\ndef ensure_dir(path: str):\n    os.makedirs(path,\
    \ exist_ok=True)\n\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--input',\
    \ type=str, required=True)\nparser.add_argument('--output', type=str, required=True)\n\
    args = parser.parse_args()\n\ninput_csv = os.path.join(args.input, 'new_data.csv')\n\
    ensure_dir(args.output)\n\ndf = pd.read_csv(input_csv)\n\n# Normalize common null-like\
    \ values\nfor col in ['method', 'winner']:\n    if col in df.columns:\n      \
    \  df[col] = df[col].replace({'NullValue': np.nan, 'null': np.nan, 'NULL': np.nan,\
    \ 'None': np.nan, '': np.nan})\n\n# Types for numeric columns used downstream\n\
    if 'result_margin' in df.columns:\n    df['result_margin'] = pd.to_numeric(df['result_margin'],\
    \ errors='coerce')\nif 'target_overs' in df.columns:\n    df['target_overs'] =\
    \ pd.to_numeric(df['target_overs'], errors='coerce')\n\n# Precompute frequently\
    \ used columns\nresults = df['result'].astype(str)\nsuper_over = df['super_over'].astype(str)\n\
    # Derive batting first and chasing team from toss decision\nopp_of_toss = np.where(df['toss_winner']\
    \ == df['team1'], df['team2'], df['team1'])\nbatting_first = np.where(df['toss_decision']\
    \ == 'bat', df['toss_winner'], opp_of_toss)\nchasing_team = np.where(df['toss_winner']\
    \ == batting_first, opp_of_toss, df['toss_winner'])\n\ndf['batting_first'] = batting_first\n\
    df['chasing_team'] = chasing_team\n# Guard: D/L method impacts effective overs\
    \ used in downstream artifacts\n# Effective overs for display/analytics\ndf['effective_overs']\
    \ = np.where(df['method'] == 'D/L', df['target_overs'], 20.0)\n# Compose human-readable\
    \ win-by description\nwin_by_text = []\nfor idx, row in df.iterrows():\n    r\
    \ = row['result']\n    if r == 'runs':\n        margin = int(row['result_margin'])\n\
    \        win_by_text.append(f\"{margin} runs\")\n    elif r == 'wickets':\n  \
    \      margin = int(row['result_margin'])\n        win_by_text.append(f\"{margin}\
    \ wickets\")\n    elif r == 'tie':\n        if row['super_over'] == 'Y':\n   \
    \         win_by_text.append('Super Over')\n        else:\n            win_by_text.append('Tie')\n\
    \    elif r == 'no result':\n        win_by_text.append('No Result')\n    else:\n\
    \        win_by_text.append('Unknown')\n\ndf['win_by'] = win_by_text\n\n# Prepare\
    \ accumulator for points table\nteams = pd.unique(pd.concat([df['team1'], df['team2']])).tolist()\n\
    \npoints = {t: {\n    'team': t,\n    'matches': 0,\n    'wins': 0,\n    'losses':\
    \ 0,\n    'ties': 0,\n    'no_results': 0,\n    'super_over_wins': 0,\n    'points':\
    \ 0,\n    'net_run_margin': 0,  # + for winner by runs, - for loser by runs\n\
    \    'net_wicket_margin': 0  # + for winner by wickets, - for loser by wickets\n\
    } for t in teams}\n\n\n# Helper to ensure presence\ndef ensure_team(tn: str):\n\
    \    if tn not in points:\n        points[tn] = {\n            'team': tn,\n \
    \           'matches': 0,\n            'wins': 0,\n            'losses': 0,\n\
    \            'ties': 0,\n            'no_results': 0,\n            'super_over_wins':\
    \ 0,\n            'points': 0,\n            'net_run_margin': 0,\n           \
    \ 'net_wicket_margin': 0\n        }\n\n\n# Iterate matches to compute points\n\
    for idx, row in df.iterrows():\n    t1 = row['team1']\n    t2 = row['team2']\n\
    \    r = row['result']\n    ensure_team(t1)\n    ensure_team(t2)\n\n    # All\
    \ completed or NR matches count as played\n    points[t1]['matches'] += 1\n  \
    \  points[t2]['matches'] += 1\n\n    if r == 'no result':\n        # Guard: winner\
    \ must be null for NR before using None-safe logic downstream\n        points[t1]['no_results']\
    \ += 1\n        points[t2]['no_results'] += 1\n        points[t1]['points'] +=\
    \ 1\n        points[t2]['points'] += 1\n        continue\nif r == 'runs':\n  \
    \  w = row['winner']\n    l = t2 if w == t1 else t1\n    margin = int(row['result_margin'])\n\
    \    points[w]['wins'] += 1\n    points[w]['points'] += 2\n    points[l]['losses']\
    \ += 1\n    points[w]['net_run_margin'] += margin\n    points[l]['net_run_margin']\
    \ -= margin\nelif r == 'wickets':\n    w = row['winner']\n    l = t2 if w == t1\
    \ else t1\n    margin = int(row['result_margin'])\n    points[w]['wins'] += 1\n\
    \    points[w]['points'] += 2\n    points[l]['losses'] += 1\n    points[w]['net_wicket_margin']\
    \ += margin\n    points[l]['net_wicket_margin'] -= margin\nelif r == 'tie':\n\
    \    if row['super_over'] == 'Y':\n        w = row['winner']\n        l = t2 if\
    \ w == t1 else t1\n        points[w]['wins'] += 1\n        points[w]['super_over_wins']\
    \ += 1\n        points[w]['points'] += 2\n        points[l]['losses'] += 1\n \
    \   else:\n        points[t1]['ties'] += 1\n        points[t2]['ties'] += 1\n\
    \        points[t1]['points'] += 1\n        points[t2]['points'] += 1\nelse:\n\
    \    # Unknown result type; treat as no-result for safety\n    points[t1]['no_results']\
    \ += 1\n    points[t2]['no_results'] += 1\n    points[t1]['points'] += 1\n   \
    \ points[t2]['points'] += 1\n\n# Assemble points table\npt_df = pd.DataFrame.from_records(list(points.values()))\n\
    # Consistency: matches should equal sum of outcomes\nsum_outcomes = pt_df[['wins',\
    \ 'losses', 'ties', 'no_results']].sum(axis=1)\npt_df['matches'] = sum_outcomes\n\
    \npt_df = pt_df.sort_values(by=['points', 'wins', 'net_run_margin', 'net_wicket_margin'],\n\
    \                          ascending=[False, False, False, False]).reset_index(drop=True)\n\
    \n# Produce match outcomes view used by dashboards\nmatch_outcomes = df[\n   \
    \ ['id', 'season', 'date', 'team1', 'team2', 'toss_winner', 'toss_decision', 'batting_first',\
    \ 'chasing_team',\n     'winner', 'result', 'result_margin', 'super_over', 'method',\
    \ 'effective_overs', 'win_by', 'venue', 'city']].copy()\n\n# Write outputs\npt_path\
    \ = os.path.join(args.output, 'points_table.csv')\nmo_path = os.path.join(args.output,\
    \ 'match_outcomes.csv')\npt_df.to_csv(pt_path, index=False)\nmatch_outcomes.to_csv(mo_path,\
    \ index=False)\n\nprint(f\"Wrote points table to: {pt_path}\")\nprint(f\"Wrote\
    \ match outcomes to: {mo_path}\")\n\n\nFocus on the python code for the Check\
    \ object from pydeequ only. Generate a Python function\n`run_code()` (taking no\
    \ arguments) that returns a JSON object with a single key \"constraints\"\nmapping\
    \ to a list of objects, each with keys \"column_name\" and \"code_for_constraint\"\
    , where\n\"code_for_constraint\" is executable pydeequ Check code for that column.\
    \ Your code must not inspect\nany dataframe; only return the constraints.\n\n\
    Here is an example of the code to generate, please replace the example constraints\
    \ with the ones\nyou generate:\n\ndef run_code():\n    return {\n        \"constraints\"\
    : [\n            {\"column_name\": \"some_column\", \"code_for_constraint\": \"\
    .isComplete('some_column')\"},\n            {\"column_name\": \"another_column\"\
    , \"code_for_constraint\": \".isPositive('another_column')\"},\n        ]\n  \
    \  }\n\n\nOutput in this YAML format with reasoning:\n```yaml\nreasoning: |\n\
    \    The input parameters should be: param1 as a string, and param2 as a number.\n\
    \    To test the function, I will consider basic cases, edge cases, and corner\
    \ cases.\n    For this problem, I need to test...\ntest_cases:\n  - name: \"Basic\
    \ case\"\n    input: {param1: value1, param2: value2}\n    expected: result1\n\
    \  - name: \"Edge case - empty\"\n    input: {param1: value3, param2: value4}\n\
    \    expected: result2\n```"
  response: "```yaml\nreasoning: |\n  The program computes derived fields and a points\
    \ table from cricket match data. To be robust, the input dataset must satisfy\
    \ several invariants that the downstream logic assumes:\n  - Key categorical columns\
    \ are complete and take values from fixed domains (e.g., toss_decision \u2208\
    \ {bat, field}, result \u2208 {runs, wickets, tie, no result}, super_over \u2208\
    \ {Y, N}).\n  - Referential integrity across columns (toss_winner must be one\
    \ of the two teams; winner must be null or one of the two teams).\n  - Conditional\
    \ requirements:\n    - If result \u2208 {runs, wickets}, result_margin must be\
    \ present and non-negative (the code casts to int for rendering and points updates).\n\
    \    - If method = 'D/L', target_overs must be present, positive, and \u2264 20\
    \ (used to compute effective_overs).\n    - If result = 'tie' and super_over =\
    \ 'Y', a winner must be present (code awards a win to the Super Over winner).\n\
    \    - If result \u2260 'tie', super_over must be 'N' (no Super Over in non-tie\
    \ games).\n  - Structural/format constraints: date must be in YYYY-MM-DD; team1\
    \ and team2 must be different; id/season/venue/umpires complete; season in a reasonable\
    \ range.\n\n  Below, test case 1 provides the required run_code() function that\
    \ returns only the pydeequ Check code snippets (not inspecting data). Test cases\
    \ 2-7 outline dataset scenarios to validate the constraints (what should pass/fail).\n\
    test_cases:\n  - name: \"Provide run_code() with pydeequ Check constraints\"\n\
    \    input: {}\n    expected: |\n      def run_code():\n          return {\n \
    \             \"constraints\": [\n                  {\"column_name\": \"toss_decision\"\
    , \"code_for_constraint\": \".isComplete('toss_decision')\"},\n              \
    \    {\"column_name\": \"toss_decision\", \"code_for_constraint\": \".isContainedIn('toss_decision',\
    \ ['bat', 'field'])\"},\n\n                  {\"column_name\": \"result\", \"\
    code_for_constraint\": \".isComplete('result')\"},\n                  {\"column_name\"\
    : \"result\", \"code_for_constraint\": \".isContainedIn('result', ['runs', 'wickets',\
    \ 'tie', 'no result'])\"},\n\n                  {\"column_name\": \"super_over\"\
    , \"code_for_constraint\": \".isComplete('super_over')\"},\n                 \
    \ {\"column_name\": \"super_over\", \"code_for_constraint\": \".isContainedIn('super_over',\
    \ ['Y', 'N'])\"},\n                  {\"column_name\": \"super_over\", \"code_for_constraint\"\
    : \".satisfies(\\\"CASE WHEN result <> 'tie' THEN super_over = 'N' ELSE true END\\\
    \", 'SuperOverOnlyOnTie', lambda v: v == 1.0)\"},\n\n                  {\"column_name\"\
    : \"date\", \"code_for_constraint\": \".hasPattern('date', r'^\\\\d{4}-\\\\d{2}-\\\
    \\d{2}$')\"},\n\n                  {\"column_name\": \"toss_winner\", \"code_for_constraint\"\
    : \".satisfies('(toss_winner = team1) OR (toss_winner = team2)', 'TossWinnerInTeams',\
    \ lambda v: v == 1.0)\"},\n\n                  {\"column_name\": \"winner\", \"\
    code_for_constraint\": \".satisfies('(winner IS NULL) OR (winner = team1) OR (winner\
    \ = team2)', 'WinnerInTeamsOrNull', lambda v: v == 1.0)\"},\n                \
    \  {\"column_name\": \"winner\", \"code_for_constraint\": \".satisfies(\\\"CASE\
    \ WHEN result = 'tie' AND super_over = 'Y' THEN winner IS NOT NULL ELSE true END\\\
    \", 'TieWithSuperOverRequiresWinner', lambda v: v == 1.0)\"},\n\n            \
    \      {\"column_name\": \"result_margin\", \"code_for_constraint\": \".isNonNegative('result_margin')\"\
    },\n                  {\"column_name\": \"result_margin\", \"code_for_constraint\"\
    : \".satisfies(\\\"CASE WHEN result IN ('runs','wickets') THEN result_margin IS\
    \ NOT NULL ELSE true END\\\", 'MarginPresentWhenDecided', lambda v: v == 1.0)\"\
    },\n\n                  {\"column_name\": \"method\", \"code_for_constraint\"\
    : \".isContainedIn('method', ['D/L'])\"},\n\n                  {\"column_name\"\
    : \"target_overs\", \"code_for_constraint\": \".satisfies(\\\"CASE WHEN method\
    \ = 'D/L' THEN target_overs IS NOT NULL AND target_overs > 0 AND target_overs\
    \ <= 20 ELSE true END\\\", 'TargetOversValidIfDL', lambda v: v == 1.0)\"},\n\n\
    \                  {\"column_name\": \"team1\", \"code_for_constraint\": \".isComplete('team1')\"\
    },\n                  {\"column_name\": \"team2\", \"code_for_constraint\": \"\
    .isComplete('team2')\"},\n                  {\"column_name\": \"team1\", \"code_for_constraint\"\
    : \".satisfies('team1 <> team2', 'TeamsDifferent', lambda v: v == 1.0)\"},\n\n\
    \                  {\"column_name\": \"season\", \"code_for_constraint\": \".isComplete('season')\"\
    },\n                  {\"column_name\": \"season\", \"code_for_constraint\": \"\
    .satisfies('season >= 2008 AND season <= 2100', 'SeasonRange', lambda v: v ==\
    \ 1.0)\"},\n\n                  {\"column_name\": \"id\", \"code_for_constraint\"\
    : \".isComplete('id')\"},\n                  {\"column_name\": \"id\", \"code_for_constraint\"\
    : \".isNonNegative('id')\"},\n\n                  {\"column_name\": \"venue\"\
    , \"code_for_constraint\": \".isComplete('venue')\"},\n                  {\"column_name\"\
    : \"umpire1\", \"code_for_constraint\": \".isComplete('umpire1')\"},\n       \
    \           {\"column_name\": \"umpire2\", \"code_for_constraint\": \".isComplete('umpire2')\"\
    }\n              ]\n          }\n  - name: \"Baseline valid row - decided by runs\"\
    \n    input:\n      row:\n        id: 1001\n        season: 2024\n        date:\
    \ \"2024-05-01\"\n        team1: \"Team A\"\n        team2: \"Team B\"\n     \
    \   toss_winner: \"Team B\"\n        toss_decision: \"field\"\n        winner:\
    \ \"Team A\"\n        result: \"runs\"\n        result_margin: 12\n        super_over:\
    \ \"N\"\n        method: null\n        target_overs: null\n        venue: \"Some\
    \ Stadium\"\n        umpire1: \"Umpire X\"\n        umpire2: \"Umpire Y\"\n  \
    \  expected: \"All listed constraints should be satisfied.\"\n  - name: \"Tie\
