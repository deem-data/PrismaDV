data_processed/*/files*/*
data_processed/*/output*/*

# EIDBench-real regenerable execution artifacts (fitted models, EDA plots,
# parquet shards, and Spark/Delta warehouse internals). All reproducible by
# re-running the benchmark adapter scripts; kept out of git history.
data_processed/eid_bench_real/**/*.pickle
data_processed/eid_bench_real/**/*.parquet
data_processed/eid_bench_real/**/*.png
data_processed/eid_bench_real/**/*.crc
data_processed/eid_bench_real/**/*.dat
data_processed/eid_bench_real/**/*.lck
data_processed/eid_bench_real/**/*.pid
data_processed/eid_bench_real/**/*.ctrl
data_processed/eid_bench_real/**/*.properties
data_processed/eid_bench_real/**/_SUCCESS

# EIDBench-real input-data layer. The corrupted/observed bundles are large and
# reproducible via _0_error_injection from the benchmark error configs, so they
# stay out of git history. The clean source tables are tracked (needed to
# regenerate everything downstream).
benchmarks/EIDBench-real/*/files/*
!benchmarks/EIDBench-real/*/files/clean/

data/spider2-snow-IMDB

data/playground-series-s4e10/files/*

.ideas_queue*
.implementation_queue*

.gradio

benchmarks/EIDBench-real/*/adapter/source_repo/*
!benchmarks/EIDBench-real/*/adapter/source_repo/README.md
